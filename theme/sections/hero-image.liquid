{% comment %} DEBUG INFO - Remove this after testing {% endcomment %}
{% comment %} <div style="background: yellow; padding: 10px; margin: 10px;">
  <p><strong>DEBUG INFO:</strong></p>
  {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
  {%- assign pageUrl = contentForQuerystring
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | split: '.myshopify.com'
    | last
    | replace: '\/', '/'
    | replace: '%20', ' '
    | replace: '\u0026', '&'
  -%}
  {%- assign requested_look_id = pageUrl | split: 'look=' | last | split: '&' | first -%}
  {%- assign has_look_param = false -%}
  {%- if requested_look_id != pageUrl -%}
    {%- assign has_look_param = true -%}
  {% endif %}
  <p>URL: {{ pageUrl }}</p>
  <p>Requested Look ID: "{{ requested_look_id }}"</p>
  <P>has look param: {{ has_look_param }}</P>
  <p id="js-debug"></p>
</div> {% endcomment %}

{% comment %} Only show hero if we're not viewing a specific look {% endcomment %}
{%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign pageUrl = contentForQuerystring | split: '"pageurl":"' | last | split: '"' | first | split: '.myshopify.com' | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&' -%}

{%- assign has_look_param = false -%}
{%- if pageUrl contains 'look=' -%}
  {%- assign has_look_param = true -%}
{%- endif -%}

{% unless has_look_param %}
  {%- if section.settings.image != blank -%}
    {%- assign desktop_image =  section.settings.image -%}
    <div class="hero-image w-full relative {{ section.settings.hero_height }} {% if section.settings.add_padding %}p-8 md:p-0{% endif %}">
      {%- assign desktop_img_url_1200 = desktop_image | image_url: width: 1200 -%}
      {%- assign desktop_img_url_1600 = desktop_image | image_url: width: 1600 -%}
      {%- assign desktop_img_url_2000 = desktop_image | image_url: width: 2000 -%}
      {%- assign desktop_img_url_full = desktop_image | image_url -%}

      {%- assign mobile_image = section.settings.mobile_image | default: desktop_image -%}
      {%- assign mobile_img_url_tiny = mobile_image | image_url: width: 100 -%}
      {% comment %} {%- assign mobile_img_url_400 = mobile_image | image_url: width: 400 -%}
      {%- assign mobile_img_url_600 = mobile_image | image_url: width: 600 -%} {% endcomment %}
      {%- assign mobile_img_url_1200 = mobile_image | image_url: width: 1200 -%}
      {%- assign mobile_img_url_1600 = mobile_image | image_url: width: 1600 -%}
      {%- assign mobile_img_url_2000 = mobile_image | image_url: width: 2000 -%}

      <picture>
          <!-- Desktop image -->
        <source
          media="(min-width: 768px)"
          srcset="
            {{ desktop_img_url_1200 }} 1200w,
            {{ desktop_img_url_1600 }} 1600w,
            {{ desktop_img_url_2000 }} 2000w,
            {{ desktop_img_url_full }} 2400w
          "
          sizes="150vw"
          type="image/webp">
          <!-- Mobile image -->
        <source
          srcset="
            {{ mobile_img_url_1200 }} 1200w,
            {{ mobile_img_url_1600 }} 1600w,
            {{ mobile_img_url_2000 }} 2000w
          "
          sizes="200vw"
          type="image/webp">
        <img
          src="{{ desktop_image | image_url }}"
          width="{{ desktop_image.width }}"
          height="{{ desktop_image.height }}"
          loading="eager"
          class="w-full h-full object-cover"
          {% comment %} onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"> {% endcomment %}
      </picture>
      {% comment %} blur-up - this.classList.add('blur-sm'); {% endcomment %}

      {%- if section.settings.title != blank or section.settings.description != blank -%}
        <div class="text-container">
          {%- if section.settings.title != blank -%}
            <div class="title-container">
              <h2>{{ section.settings.title }}</h2>
            </div>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="description-container">
              <p>{{ section.settings.description }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <style>
      .hero-image {
        position: relative;
      }

      .hero-image img {
        aspect-ratio: 21 / 9;
        width: 100%;
      }

      .text-container {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 50%;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 4px;
      }

      .title-container,
      .description-container {
        background: rgba(254, 254, 254, 0.60);
        backdrop-filter: blur(4.087094783782959px);
        -webkit-backdrop-filter: blur(4.087094783782959px);
        border-radius: 1px;
        padding: 4.9px 12px;
        color: var(--Black, #444);
      }

      .title-container h2,
      .description-container p {
        color: var(--Black, #444);
      }

      .title-container h2 {
        margin: 0;
        font-size: 13px;
        font-family: Helvetica
        , Arial
        , sans-serif;
        text-transform: uppercase;
        font-weight: 400;
        padding: 4.9;
      }

      .description-container p {
        margin: 0;
        font-size: 16px;
        font-family: adobe-garamond-pro
        , "Adobe Garamond Pro"
        , AGaramondPro-Regular
        , "EB Garamond"
        , Garamond
        , serif;
        padding: 0;
      }

      /* TODO: add/edit rules to change image size for mobile */

      @media (max-width: 767px) {
        .hero-image {
          max-height: 100vh;
          /* adjusted from 100vh */
          /* padding-top: 40px; */
          /* Add space for header on mobile */
        }

        .hero-image img {
          height: 100%;
          aspect-ratio: auto;
          object-fit: cover;
        }

        .text-container {
          width: 80%;
          bottom: 0;
          right: 0;
          padding: 4px;
        }
      }
    </style>
  {%- endif -%}
{% endunless %}

{% schema %}
  {
    "name": "Hero Image",
    "settings": [
      {
        "type": "select",
        "id": "hero_height",
        "label": "Hero Height",
        "options": [
          {
            "value": "h-screen",
            "label": "Full screen"
          }, {
            "value": "h-[65vh]",
            "label": "Medium"
          }, {
            "value": "h-[30vh]",
            "label": "Small"
          }
        ],
        "default": "h-screen"
      },
      {
        "type": "checkbox",
        "id": "add_padding",
        "label": "Add mobile padding",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Desktop Image"
      },
      {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description"
      }
    ],
    "presets": [
      {
        "name": "Hero Image",
        "category": "Image"
      }
    ]
  }
{% endschema %}