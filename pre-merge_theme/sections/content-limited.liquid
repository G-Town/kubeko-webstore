<div class="flex flex-col md:flex-row h-full bg-[#d9d9d9] w-full">
  <div class="w-full md:w-1/2 relative mobile-square">
    <div class="absolute inset-0">
      {% if section.settings.video != blank %}
        <video 
          class="w-full h-full object-cover"
          autoplay
          loop
          muted
          playsinline
        >
          {% for source in section.settings.video.sources %}
            <source src="{{ source.url }}" type="video/{{ source.format }}">
          {% endfor %}
          {% if section.settings.image %}
            <img
              class="w-full h-full object-cover"
              src="{{ section.settings.image | img_url: 'master' }}"
              alt="{{ section.settings.image.alt | default: 'About Us' }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              srcset="{{ section.settings.image | img_url: '400x' }} 400w,
                      {{ section.settings.image | img_url: '600x' }} 600w,
                      {{ section.settings.image | img_url: '800x' }} 800w,
                      {{ section.settings.image | img_url: '1200x' }} 1200w,
                      {{ section.settings.image | img_url: '1600x' }} 1600w,
                      {{ section.settings.image | img_url: 'master' }} {{ section.settings.image.width }}w"
              sizes="(max-width: 767px) 100vw, 50vw"
            >
          {% endif %}
        </video>
      {% elsif section.settings.image %}
        <img
          class="w-full h-full object-cover"
          src="{{ section.settings.image | img_url: 'master' }}"
          alt="{{ section.settings.image.alt | default: 'About Us' }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          srcset="{{ section.settings.image | img_url: '400x' }} 400w,
                  {{ section.settings.image | img_url: '600x' }} 600w,
                  {{ section.settings.image | img_url: '800x' }} 800w,
                  {{ section.settings.image | img_url: '1200x' }} 1200w,
                  {{ section.settings.image | img_url: '1600x' }} 1600w,
                  {{ section.settings.image | img_url: 'master' }} {{ section.settings.image.width }}w"
          sizes="(max-width: 767px) 100vw, 50vw"
        >
      {% endif %}
    </div>
  </div>
  
  <div class="w-full flex-1 md:h-full md:w-1/2 flex flex-col p-1">
    {% comment %} TODO: change dark grey to a lighter tone here and switch to black text (re-add mb-1 if btn is re-added) {% endcomment %}
    <div class="w-full flex-grow text-center bg-[#efefef] text-black flex flex-col justify-center items-center overflow-y-auto">
      <div class="max-w-[426px] flex flex-col py-8">
        <h1 class="uppercase mb-[50px] text-sm font-helvetica">{{ section.settings.title }}</h1>
        
        <div class="rich-text-content font-garamond">
          {{ section.settings.content }}
        </div>
      </div>
    </div>
    {% comment %} TODO: consider restyling button {% endcomment %}
    {% comment %} <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="w-full h-[50px] flex items-center justify-center bg-[#4A4A4A] text-white hover:bg-[#D9D9D9] hover:text-black transition-colors">
      <span class="uppercase text-sm">
        {{ section.settings.button_text | default: 'Continue Shopping' }}
      </span>
    </a> {% endcomment %}
  </div>
</div>

<style>
  .mobile-square {
    padding-top: 100%;
  }
  
  @media (min-width: 768px) {
    .mobile-square {
      padding-top: 0;
      height: 100%;
    }
  }
  
  .rich-text-content {
    font-family: 'adobe-garamond-pro', serif;
    font-size: 16px !important;
    font-weight: 400;
  }
  
  h1.font-helvetica {
    font-family: 'helvetica-now-text', sans-serif;
    letter-spacing: 0.5px;
  }
  
  .rich-text-content p {
    margin-bottom: 1.5rem;
    white-space: pre-line;
    font-family: 'adobe-garamond-pro', serif;
    font-size: 16px !important;
  }
  
  .rich-text-content p:last-child {
    margin-bottom: 0;
  }
  
  .rich-text-content a {
    text-decoration: underline;
  }
  
  .rich-text-content strong {
    font-weight: 600;
  }
  
  .rich-text-content em {
    font-style: italic;
  }
  
  .rich-text-content br {
    display: block;
    content: "";
    margin-top: 1rem;
  }

/* TODO: this solution should allow any length of content on mobile, need something else for desktop */
@media (max-width: 767px) {
  /* Target the parent flex container on mobile */
  .flex-col.h-full {
    /* Allow it to grow with content */
    height: auto;
    min-height: auto;
  }

  /* Ensure the desktop height setting doesn't interfere */
  /* .md\:h-full {
    height: auto !important;
  } */
}

</style>

{% schema %}
{
  "name": "Content Limited",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image (shown if video can't play or is not set)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "CONTENT LIMITED"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>A shy rebellion<br>for turbulent hearts soothed by surrounding sounds.<br><br>Neither the best nor second best,<br>but what is purely yours.<br><br>Worn, carried, and engraved in timeless.</p>"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CONTINUE SHOPPING"
    }
  ],
  "presets": [
    {
      "name": "About Page",
      "category": "Text"
    }
  ]
}
{% endschema %}
