{% schema %}
{
  "name": "Hero Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Desktop Video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Related Product"
    }
  ],
  "presets": [
    {
      "name": "Hero Video",
      "category": "Video"
    }
  ]
}
{% endschema %}

{% if section.settings.video != blank %}
<div class="hero-video w-screen h-screen md:h-min">
  <div class="desktop-video hidden md:block">
    {{ section.settings.video | video_tag: class: 'w-full h-full object-cover', autoplay: true, loop: true, muted: true, playsinline: true }}
  </div>
  
  <div class="mobile-video md:hidden">
    {% assign mobile_video = section.settings.mobile_video | default: section.settings.video %}
    {{ mobile_video | video_tag: class: 'w-full h-full object-cover', autoplay: true, loop: true, muted: true, playsinline: true }}
  </div>
</div>

<style>
  .hero-video {
    position: relative;
  }
  
  .hero-video video {
    width: 100%;
    aspect-ratio: 21/9;
  }
  
  @media screen and (max-width: 767px) {
    .hero-video {
      height: 100vh;
    }
    
    .hero-video video {
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
    }
  }
</style>
{% endif %}
