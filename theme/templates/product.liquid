        const data = {
            variants: window.productVariants || [],
            allImages: window.allProductImages || []
        };

        productImageManager = new ProductImageManager(data);
        window.productImageManager = productImageManager;

        // Determine default variant
        const firstVariant =
            data.variants.find(v => v.available) ||
            data.variants[0];

        if (firstVariant) {
            const images = productImageManager.getImagesForVariant(firstVariant);

            productImageManager._syncGalleryLength(images.slice(2));
            productImageManager.initMobileThumbnails(images);
            productImageManager.initMobileGallery(images);
            // Mark selected color chip
            const colorBtn = document.querySelector(
                `.color-chip[data-value="${firstVariant.option1}"]`
            );
            if (colorBtn) {
                colorBtn.setAttribute("data-selected", "true");
                colorBtn.closest(".color-chip-container")
                    ?.classList.add("active");
            }
        }
    });
