<div>
  <div class="text-center mb-2 font-helvetica text-sm ">
    {{ look_index }}
  </div>
  {% for photo in look.look_photos.value limit:1 %}
    {%- assign look_id = photo.id | split: '/' | last -%}

    <div class="h-auto">
      <a href="/pages/look-detail?look={{ look_id }}"
          class="collection-card-link block"
          data-look-id="{{ look_id }}"
          data-look-index="{{ look_index }}">
        <img
          class="w-full h-full object-cover"
          alt="{{ photo.alt | escape }}"
          src="{{ photo | image_url: width: 900 }}"
          srcset="
            {{ photo | image_url: width: 700 }} 700w,
            {{ photo | image_url: width: 900 }} 900w,
            {{ photo | image_url: width: 1200 }} 1200w,
            {{ photo | image_url: width: 1600 }} 1600w
          "
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
          loading="lazy"
          width="{{ photo.width }}"
          height="{{ photo.height }}"
        />
        </a>
      </div>
  {% endfor %}
</div>