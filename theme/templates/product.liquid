  <script>
    // Modified function to open popups - closes any other open popups first
    function openPopup(popupId) {
      // First close all popups
      const popups = document.querySelectorAll('#shipping-popup, #size-guide-popup, #materials-popup, #shipping-popup-mobile, #size-guide-popup-mobile, #materials-popup-mobile');
      popups.forEach(popup => {
        popup.classList.add('hidden');
      });
      
      const overlay = document.getElementById('popup-overlay');
      overlay.classList.remove('hidden');
      
      const popup = document.getElementById(popupId);
      if (!popup) return;

      popup.classList.remove('hidden');
      document.body.classList.add('popup-active');
      
      // On mobile devices, scroll to popup position for visibility
      if (window.innerWidth < 768) {
        // Store the current scroll position before opening popup
        window.lastScrollPosition = window.pageYOffset;
        
        // Small delay to ensure the popup is rendered before calculating position
        setTimeout(() => {
          // Get the popup's position
          const popupRect = popup.getBoundingClientRect();
          
          // Calculate the optimal scroll position - account for top navigation and 48px offset
          // const headerHeight = 12; // Adjusted to account for the 48px offset
          const headerHeight = 45;
          const scrollToY = Math.max(0, window.pageYOffset + popupRect.top - headerHeight);
          
          // Use smooth scrolling
          window.scrollTo({
            top: scrollToY,
            behavior: 'smooth'
          });
        }, 50);
      }
    }
    
    // Modified function to close popups
    function closePopup(popupId) {
      const popup = document.getElementById(popupId);
      if (popup) {
        popup.classList.add('hidden');
        
        // Hide the overlay
        const overlay = document.getElementById('popup-overlay');
        overlay.classList.add('hidden');
        
        // Remove the active popup class from the body
        document.body.classList.remove('popup-active');
        
        // On mobile, restore previous scroll position if it exists
        if (window.innerWidth < 768 && typeof window.lastScrollPosition !== 'undefined') {
          setTimeout(() => {
            window.scrollTo({
              top: window.lastScrollPosition,
              behavior: 'smooth'
            });
          }, 50);
        }
      }
    }
    
    function closeAllPopups() {
      const popups = document.querySelectorAll('#shipping-popup, #size-guide-popup, #materials-popup, #shipping-popup-mobile, #size-guide-popup-mobile, #materials-popup-mobile');
      popups.forEach(popup => {
        const popupId = popup.id;
        if (!popup.classList.contains('hidden')) {
          closePopup(popupId);
        }
      });
    }
    
    // Add click handler to overlay
    document.getElementById('popup-overlay').addEventListener('click', function() {
      closeAllPopups();
    });

    // Add click handlers for header elements on mobile
    const mobileHeaderElements = ['site-header', 'header-overlay'].map(id => 
      document.querySelector('#' + id)
    ).filter(Boolean);
    
    mobileHeaderElements.forEach(element => {
      element.addEventListener('click', function() {
        if (window.innerWidth < 768) {
          closeAllPopups();
        }
      });
    });


    /* ===========================
      Prioritized color-first image manager
      =========================== */
    class ProductImageManager {
      constructor({ variants = window.productVariants || [], allImages = window.allProductImages || [] } = {}) {
        this.variants = variants;
        this.allImages = allImages;
        this.currentVariant = null;
        // this.init();
      }

      _groupVariantsByColor() {
        const map = {};
        (this.variants || []).forEach(v => {
          const color = v.option1 || '__no_color__';
          if (!map[color]) map[color] = [];
          map[color].push(v);
        });
        return map;
      }

      // Return an array of image URLs for a variant, preserving order (main first)
      getImagesForVariant(variant) {
        if (!variant) return [];
        // variant.featured_image may be an object with .src or a string depending on serialization
        const featuredSrc = (variant.featured_image && (variant.featured_image.src || variant.featured_image)) || null;
        if (!featuredSrc) return [];

        // Normalize helper
        // const normalize = s => (s || '').replace(/^https?:/, '');
        // const normFeatured = normalize(featuredSrc);

        // If allImages entries are objects or strings, try to extract URL
        const extractUrl = (img) => {
          if (!img) return '';
          if (typeof img === 'string') return img;
          if (img.src) return img.src;
          if (img.url) return img.url;
          return '';
        };

        // const urls = this.allImages.map(extractUrl).map(normalize);
        const urls = this.allImages.map(extractUrl);
        const startIndex = urls.findIndex(u => u && u.includes(featuredSrc.replace(/^\/\//, '')));
        if (startIndex === -1) {
          // fallback: return featuredSrc alone
          return [featuredSrc];
        }

        // collect images until we hit another variant's featured image (to keep variant group)
        const result = [];
        for (let i = startIndex; i < urls.length; i++) {
          const u = urls[i];
          if (!u) continue;
          // stop if this url matches another variant's featured image (and it's not the same as this variant)
          const isAnotherFeatured = this.variants.some(other => {
            if (!other.featured_image) return false;
            const otherSrc = (other.featured_image.src || other.featured_image);
            if (!otherSrc) return false;
            // return normalize(otherSrc) === u && (otherSrc !== featuredSrc);
            return otherSrc === u && (otherSrc !== featuredSrc);
          });
          if (i > startIndex && isAnotherFeatured) break;
          result.push(extractUrl(this.allImages[i]));
        }

        return result.length ? result : [featuredSrc];
      }

      // Public: load a variant's images into the DOM
      // If force===true, re-load even if currently loaded.
      async loadVariant(variant, { force = false } = {}) {
        if (!variant) return;
        if (!force && this.currentVariant && this.currentVariant.id === variant.id) return;

        const images = this.getImagesForVariant(variant);
        if (!images || images.length === 0) return;

        let activeRightIndex = 0;
        const rightContainer = document.getElementById('image-scroll-container');
        if (rightContainer) {
          const containerHeight = rightContainer.offsetHeight;
          const scrollPosition = rightContainer.scrollTop;
          activeRightIndex = Math.round(scrollPosition / containerHeight);
        }
        let activeMobileIndex = 0;
        const mobileGalleryContainer = document.getElementById('mobile-gallery-container');
        if (mobileGalleryContainer) {
          const containerWidth = mobileGalleryContainer.offsetWidth;
          const scrollPosition = mobileGalleryContainer.scrollLeft;
          activeMobileIndex  = Math.round(scrollPosition / containerWidth);
        }

        this.updateAllImages(images, activeRightIndex)
        this.updateAllMobileImages(images, activeMobileIndex);
        // this.initMobileGallery(images);
        // this.initMobileThumbnails(images);

        this.currentVariant = variant;
      }

      _buildSizedUrl(url, width) {
        return `${url.split('?')[0]}?width=${width}`;
      }

