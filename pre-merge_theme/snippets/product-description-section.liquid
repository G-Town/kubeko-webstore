{% assign shipping_data = product.metafields.custom.shipping | default: settings.default_shipping_info %}
{% assign exchange_data = product.metafields.custom.exchanges_and_returns
| default: settings.default_exchange_info
%}
{% assign size_chart = product.metafields.custom.size_chart %}


<product-description class="flex flex-col gap-[10px] transition-all" data->
  <div class="flex flex-row gap-[15px] sm:gap-[10px]">
    <p class="bold-body opacity-50" tabindex="0" id="toggle-description" role="button">Description</p>
    {% if size_chart %}
    <p class="bold-body opacity-50" tabindex="0" id="toggle-sizing" role="button">Sizing</p>
    {% endif %}
    <p class="bold-body opacity-50"  tabindex="0"id="toggle-shipping" role="button">Shipping</p>
    <p class="bold-body opacity-50" tabindex="0" id="toggle-returns" role="button">Returns</p>
  </div>
  <div class="pointer-events-none hidden" id="sizing-content" >
  <size-chart class="body" data-size-chart='{{ size_chart  }}'></size-chart>
  </div>
  <div class="body !text-left" id="description-content">
      {{ product.description }}
  </div>
  <div class="pointer-events-none hidden" id="shipping-content">
    <p>
      {{ shipping_data }}
    </p>
    
  </div>
  <div class="pointer-events-none hidden" id="returns-content">
    <p>
      {{ exchange_data }}
    </p>
  </div>
</product-description>
