      updateAllMobileImages(urls, activeIndex) {
        const container = document.getElementById('mobile-gallery-container');
        if (!container) return;

        // First: sync DOM length
        this._syncMobileGallery(urls);

        // Now collect stable elements AFTER sync
        const allSlides = Array.from(
          container.querySelectorAll('.mobile-gallery-slide img')
        );

        // Replace active first
        this._replaceRightImage(
          allSlides[activeIndex],
          urls[activeIndex],
          { preloadWidth: 600 }
        );

        // Replace others
        for (let i = 0; i < urls.length; i++) {
          if (i === activeIndex) continue;
          this._replaceRightImage(
            allSlides[i],
            urls[i],
            { preloadWidth: 600 }
          );
        }

        // Update thumbnails last
        this.updateMobileThumbnails(urls);

        // FIX: Force the opacity update immediately after rebuilding thumbnails
        if (typeof window.updateActiveMobileThumbnail === 'function') {
            window.updateActiveMobileThumbnail(activeIndex);
        }
      }

      updateMobileThumbnails(urls = []) {
        const wrapper = document.querySelector('.mobile-thumbnail-wrapper .mobile-gallery');
        if (!wrapper) return;

        wrapper.innerHTML = '';

