{% paginate collections by 24 %}
  <div class="md:flex md:flex-wrap">
    {% for collection in collections %}
{% if collection.metafields.custom.isdrop == true %}
        <div class="relative h-4/5 w-full md:w-1/3 p-[5px] group flex-shrink-0">
          <!-- Determine first image -->
          {% if collection.image %}
            {% assign first_image = collection.image %}
          {% else %}
            {% assign products = collection.products %}
            {% if products.size > 0 %}
              {% assign first_image = products.first.featured_image %}
            {% endif %}
          {% endif %}
          
          <!-- Determine second image (for hover) -->
          {% if collection.products.size > 1 %}
            {% assign second_product = collection.products[1] %}
            {% if second_product.featured_image %}
              {% assign second_image = second_product.featured_image %}
            {% else %}
              {% assign second_image = first_image %}
            {% endif %}
          {% else %}
            {% assign second_image = first_image %}
          {% endif %}
          
          <div class="relative block h-full overflow-visible">
            <a href="{{ collection.url }}" class="block h-full relative overflow-hidden">
              <!-- First image -->
              {% if first_image %}
                <img 
                  src="{{ first_image | img_url: '800x1000', crop: 'center' }}" 
                  alt="{{ collection.title | escape }}"
                  width="800"
                  height="1000"
                  class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0"
                  srcset="{{ first_image | img_url: '400x500', crop: 'center' }} 400w,
                          {{ first_image | img_url: '600x750', crop: 'center' }} 600w,
                          {{ first_image | img_url: '800x1000', crop: 'center' }} 800w,
                          {{ first_image | img_url: '1200x1500', crop: 'center' }} 1200w"
                  sizes="(max-width: 767px) 100vw, 33vw"
                  loading="lazy"
                  style="will-change: opacity;"
                >
                <!-- Second image (hover) -->
                <img 
                  src="{{ second_image | img_url: '800x1000', crop: 'center' }}" 
                  alt="{{ collection.title | escape }} (hover)"
                  width="800"
                  height="1000"
                  class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  srcset="{{ second_image | img_url: '400x500', crop: 'center' }} 400w,
                          {{ second_image | img_url: '600x750', crop: 'center' }} 600w,
                          {{ second_image | img_url: '800x1000', crop: 'center' }} 800w,
                          {{ second_image | img_url: '1200x1500', crop: 'center' }} 1200w"
                  sizes="(max-width: 767px) 100vw, 33vw"
                  loading="lazy"
                  style="will-change: opacity; visibility: hidden;"
                  onload="this.style.visibility = 'visible';"
                >
              {% else %}
                <div class="w-full h-full bg-[#f5f5f5] flex items-center justify-center">
                  <span class="text-[#999999] text-sm">No image available</span>
                </div>
              {% endif %}
              
              <!-- Collection info bar (always visible, positioned over the image) -->
              <div class="absolute bottom-0 left-0 right-0 m-[4px] z-10">
                <div class="relative bg-[#F5F5F5]/60 backdrop-blur-[12.5px] px-4 py-3">
                  <h2 class="uppercase text-sm tracking-wider">{{ collection.title }}</h2>
                </div>
              </div>
            </a>
          </div>
        </div>
   {% endif %}
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="sticky bottom-0 left-0 w-full bg-black/80 p-4 flex justify-center gap-4 z-50">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}" class="text-white hover:opacity-80">Previous</a>
      {% endif %}
      
      <span class="text-white">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
      
      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" class="text-white hover:opacity-80">Next</a>
      {% endif %}
    </div>
  {% endif %}
{% endpaginate %}

{% schema %}
{
  "name": "Collections List",
  "settings": [],
  "presets": [
    {
      "name": "Collections List",
      "category": "Collections"
    }
  ]
}
{% endschema %}

{% style %}
.group:hover .group-hover\:opacity-100 {
  opacity: 1 !important;
  visibility: visible !important;
}

.group:hover .group-hover\:opacity-0 {
  opacity: 0 !important;
}

.absolute {
  position: absolute;
}

.inset-0 {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}
{% endstyle %} 