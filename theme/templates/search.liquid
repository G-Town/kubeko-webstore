<div class="px-[18px] flex flex-col sm:grid sm:grid-cols-6 gap-[18px] pb-[72px] pt-[72px] sm:pt-0">
  <!-- Sidebar with search form -->
  <div class="relative sm:sticky top-0 -mx-[18px] sm:mx-0 w-screen sm:w-auto sm:h-screen flex flex-col sm:justify-center">
    <form action="/search" method="get" class="w-full sm:w-auto overflow-x-scroll hide-scrollbar">
      <input type="hidden" name="type" value="product">
      <div class="sm:mb-[15px] gap-[12px] sm:gap-[6px] flex flex-col sm:pt-0 w-fit sm:mx-auto px-[18px] sm:px-0 sm:ml-0">
        <p class="cta flex-shrink-0">
          {% if search.performed %}
            {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;
          {% else %}
            Search
          {% endif %}
        </p>
        <search-widget class="cursor-pointer flex flex-col">
          <input
            type="text"
            name="q"
            id="search"
            class="cta black form-input focus:outline-none !rounded-none border-b border-black bg-[#F5F5F5]/60"
            placeholder="Search..."
            value="{{ search.terms | escape }}"
            autocomplete="off">
        </search-widget>
      </div>
      {% comment %} <div class="break hidden sm:block"></div> {% endcomment %}
    </form>
  </div>

  <!-- Results area -->
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="col-span-5 sm:my-auto sm:relative page-title">
        Sorry, there are no results for &ldquo;{{ search.terms | escape }}&rdquo;.
      </p>
    {% else %}
      {% paginate search.results by 24 %}
        <div
          class="col-span-5 md:mt-[36px] grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-[9px] sm:gap-[18px] items-center opacity-0 duration-300 transform-gpu"
          id="product-grid"
          data-current-page="{{ paginate.current_page }}"
          data-total-pages="{{ paginate.pages }}">
          {% for result in search.results %}
            <div id="product-{{ forloop.index }}-{{ paginate.current_page }}">
              {% render 'product-card', product: result %}
            </div>
          {% endfor %}
        </div>
      {% endpaginate %}
    {% endif %}
  {% else %}
    <p class="col-span-5 sm:my-auto sm:relative page-title opacity-50">
      Enter a search term above.
    </p>
  {% endif %}
</div>

{% if search.performed and search.results_count > 0 %}
  <script>
    (function () {
      const productGrid = document.getElementById('product-grid');
      if (!productGrid) return;

      let currentPage = parseInt(productGrid.dataset.currentPage);
      const totalPages = parseInt(productGrid.dataset.totalPages);

      const getPaginatedUrl = (page) => {
        const url = new URL(window.location.href);
        url.searchParams.set('page', page);
        return url.toString();
      };

      const fetchAndAppendProducts = (page, appendBefore = false) => {
        return fetch(getPaginatedUrl(page))
          .then((response) => response.text())
          .then((html) => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newProducts = doc.querySelectorAll('#product-grid > *');

            if (appendBefore) {
              Array.from(newProducts)
                .reverse()
                .forEach((product) => {
                  productGrid.insertBefore(product, productGrid.firstChild);
                });
            } else {
              newProducts.forEach((product) => {
                productGrid.appendChild(product);
              });
            }
          });
      };

      const loadPreviousPages = async (page) => {
        for (let p = page - 1; p >= 1; p--) {
          await fetchAndAppendProducts(p, true);
        }
      };

      let isLoading = false;

      window.addEventListener('scroll', () => {
        if (window.scrollY + window.innerHeight >= document.body.scrollHeight - 300 && !isLoading) {
          if (currentPage < totalPages) {
            isLoading = true;
            currentPage++;
            fetchAndAppendProducts(currentPage).then(() => {
              isLoading = false;
              if (currentPage > 1) {
                window.history.pushState({ page: currentPage }, '', getPaginatedUrl(currentPage));
              }
            });
          }
        }
      });

      loadPreviousPages(currentPage).then(() => {
        productGrid.classList.remove('opacity-0');
      });
    })();
  </script>
{% endif %}
