{% style %}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 110;
  }
{% endstyle %}
<div class="z-[110] w-full flex text-black justify-center">
  <header class="flex items-center w-full left-1/2 z-[110] text-[#44444] font-helvetica text-sm md:h-[52px]" id="site-header">
      <div class="absolute inset-0 md:h-[49px] rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px]" id="header-overlay"></div>
      
      <style>
        .menu-dropdown::before {
          content: '';
          position: absolute;
          top: -8px;
          left: 0;
          right: 0;
          height: 8px;
        }

        .submenu-content {
          position: relative;
        }

        .submenu-item {
          width: fit-content;
        }
        
        /* Dropdown menu hover effects - default state */
        .menu-dropdown .submenu-item a,
        .submenu-content a {
          opacity: 0.5 !important;
          transition: opacity 0.2s ease !important;
        }
        
        /* First level - restore opacity for hovered submenu-item */
        .menu-dropdown .submenu-item:hover > a {
          opacity: 1 !important;
        }
        
        /* Second level - restore opacity for hovered grandchild link */
        .submenu-content a:hover {
          opacity: 1 !important;
        }
        
        /* Keep parent and child items visible when grandchild is being hovered */
        .menu-dropdown .submenu-item.active > a {
          opacity: 1 !important;
        }
        
        /* Mobile menu opacity behavior similar to desktop */
        #mobile-menu .mobile-parent-container a {
          opacity: 1 !important;
          transition: opacity 0.2s ease !important;
        }
        
        /* Make all inactive links opaque when one parent is active */
        #mobile-menu:has(.mobile-children:not(.hidden)) .mobile-parent-container > a:not(:has(+ .mobile-children:not(.hidden))) {
          opacity: 0.5 !important;
        }
        
        /* Keep the active parent visible */
        #mobile-menu .mobile-parent-container > a:has(+ .mobile-children:not(.hidden)) {
          opacity: 1 !important;
        }
        
        /* Children should be opaque by default */
        #mobile-menu .mobile-children a {
          opacity: 0.5 !important;
        }
        
        /* Make inactive children opaque when one is active */
        #mobile-menu:has(.mobile-child-active) .mobile-child-link:not(.mobile-child-active) {
          opacity: 0.5 !important;
        }
        
        /* Keep the active child and its children visible */
        #mobile-menu .mobile-child-active {
          opacity: 1 !important;
        }
        
        /* Make active parent's direct children normal opacity when no child is selected */
        #mobile-menu .mobile-children:not(.hidden) > a {
          opacity: 0.5 !important;
        }
        
        #mobile-menu .mobile-children:not(.hidden) > a:hover {
          opacity: 1 !important;
        }
        
        /* Quantity adjustment button styles */
        .quantity-adjust {
          cursor: pointer;
          transition: all 0.2s ease;
          border-radius: 2px;
          min-width: 28px;
          height: 28px;
          display: flex;
          align-items: center;
          justify-content: center;
          /* Nudge the +/− glyphs up 1px so their ink centers align with the
             quantity digits. */
          padding: 0 8px 2px;
          font-size: 16px;
        }
        
        .quantity-adjust:hover {
          background-color: #C9C9C9;
        }

        .quantity-value {
          min-width: 24px;
          text-align: center;
        }
        
        /* Remove button styles */
        .remove-item {
          transition: all 0.2s ease;
          border-radius: 2px;
          color: black !important;
          text-transform: uppercase;
          font-size: 13px;
          padding: 3px 6px;
          cursor: pointer;
        }
        
        .remove-item:hover {
          background-color: #C9C9C9;
          opacity: 1 !important;
        }
        
        /* Full-bleed line-item row. The row is not clickable, so it has no
           hover state; the static tint groups rows without implying
           interactivity. Horizontal padding matches the footer inset. */
        .cart-item {
          padding: 10px 20px;
          background-color: rgba(255, 255, 255, 0.35);
        }

        .cart-item-top {
          padding-top: 8px;
        }
        
        /* Add space for header on mobile product listing pages */
        @media (max-width: 767px) {
          /* Adjust product grid container on mobile */
          .template-collection #product-grid,
          .template-collection .grid,
          .template-list-collections .grid {
            padding-top: 0 !important;
          }
          
          /* Hero image section on mobile */
          .hero-image {
            padding-top: 0 !important;
          }
          
          /* Side by side assets section on mobile */
          .side-by-side-assets {
            padding-top: 0 !important;
          }
          
          /* First section on index page */
          .template-index > div > div:first-child {
            padding-top: 0 !important;
          }
        }

        #header-logo.logo-hidden {
          opacity: 0 !important;
        }

        .header-actions > * { transition: opacity 0.2s ease; }
        .header-actions:hover > *:not(:hover) { opacity: 0.4; }
        .header-actions > *:hover { opacity: 1; }

        .header-search-icon {
          display: inline-flex;
          align-items: center;
          /* width: 13px;
          height: 13px; */
        }

        .header-search-form {
          display: inline-flex;
          align-items: center;
        }

        .header-search-form[hidden] {
          display: none;
        }

        .header-search-input {
          width: 120px;
          padding: 0;
          border: 0;
          border-bottom: 1px solid currentColor;
          background: transparent;
          border-radius: 0;
          color: currentColor;
          outline: none;
          text-transform: uppercase;
        }

        .header-search-input::placeholder {
          color: currentColor;
          opacity: 0.5;
        }
      </style>
      
      <!-- Mobile Header -->
      <nav class="md:hidden flex px-[15px] py-[17.5px] flex-row relative w-full items-center uppercase">
        <button class="text-sm uppercase" id="mobile-menu-trigger">MENU</button>
        <a href="/" class="absolute left-1/2 -translate-x-1/2">
          {% render 'logo' %}
        </a>
        <div class="ml-auto flex items-center gap-5">
          <button type="button" id="mobile-search-trigger" class="flex items-center hover:opacity-60 transition-opacity" aria-expanded="false" aria-controls="mobile-search-bar">
            <svg xmlns="http://www.w3.org/2000/svg" width="1.25em" height="1.25em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none" />
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="m21 21l-4.34-4.34" />
                <circle cx="11" cy="11" r="8" />
              </g>
            </svg>
          </button>
          <div class="relative mobile-cart-trigger">
            <p class="cursor-pointer text-sm uppercase hover:opacity-60 transition-opacity">
              Cart<span class="absolute -top-1 -right-2 {% if cart.item_count >= 10 %}-right-[12px]{% endif %} text-[10px] cart-count" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>{{ cart.item_count }}</span>
            </p>
          </div>
        </div>
      </nav>
      
      <!-- Desktop Header -->
      <nav class="hidden md:flex h-full flex-row relative w-full items-center px-6 uppercase max-w-[1024px] lg:max-w-[1256px] xl:max-w-[1580px] mx-auto">
        <ul class="flex items-center gap-12 transition-all duration-30" id="header-nav">
          {% for link in linklists.main-menu.links %}
            {%- assign link_is_active = false -%}
            {%- if link.active or link.child_active -%}{%- assign link_is_active = true -%}{%- endif -%}
            <li class="relative group"{% if link_is_active %} data-page-active="true"{% endif %}>
              <a
                href="{{ link.url }}"
                class="cursor-pointer text-sm hover:opacity-60 transition-opacity{% if link.links.size > 0 %} has-children{% endif %}"
                {%- if link_is_active %} aria-current="page"{% endif %}
              >{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
        <a href="/" class="absolute left-1/2 -translate-x-1/2 transition-all duration-300" id="header-logo">
          {% render 'logo' %}
        </a>
        <div class="ml-auto flex items-center gap-8 header-actions">
          <div class="header-search">
            <button
              id="desktop-search-trigger"
              type="button"
              class="header-action cursor-pointer text-sm uppercase transition-opacity"
              aria-expanded="false"
              aria-controls="header-search-form"
            >
              <span>Search</span>
            </button>

            <form
              id="header-search-form"
              class="header-search-form"
              action="/search"
              method="get"
              role="search"
              hidden
            >
              <input type="hidden" name="type" value="product">
              <input
                id="header-search-input"
                class="header-search-input text-sm uppercase"
                type="search"
                name="q"
                aria-label="Search"
                placeholder="Search"
                autocomplete="off"
              >
            </form>
          </div>

          <button type="button" class="header-action desktop-cart-trigger relative cursor-pointer text-sm uppercase transition-opacity">
            <span>Cart</span>
            <span class="absolute -top-1 -right-2 {% if cart.item_count >= 10 %}-right-[12px]{% endif %} text-[10px] cart-count" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
              {{ cart.item_count }}
            </span>
          </button>
        </div>
      </nav>
    </header>
</div>

<!-- Mobile Menu Dropdown -->
<div class="w-full flex justify-center">
  <div class="w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[864px]">
    <div class="fixed top-[52px] md:top-[50px] md:mt-[4px] bottom-[4px] md:bottom-[8px] z-[110] hidden flex-col rounded-[1px] bg-white w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[864px] left-1/2 -translate-x-1/2" id="mobile-menu">
      <div class="flex flex-col p-[15px] h-full justify-between">
        <div class="flex h-full">
          <div class="w-full uppercase text-[13px] flex flex-col gap-[8px] py-2 px-2" id="mobile-menu-left">
            {% for link in linklists.main-menu.links %}
              <div class="mobile-parent-container">
                {% if link.title == 'Shop' %}
                  <a href="javascript:void(0)" class="text-black mobile-parent-link py-1 block hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]" data-parent-id="{{ link.title | handleize }}">{{ link.title }}</a>
                  <div class="mobile-children pl-3 mt-2 hidden">
                    {% if link.links.size > 0 %}
                      {% for childlink in link.links %}
                        <a href="{{ childlink.url }}" class="text-black block py-1 mobile-child-link hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]" data-child-id="{{ childlink.title | handleize }}" data-parent-id="{{ link.title | handleize }}" data-has-children="{% if childlink.links.size > 0 %}true{% else %}false{% endif %}">{{ childlink.title }}</a>
                        {% if childlink.links.size > 0 %}
                          <div class="mobile-grandchildren pl-3 mt-1 hidden" data-for-child="{{ childlink.title | handleize }}" data-for-parent="{{ link.title | handleize }}">
                            {% for grandchildlink in childlink.links %}
                              <a href="{{ grandchildlink.url }}" class="text-black block py-1 hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]">{{ grandchildlink.title }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                {% elsif link.title == 'Collections' or link.title == 'Collection' %}
                  {% if link.links.size > 0 %}
                    <a href="{{ link.url }}" class="text-black mobile-parent-link collection-parent py-1 block hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]" data-parent-id="{{ link.title | handleize }}">{{ link.title }}</a>
                    <div class="mobile-children pl-3 mt-2 hidden">
                      {% for childlink in link.links %}
                        <a href="{{ childlink.url }}" class="text-black block py-1 hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]">{{ childlink.title }}</a>
                      {% endfor %}
                    </div>
                  {% else %}
                    <a href="{{ link.url }}" class="text-black py-1 block hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]">{{ link.title }}</a>
                  {% endif %}
                {% else %}
                  <a href="{{ link.url }}" class="text-black mobile-parent-link py-1 block hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]" data-parent-id="{{ link.title | handleize }}">{{ link.title }}</a>
                  <div class="mobile-children pl-3 mt-2 hidden {% if link.links.size == 0 %}no-children{% endif %}">
                    {% if link.links.size > 0 %}
                      {% for childlink in link.links %}
                        <a href="{{ childlink.url }}" class="text-black block py-1 mobile-child-link hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]" data-child-id="{{ childlink.title | handleize }}" data-parent-id="{{ link.title | handleize }}" data-has-children="{% if childlink.links.size > 0 %}true{% else %}false{% endif %}">{{ childlink.title }}</a>
                        {% if childlink.links.size > 0 %}
                          <div class="mobile-grandchildren pl-3 mt-1 hidden" data-for-child="{{ childlink.title | handleize }}" data-for-parent="{{ link.title | handleize }}">
                            {% for grandchildlink in childlink.links %}
                              <a href="{{ grandchildlink.url }}" class="text-black block py-1 hover:opacity-60 transition-opacity text-[13px] h-[32px] px-[25px]">{{ grandchildlink.title }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
        
        <div class="mt-4 text-center">
          <button id="mobile-menu-close" class="uppercase text-[13px] text-black">CLOSE</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Search Bar -->
<div id="mobile-search-bar" class="md:hidden hidden fixed top-[52px] left-0 w-full z-[100] bg-white px-[15px] py-[12px]">
  <form action="/search" method="get" class="w-full">
    <input type="hidden" name="type" value="product">
    <input
      id="mobile-search-input"
      type="search"
      name="q"
      placeholder="Search..."
      autocomplete="off"
      class="w-full bg-transparent border-b border-current text-sm uppercase focus:outline-none placeholder:opacity-50 placeholder:uppercase py-1"
    >
  </form>
</div>

<!-- Mobile Menu Templates (Hidden) -->
<div class="hidden" id="mobile-menu-templates">
  <!-- TODO: This section can be removed as we're no longer using the right panel -->
</div>

<!-- Menu Dropdowns -->
{% for link in linklists.main-menu.links %}
  {% if link.links.size > 0 %}
    {% if link.title == 'Collections' or link.title == 'Collection' %}
      <div class="w-full flex justify-center">
        <div class="w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[864px] relative">
                                                    {% comment %} hidden {% endcomment %}
          <div data-menu="{{ link.title | handleize }}" class="fixed  text-sm text-black uppercase top-[43px] 
              mt-[4px] md:top-[52px] md:mt-[4px] z-[90] menu-dropdown collections-dropdown w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[560px]">
            <div class="rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px]">
              <div class="p-[15px]">
                <div class="flex flex-col gap-[8px] nav-col-left">
                  {% for childlink in link.links %}
                    <div class="submenu-item w-fit"{% if childlink.active or childlink.child_active %} data-submenu-active="true"{% endif %}>
                      <a href="{{ childlink.url }}" class="hover:opacity-60 transition-opacity text-black submenu-link">{{ childlink.title }}</a>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="w-full flex justify-center">
        <div class="w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[864px] relative">
                                                    {% comment %} hidden {% endcomment %}
          <div data-menu="{{ link.title | handleize }}" class="fixed  text-sm text-black uppercase top-[43px] 
              mt-[4px] md:top-[52px] md:mt-[4px] z-[90] menu-dropdown w-[calc(100%-8px)] md:w-[calc(100%-64px)] max-w-[560px] left-2">
            <div class="rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px]">
              <div class="p-[15px]">
                <div class="flex relative">
                  <div class="flex flex-col gap-[8px] nav-col-left" id="parent-menu">
                    {% for childlink in link.links %}
                      <div class="submenu-item" data-submenu="{{ childlink.title | handleize }}"{% if childlink.active or childlink.child_active %} data-submenu-active="true"{% endif %}>
                        <a href="{{ childlink.url }}" class="hover:opacity-60 transition-opacity text-black submenu-link{% if childlink.links.size > 0 %} has-children{% endif %}">{{ childlink.title }}</a>
                        {% if childlink.links.size > 0 %}
                          <div class="submenu-children hidden">
                            {% for grandchildlink in childlink.links %}
                              <a href="{{ grandchildlink.url }}" class="hover:opacity-60 transition-opacity text-[#444444]">{{ grandchildlink.title }}</a>
                            {% endfor %}
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                  <div class="submenu-content flex nav-col-right">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}
{% endfor %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('site-header');
    const headerOverlay = document.getElementById('header-overlay');
    const headerNav = document.getElementById('header-nav');
    const headerLogo = document.getElementById('header-logo');
    const menuItems = document.querySelectorAll('nav li');
    const dropdowns = document.querySelectorAll('.menu-dropdown');
    const cartDropdown = document.querySelector('.cart-dropdown');
    const mobileMenu = document.getElementById('mobile-menu');
    let currentDropdown = null;
    let isOverHeader = false;
    let isOverDropdown = false;
    let lastScrollTop = 0;

    function closeCurrentDropdown() {
      if (currentDropdown) {
        currentDropdown.classList.add('hidden');
        currentDropdown.querySelectorAll('.submenu-item').forEach(i => i.classList.remove('active'));
        currentDropdown = null;
        menuItems.forEach(menuItem => menuItem.setAttribute('data-dropdown-active', 'false'));
      }
    }
    
    // Initialize data-dropdown-active attribute for all menu items
    menuItems.forEach(item => {
      item.setAttribute('data-dropdown-active', 'false');
    });

    // Desktop search functionality
    const searchTrigger = document.getElementById('desktop-search-trigger');
    const searchForm = document.getElementById('header-search-form');
    const searchInput = document.getElementById('header-search-input');

    if (searchTrigger && searchForm && searchInput) {
      const openSearch = () => {
        if (currentDropdown && currentDropdown !== searchForm) {
          currentDropdown.classList.add('hidden');
          currentDropdown = null;
        }

        searchTrigger.hidden = true;
        searchForm.hidden = false;
        searchTrigger.setAttribute('aria-expanded', 'true');
        searchInput.focus();
      };

      const closeSearch = () => {
        searchForm.hidden = true;
        searchTrigger.hidden = false;
        searchTrigger.setAttribute('aria-expanded', 'false');
        searchInput.value = '';
      };

      searchTrigger.addEventListener('click', openSearch);

      // Hovering Search closes any open cart or nav dropdown.
      searchTrigger.addEventListener('mouseenter', closeCurrentDropdown);
      searchForm.addEventListener('mouseenter', closeCurrentDropdown);

      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeSearch();
        }
      });

      searchInput.addEventListener('blur', () => {
        if (searchInput.value.trim() === '') {
          closeSearch();
        }
      });

      searchForm.addEventListener('submit', (event) => {
        if (searchInput.value.trim() === '') {
          event.preventDefault();
          closeSearch();
        }
      });
    }

    // Mobile search functionality
    const mobileSearchTrigger = document.getElementById('mobile-search-trigger');
    const mobileSearchBar = document.getElementById('mobile-search-bar');
    const mobileSearchInput = document.getElementById('mobile-search-input');

    if (mobileSearchTrigger && mobileSearchBar && mobileSearchInput) {
      const openMobileSearch = () => {
        if (mobileMenu && mobileMenu.classList.contains('flex')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
        }
        mobileSearchBar.classList.remove('hidden');
        mobileSearchTrigger.setAttribute('aria-expanded', 'true');
        headerOverlay.style.opacity = '1';
        headerOverlay.style.display = 'block';
        headerOverlay.style.backgroundColor = 'white';
        mobileSearchInput.focus();
      };

      const closeMobileSearch = () => {
        mobileSearchBar.classList.add('hidden');
        mobileSearchTrigger.setAttribute('aria-expanded', 'false');
        mobileSearchInput.value = '';
        headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
      };

      mobileSearchTrigger.addEventListener('click', () => {
        if (mobileSearchBar.classList.contains('hidden')) {
          openMobileSearch();
        } else {
          closeMobileSearch();
        }
      });

      mobileSearchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMobileSearch();
        }
      });

      mobileSearchInput.addEventListener('blur', () => {
        if (mobileSearchInput.value.trim() === '') {
          closeMobileSearch();
        }
      });
    }
    
    // Set dropdown positions based on header height - disabled since we're using CSS margin now
    function updateDropdownPositions() {
      // Disabled - using CSS classes for positioning instead
    }
    
    // Mobile menu functionality
    const mobileMenuTrigger = document.getElementById('mobile-menu-trigger');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    
    if (mobileMenuTrigger && mobileMenu && mobileMenuClose) {
      mobileMenuTrigger.addEventListener('click', () => {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        
        // Make the header background white when mobile menu is open
        headerOverlay.style.opacity = '1';
        headerOverlay.style.display = 'block';
        headerOverlay.style.backgroundColor = 'white';
        updateBlendMode(true);
      });

      mobileMenuClose.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        // Reset expanded states when closing
        document.querySelectorAll('.mobile-children').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.mobile-grandchildren').forEach(el => el.classList.add('hidden'));
        
        // Reset active classes for opacity control
        document.querySelectorAll('.mobile-parent-active').forEach(el => {
          el.classList.remove('mobile-parent-active');
        });
        document.querySelectorAll('.mobile-child-active').forEach(el => {
          el.classList.remove('mobile-child-active');
        });
        
        // Reset header background
        headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
        
        // Check scroll position to determine if header should be hidden
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const isAnyDropdownOpen = cartDropdown && !cartDropdown.classList.contains('hidden');
        
        // Keep header visible if any dropdown is open
        if (isAnyDropdownOpen) {
          headerOverlay.style.opacity = '1';
          headerOverlay.style.display = 'block';
          updateBlendMode(true);
        } else if (scrollTop > 0) {
          // Hide header when scrolled and no dropdowns open
          headerOverlay.style.opacity = '0';
          headerOverlay.style.display = 'none';
          updateBlendMode(false);
        }
      });

      // Handle parent link clicks
      document.querySelectorAll('.mobile-parent-link').forEach(link => {
        link.addEventListener('click', (e) => {
          // For all parent links except Collection, let default navigation occur
          if (link.classList.contains('collection-parent')) {
            // Check if collections has any children
            const parentContainer = link.closest('.mobile-parent-container');
            const childrenContainer = parentContainer.querySelector('.mobile-children');
            
            {% assign collectionsHasChildren = false %}
            {% for link in linklists.main-menu.links %}
              {% if link.title == 'Collections' or link.title == 'Collection' %}
                {% if link.links.size > 0 %}
                  {% assign collectionsHasChildren = true %}
                {% endif %}
              {% endif %}
            {% endfor %}
            const hasChildren = {% if collectionsHasChildren %}true{% else %}false{% endif %};
            
            // If no children, allow the default navigation
            if (!hasChildren) {
              return true;
            }
            
            e.preventDefault();
            
            // Toggle collection children display
            if (childrenContainer.classList.contains('hidden')) {
              // First remove all existing active states
              document.querySelectorAll('.mobile-parent-container').forEach(el => {
                el.classList.remove('mobile-parent-active');
                el.querySelector('a').classList.add('menu-faded');
              });
              
              // Then set this one as active
              parentContainer.classList.add('mobile-parent-active');
              link.classList.remove('menu-faded');
              childrenContainer.classList.remove('hidden');
            } else {
              // Reset everything
              document.querySelectorAll('.mobile-parent-container').forEach(el => {
                el.classList.remove('mobile-parent-active');
                el.querySelector('a').classList.remove('menu-faded');
              });
              childrenContainer.classList.add('hidden');
            }
            
          } else if (link.getAttribute('href') === 'javascript:void(0)') {
            // Shop menu - toggle its children
            e.preventDefault();
            
            const parentContainer = link.closest('.mobile-parent-container');
            const childrenContainer = parentContainer.querySelector('.mobile-children');
            
            // Toggle children visibility
            if (childrenContainer.classList.contains('hidden')) {
              // First remove all existing active states
              document.querySelectorAll('.mobile-parent-container').forEach(el => {
                el.classList.remove('mobile-parent-active');
                el.querySelector('a').classList.add('menu-faded');
              });
              
              // Then set this one as active
              parentContainer.classList.add('mobile-parent-active');
              link.classList.remove('menu-faded');
              childrenContainer.classList.remove('hidden');
            } else {
              // Reset everything
              document.querySelectorAll('.mobile-parent-container').forEach(el => {
                el.classList.remove('mobile-parent-active');
                el.querySelector('a').classList.remove('menu-faded');
              });
              childrenContainer.classList.add('hidden');
            }
          }
        });
      });

      // Handle child link clicks with grandchildren
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('mobile-child-link')) {
          const childLink = e.target;
          const childId = childLink.dataset.childId;
          const parentId = childLink.dataset.parentId;
          const hasChildren = childLink.dataset.hasChildren === 'true';
          
          // Only process dropdown logic for children with grandchildren
          if (hasChildren) {
            e.preventDefault();
            
            // Find the grandchildren container for this child
            const grandchildrenContainer = document.querySelector(`.mobile-grandchildren[data-for-child="${childId}"][data-for-parent="${parentId}"]`);
            
            if (grandchildrenContainer) {
              // Remove active class from all child links
              document.querySelectorAll('.mobile-child-link').forEach(el => {
                el.classList.remove('mobile-child-active');
              });
              
              // Add active class to this child link
              childLink.classList.add('mobile-child-active');
              
              // Toggle the visibility of grandchildren
              const isHidden = grandchildrenContainer.classList.contains('hidden');
              
              // Hide all grandchildren first
              document.querySelectorAll('.mobile-grandchildren').forEach(el => {
                el.classList.add('hidden');
              });
              
              // If it was hidden, show it now
              if (isHidden) {
                grandchildrenContainer.classList.remove('hidden');
              } else {
                // If was showing, hide it and remove active state
                childLink.classList.remove('mobile-child-active');
              }
            }
          }
        }
      });
    }

    function updateBlendMode(isVisible) {
      if (isVisible) {
        headerNav.classList.remove('mix-blend-difference');
        headerLogo.classList.remove('mix-blend-difference');
        headerLogo.classList.remove('logo-hidden');
      } else {
        headerNav.classList.add('mix-blend-difference');
        headerLogo.classList.add('mix-blend-difference');
      }
    }

    window.addEventListener('scroll', () => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const isMobile = window.innerWidth < 768;
      
      // Check if any dropdown is open
      const isAnyDropdownOpen = 
        (currentDropdown !== null && !currentDropdown.classList.contains('hidden')) || 
        (mobileMenu && mobileMenu.classList.contains('flex')) ||
        (cartDropdown && !cartDropdown.classList.contains('hidden') && isMobile);
      
      // On any device, keep header visible if a dropdown is open
      if (isAnyDropdownOpen) {
        headerOverlay.style.opacity = '1';
        headerOverlay.style.display = 'block';
        if (headerLogo) headerLogo.classList.remove('logo-hidden');
        updateBlendMode(true);
      } else {
        // When no dropdown is open, hide header when scrolling down
        if (scrollTop > lastScrollTop) {
          headerOverlay.style.opacity = '0';
          headerOverlay.style.display = 'none';
          if (headerLogo) headerLogo.classList.add('logo-hidden');
          updateBlendMode(false);
        } else {
          headerOverlay.style.opacity = '1';
          headerOverlay.style.display = 'block';
          if (headerLogo) headerLogo.classList.remove('logo-hidden');
          updateBlendMode(true);
        }
      }
      
      lastScrollTop = scrollTop;
    });

    // Modified event listeners for header to prevent hiding overlay during scroll
    header.addEventListener('mouseenter', () => {
      isOverHeader = true;
      headerOverlay.style.opacity = '1';
      headerOverlay.style.display = 'block';
      updateBlendMode(true);
    })

    header.addEventListener('mouseleave', () => {
      isOverHeader = false;
      setTimeout(() => {
        if (!isOverDropdown && currentDropdown) {
          closeCurrentDropdown();
        }
      }, 100);
    });

    menuItems.forEach(item => {
      const link = item.querySelector('a');
      if (!link) return;
      
      const menuTitle = link.textContent.toLowerCase().trim().replace(/\s+/g, '-');
      const dropdown = document.querySelector(`[data-menu="${menuTitle}"]`);

      item.addEventListener('mouseenter', () => {
        closeCurrentDropdown();
      });
      
      if (dropdown) {
        // Check if this is Collections/Collection and it has no children
        const isCollection = menuTitle === 'collections' || menuTitle === 'collection';
        
        {% assign collectionsHasNoChildren = false %}
        {% for link in linklists.main-menu.links %}
          {% if link.title == 'Collections' or link.title == 'Collection' %}
            {% if link.links.size == 0 %}
              {% assign collectionsHasNoChildren = true %}
            {% endif %}
          {% endif %}
        {% endfor %}
        const hasNoChildren = isCollection && {% if collectionsHasNoChildren %}true{% else %}false{% endif %};
        
        // If it's Collections with no children, don't set up hover events
        if (isCollection && hasNoChildren) {
          return;
        }
        
        item.addEventListener('mouseenter', () => {
          // Hide any existing dropdown from another parent before showing this one
          if (currentDropdown && currentDropdown !== dropdown) {
            currentDropdown.classList.add('hidden');
            
            // Reset data-dropdown-active for the previous parent
            menuItems.forEach(menuItem => {
              menuItem.setAttribute('data-dropdown-active', 'false');
            });
          }
          
          // Set this item as active
          item.setAttribute('data-dropdown-active', 'true');
          
          dropdown.classList.remove('hidden');
          currentDropdown = dropdown;
          
          // Position the dropdown correctly when it first appears
          positionSubmenu(dropdown);

          // Preselect the active group, or the first group with children,
          // so the right pane is filled as soon as the panel opens.
          const preselectItem =
            dropdown.querySelector('[data-submenu-active="true"]') ||
            Array.from(dropdown.querySelectorAll('.submenu-item')).find((submenuItem) => {
              const children = submenuItem.querySelector('.submenu-children');
              return children && children.children.length > 0;
            });

          if (preselectItem) {
            showSubmenuContent(preselectItem, dropdown, 0);
          }
        });

        const submenuItems = dropdown.querySelectorAll('.submenu-item');
        const submenuContent = dropdown.querySelector('.submenu-content');
        
        submenuItems.forEach((submenuItem, index) => {
          submenuItem.addEventListener('mouseenter', () => {
            showSubmenuContent(submenuItem, dropdown, index);
          });
        });

        dropdown.addEventListener('mouseenter', () => {
          isOverDropdown = true;
          headerOverlay.style.opacity = '1';
          headerOverlay.style.display = 'block';
          updateBlendMode(true);
        });

        dropdown.addEventListener('mouseleave', () => {
          isOverDropdown = false;
          setTimeout(() => {
            if (!isOverHeader && currentDropdown) {
              closeCurrentDropdown();
            }
          }, 100);
        });
      }
    });

    function showSubmenuContent(submenuItem, dropdown, index) {
      const submenuContent = dropdown.querySelector('.submenu-content');
      const submenuChildren = submenuItem.querySelector('.submenu-children');

      dropdown.querySelectorAll('.submenu-item').forEach(item => {
        item.classList.remove('active');
      });
      
      submenuContent.innerHTML = '';

      if (submenuChildren && submenuChildren.children.length > 0) {
        submenuItem.classList.add('active');
        
        // Create wrapper that will position its content starting from the center
        const contentWrapper = document.createElement('div');
        contentWrapper.className = 'flex flex-col gap-[8px]';
        
        // Put children HTMLCollection in Array for array methods
        const children = Array.from(submenuChildren.children);
        // Add each child directly to the wrapper
        children.forEach(child => {
          const clone = child.cloneNode(true);
          contentWrapper.appendChild(clone);
        });
        
        submenuContent.appendChild(contentWrapper);
      }
      
      // Position the submenu correctly with its parent navigation item
      positionSubmenu(dropdown);
    }
    
    // Function to align dropdown with navigation items
    function positionSubmenu(dropdown) {
      const menuTitle = dropdown.getAttribute('data-menu');
      const navItem = Array.from(menuItems).find(item => {
        const link = item.querySelector('a');
        if (!link) return false;
        return link.textContent.toLowerCase().trim().replace(/\s+/g, '-') === menuTitle;
      });

      if (navItem) {
        const navItemRect = navItem.getBoundingClientRect();
        const gutter = 8;
        const panelWidth = dropdown.offsetWidth || 0;
        const maxLeft = Math.max(gutter, window.innerWidth - panelWidth - gutter);
        const left = Math.min(Math.max(navItemRect.left, gutter), maxLeft);
        dropdown.style.left = left + 'px';
      }
    }

    // Cart dropdown functionality
    const desktopCartTrigger = document.querySelector('.desktop-cart-trigger');
    const mobileCartTrigger = document.querySelector('.mobile-cart-trigger');
    let isOverCart = false;

    // Delegate line-item actions so they keep working after panel refreshes.
    if (cartDropdown) {
      cartDropdown.addEventListener('click', (event) => {
        const quantityButton = event.target.closest('.quantity-adjust');
        if (quantityButton && cartDropdown.contains(quantityButton)) {
          handleQuantityAdjustment(quantityButton);
          return;
        }

        const removeButton = event.target.closest('.remove-item');
        if (removeButton && cartDropdown.contains(removeButton)) {
          removeItem(removeButton);
        }
      });
    }

    if (desktopCartTrigger && cartDropdown) {
      desktopCartTrigger.addEventListener('mouseenter', () => {
        closeCurrentDropdown();
        
        cartDropdown.classList.remove('hidden');
        currentDropdown = cartDropdown;
        headerOverlay.style.opacity = '1';
        headerOverlay.style.display = 'block';
        updateBlendMode(true);
        // Update cart content when opened
        refreshCartDropdown();
      });

      cartDropdown.addEventListener('mouseenter', () => {
        isOverDropdown = true;
        headerOverlay.style.opacity = '1';
        headerOverlay.style.display = 'block';
        updateBlendMode(true);
      });

      cartDropdown.addEventListener('mouseleave', () => {
        isOverDropdown = false;
        setTimeout(() => {
          if (!isOverHeader && currentDropdown) {
            currentDropdown.classList.add('hidden');
            currentDropdown = null;
            
            // Reset all nav items data attributes
            menuItems.forEach(menuItem => {
              menuItem.setAttribute('data-dropdown-active', 'false');
            });
            
            // Check scroll position to determine if header should be hidden
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const isAnyDropdownOpen = 
              (currentDropdown !== null && !currentDropdown.classList.contains('hidden')) || 
              (mobileMenu && mobileMenu.classList.contains('flex'));
              
            // Keep header visible if any dropdown is open
            if (isAnyDropdownOpen) {
              headerOverlay.style.opacity = '1';
              headerOverlay.style.display = 'block';
              updateBlendMode(true);
            } else if (scrollTop > 0) {
              // Hide header when scrolled and no dropdowns open
              headerOverlay.style.opacity = '0';
              headerOverlay.style.display = 'none';
              updateBlendMode(false);
            }
          }
        }, 100);
      });
    }

    if (mobileCartTrigger && cartDropdown) {
      mobileCartTrigger.addEventListener('click', () => {
        if (mobileMenu.classList.contains('flex')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
        }
        cartDropdown.classList.toggle('hidden');
        
        // Set white background for header when cart dropdown is open on mobile
        if (!cartDropdown.classList.contains('hidden')) {
          headerOverlay.style.opacity = '1';
          headerOverlay.style.display = 'block';
          
          // Check if we're on mobile
          if (window.innerWidth < 768) {
            headerOverlay.style.backgroundColor = 'white';
          }
          
          refreshCartDropdown();
        } else {
          // Reset background
          headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
        }
      });
    }

    // Initialize cart count display
    updateCartCountIndicators({{ cart.item_count }});

    // Refresh when another component reports a cart change (for example an add).
    document.addEventListener('cart:updated', function() {
      refreshCartDropdown();
      showCartTemporarily();
    });

    // Function to show cart temporarily
    let cartAutoHideTimer;
    function showCartTemporarily() {
      // Clear any existing timer
      if (cartAutoHideTimer) {
        clearTimeout(cartAutoHideTimer);
      }
      
      // Show the cart
      cartDropdown.classList.remove('hidden');
      headerOverlay.style.opacity = '1';
      headerOverlay.style.display = 'block';
      
      // Add white background on mobile
      if (window.innerWidth < 768) {
        headerOverlay.style.backgroundColor = 'white';
      }
      
      updateBlendMode(true);
      currentDropdown = cartDropdown;
      
      // Set timer to hide after 3 seconds
      cartAutoHideTimer = setTimeout(() => {
        cartDropdown.classList.add('hidden');
        currentDropdown = null;
        
        // Reset background
        headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
        
        // Check scroll position to determine if header should be hidden
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const isAnyDropdownOpen = 
          (currentDropdown !== null && !currentDropdown.classList.contains('hidden')) || 
          (mobileMenu && mobileMenu.classList.contains('flex'));
          
        // Keep header visible if any dropdown is open
        if (isAnyDropdownOpen) {
          headerOverlay.style.opacity = '1';
          headerOverlay.style.display = 'block';
          updateBlendMode(true);
        } else if (scrollTop > 0) {
          // Hide header when scrolled and no dropdowns open
          headerOverlay.style.opacity = '0';
          headerOverlay.style.display = 'none';
          updateBlendMode(false);
        }
      }, 3000);
    }
    
    // Listen for resize events to update dropdown appearances
    window.addEventListener('resize', () => {
      if (currentDropdown) {
        positionSubmenu(currentDropdown);
      }
      // Reset background color for header overlay when resizing
      if (window.innerWidth >= 768) {
        headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
      }
    });
  });

  // Function to update cart count display
  function updateCartCountIndicators(count) {
    const cartCounts = document.querySelectorAll('.cart-count');
    cartCounts.forEach(cartCount => {
      if (cartCount) {
        cartCount.textContent = count;
        if (count > 0) {
          cartCount.style.display = 'block';
        } else {
          cartCount.style.display = 'none';
        }
      }
    });
  }
  
  // Refresh the cart dropdown from its server-rendered section.
  async function refreshCartDropdown() {
    const panel = document.querySelector('.cart-dropdown');
    if (!panel) return;

    try {
      const response = await fetch('/?section_id=cart-dropdown', {
        headers: { Accept: 'text/html' }
      });
      if (!response.ok) throw new Error('Cart refresh failed');

      const text = await response.text();
      const parsed = new DOMParser().parseFromString(text, 'text/html');
      const freshPanel = parsed.querySelector('.cart-dropdown');
      if (!freshPanel) throw new Error('Cart panel missing from response');

      panel.innerHTML = freshPanel.innerHTML;

      const count = freshPanel.getAttribute('data-cart-item-count') || '0';
      panel.setAttribute('data-cart-item-count', count);
      updateCartCountIndicators(parseInt(count, 10));
    } catch (error) {
      console.error('Error refreshing cart:', error);
    }
  }
  
  // Handle quantity adjustment
  async function handleQuantityAdjustment(button) {
    const variantId = button.dataset.variantId;
    const action = button.dataset.action;
    const item = button.closest('.cart-item');
    const quantityDisplay = item.querySelector('.quantity-value');
    let currentQuantity = parseInt(quantityDisplay.textContent);
    
    // Calculate the new quantity
    let newQuantity = currentQuantity;
    if (action === 'increase') {
      newQuantity = currentQuantity + 1;
    } else if (action === 'decrease') {
      newQuantity = currentQuantity - 1;
    }
    
    // If quantity would be zero, remove the item
    if (newQuantity <= 0) {
      await updateCartItemQuantity(variantId, 0);
      return;
    }
    
    // Otherwise update the quantity
    await updateCartItemQuantity(variantId, newQuantity);
  }
  
  // Function to update cart item quantity
  async function updateCartItemQuantity(variantId, quantity) {
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity
        })
      });

      if (!response.ok) throw new Error('Update item quantity failed');
      
      // Fetch and update cart after successful quantity change
      refreshCartDropdown();
      
    } catch (error) {
      console.error('Error updating quantity:', error);
    }
  }

  // Update the removeItem function to use updateCartItemQuantity
  async function removeItem(button) {
    const variantId = button.dataset.variantId;
    await updateCartItemQuantity(variantId, 0);
  }

  function formatMoney(cents) {
    return (cents / 100).toLocaleString('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    });
  }
</script>
