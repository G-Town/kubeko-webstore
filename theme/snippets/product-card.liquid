{% assign first_variant = product.first_available_variant %}
{% comment %} {% assign first_image = first_variant.featured_image %} {% endcomment %}
{% assign first_image = product.featured_image %}
{% assign second_image = product.images[1] %}

{%- assign card_sizes = image_sizes | default: "(max-width: 767px) 50vw, (max-width: 1536px) 20vw, 300px" -%}

{%- assign unique_id = product.id -%}

<script>
  // Product Card namespace to avoid global conflicts
  window.ProductCardObject = window.ProductCard || {
    // Cache for product data to avoid re-parsing JSON
    productDataCache: {},

    buildImageUrl: function(baseUrl, width) {
      if (!baseUrl) return '';
      
      // Remove any existing size suffix
      let url = baseUrl.replace(/_\d+x\d*\./, '.');
      
      // Add width parameter before file extension
      url = url.replace(/(\.(jpg|jpeg|png|gif|webp))(\?|$)/i, `_${width}x$1$3`);
      
      return url;
    },

    buildSrcset: function(baseUrl) {
      const widths = [400, 600, 900, 1200];
      return widths.map(w => 
        `${this.buildImageUrl(baseUrl, w)} ${w}w`
      ).join(', ');
    },

    getImagesForVariant: function(variant, allImages) {
      if (!variant.featured_image || !allImages.length) return [];

      // console.log("getImagesForVariant ~ featured image src: ", variant.featured_image.src)
      // const normalize = url => url ? url.replace(/^https?:/, '') : '';
      // const featuredSrc = normalize(variant.featured_image.src);
      // console.log("getImagesForVariant ~ normalized url: ", featuredSrc)
      // const startIndex = allImages.findIndex(imgUrl => 
      //   normalize(imgUrl).includes(featuredSrc)
      // );

      featuredSrc = variant.featured_image.src;
      startIndex = allImages.findIndex(imgUrl => imgUrl.includes(featuredSrc));
      
      if (startIndex === -1) return [];

      const result = [allImages[startIndex]];
      if (startIndex + 1 < allImages.length) {
        result.push(allImages[startIndex + 1]);
      }

      return result;
    },

    updateCardImages: function (productId, images) {
      const productCardElement = document.querySelector(`[data-product-card="${productId}"]`);
      if (!productCardElement) return;

      const mainImage = productCardElement.querySelector(`#primary-image-${productId}`);
      const secondaryImage = productCardElement.querySelector(`#secondary-image-${productId}`);

      // Update primary image
      if (mainImage && images[0]) {
        // mainImage.srcset = `
        //   ${images[0].replace(/(\.[a-z]+)$/i, '_900x$1')} 900w,
        //   ${images[0].replace(/(\.[a-z]+)$/i, '_1200x$1')} 1200w
        // `;
        mainImage.srcset = this.buildSrcset(images[0]);
        mainImage.sizes = "{{ card_sizes }}";
      }

      // Update secondary image
      if (secondaryImage && images[1]) {
        // secondaryImage.srcset = `
        //   ${images[1].replace(/(\.[a-z]+)$/i, '_900x$1')} 900w,
        //   ${images[1].replace(/(\.[a-z]+)$/i, '_1200x$1')} 1200w
        // `;
        secondaryImage.srcset = this.buildSrcset(images[1]);
        secondaryImage.sizes = "{{ card_sizes }}";
      }

      // Update mobile toggle thumbnails
      const toggleButton = productCardElement.querySelector(`#thumbnail-toggle-${productId}`);
      if (toggleButton) {
        // Store thumbnail-sized URLs (120w for mobile thumbnail)
        toggleButton.dataset.primaryImage = this.buildImageUrl(images[0], 120 );
        toggleButton.dataset.secondaryImage = this.buildImageUrl(images[1], 120 );

        const thumbContainer = productCardElement.querySelector(`#thumb-container-${productId}`);
        if (thumbContainer && images[1]) {
          const thumbImg = thumbContainer.querySelector('img');
          if (thumbImg) {
            // Just update the src on existing img
            thumbImg.src = this.buildImageUrl(images[1], 120 );
            thumbImg.alt = "Alternate view";
          } else {
            // thumbContainer.innerHTML = `
            //   <img
            //     src="${images[1].replace(/(\.[a-z]+)$/i, '_120x$1')}"
            //     alt="Alternate view"
            //     class="w-full h-auto object-contain block"
            //     loading="eager"
            //   >
            // `;
          }
        }
      }
    },
    
    // Function to toggle product images on mobile
    toggleProductImages: function(thumbnailButton, event, productId) {
      // Prevent default actions
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      
      // Get elements
      const productCardElement = thumbnailButton.closest('.group');
      if (!productCardElement) return;
      
      // Get all needed elements
      const activeThumbContainer = document.getElementById(`thumb-container-${productId}`);
      if (!activeThumbContainer) return;
      const primaryImageUrl = thumbnailButton.dataset.primaryImage;
      const secondaryImageUrl = thumbnailButton.dataset.secondaryImage;
      const mainImage = document.getElementById(`primary-image-${productId}`);
      const secondaryImage = document.getElementById(`secondary-image-${productId}`);
      if (!mainImage || !secondaryImage) return;

      // Lazily create the thumbnail image ONCE
      let thumbImg = activeThumbContainer.querySelector('img');
      if (!thumbImg) {
        thumbImg = document.createElement('img');
        thumbImg.className = 'w-full h-full object-contain block';
        thumbImg.loading = 'lazy';
        thumbImg.alt = 'Alternate view';
        activeThumbContainer.appendChild(thumbImg);
      }

      // Toggle state
      productCardElement.classList.toggle('images-toggled');
      const isShowingSecondary = productCardElement.classList.contains('images-toggled');

      // Swap thumbnail src ONLY
      if (isShowingSecondary) {
        thumbImg.src = primaryImageUrl;
        thumbImg.alt = 'Primary view';
      } else {
        thumbImg.src = secondaryImageUrl;
        thumbImg.alt = 'Alternate view';
      }

      // if (isShowingSecondary) {
      //   activeThumbContainer.innerHTML = `<img 
      //     src="${primaryImageUrl}" 
      //     alt="Primary view" 
      //     class="w-full h-auto object-contain block"
      //     loading="eager"
      //     id="thumb-active-${productId}"
      //     style="display: block; margin: 0;"
      //   >`;
      // } else {
      //   activeThumbContainer.innerHTML = `<img 
      //     src="${secondaryImageUrl}" 
      //     alt="Alternate view" 
      //     class="w-full h-auto object-contain block"
      //     loading="eager"
      //     id="thumb-active-${productId}"
      //     style="display: block; margin: 0;"
      //   >`;
      // }

      // Handle main image switching (this part stays the same)
      mainImage.style.transition = "none";
      secondaryImage.style.transition = "none";
      
      if (isShowingSecondary) {
        mainImage.style.opacity = '0';
        mainImage.style.zIndex = '1';
        secondaryImage.style.opacity = '1';
        secondaryImage.style.zIndex = '2';
      } else {
        mainImage.style.opacity = '1';
        mainImage.style.zIndex = '2';
        secondaryImage.style.opacity = '0';
        secondaryImage.style.zIndex = '1';
      }
    },

    handleProductCardClick: function(event, productId) {
      console.log("🔴 CLICKED ELEMENT:", event.target);
      console.log("🔴 CLICKED ELEMENT TAG:", event.target.tagName);
      console.log("🔴 CLICKED ELEMENT CLASSES:", event.target.className);

      // event.preventDefault();
      // event.stopPropagation();

      if (!event) return;

      // const productCard = event.currentTarget.closest('.group');
      // if (!productCard) return;
      const productLink = event.target.closest('.product-card-link');
      if (!productLink) return;
      const productCard = productLink.closest('.group');
      if (!productCard) return;

      // console.log("test")

      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      // const productLink = productCard.querySelector('a[href]');
      const thumbnailToggle = productCard.querySelector('.product-thumbnail-toggle');
      const thumbContainer = document.getElementById(`thumb-container-${productId}`);

      /*
        DESKTOP BEHAVIOR
        - Always navigate
      */
      if (!isMobile) {
        return;
      }


      // Determine current state
      const isExpanded = productCard.classList.contains('mobile-expanded');

      /*
        MOBILE — FIRST TAP
        - Expand card
        - Prevent navigation
        - Reveal thumbnail toggle
        - Lazily create thumbnail image
      */
      if (!isExpanded) {
        event.preventDefault();
        // event.stopPropagation();

        document.querySelectorAll('.mobile-expanded').forEach(card => {
        if (card !== productCard) {
          card.classList.remove('mobile-expanded');
          
          const cardId = card.getAttribute('data-product-card');
          const thumbToggle = document.getElementById(`thumbnail-toggle-${cardId}`);
          if (thumbToggle) {
            thumbToggle.classList.add('mobile-hidden');
          }
        }
      });

        productCard.classList.add('mobile-expanded');

        if (thumbnailToggle) {
          thumbnailToggle.classList.remove('mobile-hidden');
        }

        // Lazily create thumbnail image ONCE on expansion
        if (thumbContainer && thumbnailToggle && !thumbContainer.querySelector('img')) {
          const secondaryImageUrl = thumbnailToggle.dataset.secondaryImage;

          if (secondaryImageUrl) {
            const img = document.createElement('img');
            img.className = 'w-full h-full object-contain block';
            img.loading = 'lazy';
            img.alt = 'Alternate view';
            img.src = secondaryImageUrl;

            thumbContainer.appendChild(img);
          }
        }

        return;
      }

      /*
        MOBILE — SECOND TAP
        - Allow normal navigation to PDP
      */
      if (productLink) {
        window.location.href = productLink.href;
      }
    },
    
    // Get product data from cache or parse JSON
    getProductData: function(productId, element) {
      // If we already have it cached, return it
      if (this.productDataCache[productId]) {
        return this.productDataCache[productId];
      }
      
      // Get the product card - use provided element to find the closest card if possible
      let productCardElement;
      if (element) {
        productCardElement = element.closest(`[data-product-card="${productId}"]`);
      }
      
      // Fallback to document query if we couldn't find it from the element
      if (!productCardElement) {
        productCardElement = document.querySelector(`[data-product-card="${productId}"]`);
      }
      
      if (!productCardElement) {
        console.error('Could not find product card with ID:', productId);
        return null;
      }
      
      // Get the product data element
      const productDataElem = productCardElement.querySelector('[data-product-json]');
      if (!productDataElem) {
        console.error('Could not find product data element for product ID:', productId);
        return null;
      }
      
      try {
        // Parse the product data
        const productData = JSON.parse(productDataElem.getAttribute('data-product-json'));
        
        // Cache it for future use
        this.productDataCache[productId] = productData;
        
        return productData;
      } catch (error) {
        console.error('Error parsing product data for product ID:', productId, error);
        return null;
      }
    },
    
    // Function to handle variant selection
    selectVariant: function(button, productId, optionPosition, optionValue) {
      console.log(`Selecting variant for product ${productId}: option ${optionPosition} = ${optionValue}`);
      
      // Get the product card - use button.closest() to ensure we're in the right card
      const productCardElement = button.closest(`[data-product-card="${productId}"]`);
      if (!productCardElement) {
        console.error('Could not find product card with ID:', productId);
        return;
      }
      
      // Get the product data - pass the button for context
      const productData = this.getProductData(productId, button);
      if (!productData) return;
      
      // Clear previous selection for this option group - scoped to this product card
      productCardElement.querySelectorAll(`.variant-button[data-option-position="${optionPosition}"]`).forEach(btn => {
        btn.classList.remove('selected');
        // btn.classList.remove('bg-[#D9D9D9]');
      });
      
      // Mark this button as selected
      button.classList.add('selected');
      // button.classList.add('bg-[#D9D9D9]');
      
      // Get all current selections for this product - scoped to this product card
      const selections = {};
      productCardElement.querySelectorAll(`.variant-button.selected`).forEach(selectedBtn => {
        const pos = selectedBtn.getAttribute('data-option-position');
        const val = selectedBtn.getAttribute('data-value');
        selections[`option${pos}`] = val;
      });
      
      console.log(`Current selections for product ${productId}:`, selections);
      
      // Check if all options are selected
      const totalOptions = productData.options.length;
      const allSelected = Object.keys(selections).length === totalOptions;

      // Always update images when a color is selected, even if other options aren't
      if (optionPosition === 1 && optionValue) {
        const colorVariant = productData.variants.find(v => v.option1 === optionValue);
        if (colorVariant) {
          const variantImages = this.getImagesForVariant(colorVariant, productData.images);
          console.log("🚀 ~ variantImages:", variantImages)
          this.updateCardImages(productId, variantImages);
        }
      }
      
      // Find matching variant
      let matchingVariant = null;
      if (allSelected) {
        // Try to find exact match
        matchingVariant = productData.variants.find(variant => {
          return Object.keys(selections).every(optionKey => {
            const match = variant[optionKey] === selections[optionKey];
            console.log(`Comparing ${optionKey}: ${variant[optionKey]} vs ${selections[optionKey]} = ${match}`);
            return match;
          });
        });
        
        if (matchingVariant) {
          console.log(`Found matching variant for product ${productId}:`, matchingVariant.id);
        } else {
          console.log(`No matching variant found for product ${productId} with selections:`, selections);
        }
      }
      
      if (matchingVariant) {
        // const variantImages = this.getImagesForVariant(matchingVariant, productData.images);
        // this.updateCardImages(productId, variantImages);


        // Update variant input
        const variantInput = productCardElement.querySelector(`input[name="id"]`);
        
        if (variantInput) {
          variantInput.value = matchingVariant.id;
          variantInput.setAttribute('data-selected-variant', matchingVariant.id);
          console.log(`Updated variant input to: ${matchingVariant.id}`);
          
          // Force trigger a change event to ensure any listeners are notified
          const event = new Event('change', { bubbles: true });
          variantInput.dispatchEvent(event);
        } else {
          console.warn(`Could not find variant input for product ${productId}`);
        }
        
        // Update the add to cart button state based on inventory
        const addButton = productCardElement.querySelector('.add-to-cart-button');
        if (addButton) {
          // Check if the variant is available (has inventory)
          const isAvailable = matchingVariant.available;
          const inventory = matchingVariant.inventory_quantity;
          const inventoryPolicy = matchingVariant.inventory_policy;
          
          console.log(`Variant inventory for ${matchingVariant.id}: ${inventory}, Policy: ${inventoryPolicy}, Available: ${isAvailable}`);
          
          if (isAvailable) {
            // Variant is in stock
            addButton.disabled = false;
            addButton.classList.add('active');
            addButton.classList.remove('out-of-stock');
            addButton.textContent = 'ADD TO CART';
            
            // Add inventory indicator if inventory tracking is enabled and quantity is shown
            if (inventory > 0 && inventory <= 10) {
              const inventoryIndicator = productCardElement.querySelector('.inventory-indicator') || document.createElement('div');
              inventoryIndicator.className = 'inventory-indicator text-xs mt-1';
              inventoryIndicator.textContent = `Only ${inventory} left`;
              
              // Add the indicator below the add to cart button if it doesn't exist
              if (!productCardElement.querySelector('.inventory-indicator')) {
                addButton.parentNode.appendChild(inventoryIndicator);
              }
            } else {
              // Remove inventory indicator if quantity is high or not relevant
              const inventoryIndicator = productCardElement.querySelector('.inventory-indicator');
              if (inventoryIndicator) {
                inventoryIndicator.remove();
              }
            }
            
            console.log(`Enabled add to cart button for product ${productId}`);
          } else {
            // Variant is out of stock
            addButton.disabled = true;
            addButton.classList.remove('active');
            addButton.classList.add('out-of-stock');
            addButton.textContent = 'OUT OF STOCK';
            
            // Remove any existing inventory indicator
            const inventoryIndicator = productCardElement.querySelector('.inventory-indicator');
            if (inventoryIndicator) {
              inventoryIndicator.remove();
            }
            
            console.log(`Variant out of stock for product ${productId}`);
          }
        }
      } else {
        // Update the button states to disabled if no matching variant
        productCardElement.querySelectorAll(`.add-to-cart-button`).forEach(btn => {
          if (!productData.has_only_default_variant) {
            btn.disabled = true;
            btn.classList.remove('active');
            
            // Only show "OUT OF STOCK" if all required options are selected
            // but the specific combination is unavailable
            if (Object.keys(selections).length === totalOptions) {
              btn.classList.add('out-of-stock');
              btn.textContent = 'OUT OF STOCK';
            } else {
              btn.classList.remove('out-of-stock');
              btn.textContent = 'ADD TO CART';
            }
            
            console.log(`Disabled add to cart button for product ${productId}`);
            
            // Remove any existing inventory indicator
            const inventoryIndicator = productCardElement.querySelector('.inventory-indicator');
            if (inventoryIndicator) {
              inventoryIndicator.remove();
            }
          }
        });
      }
    },
    
    // Direct add to cart function that ensures the proper variant ID is used
    addToCart: function(button, productId) {
      console.log(`Adding product ${productId} to cart`);
      
      // Get the form containing the button
      const form = button.closest('form[action="/cart/add"]');
      if (!form) {
        console.error('No form found for add to cart button');
        return false;
      }
      
      // Get the variant ID input
      const variantInput = form.querySelector('input[name="id"]');
      if (!variantInput || !variantInput.value) {
        console.error('No variant ID found in form');
        return false;
      }
      
      // Store original text and class state
      const originalText = button.textContent;
      const wasActive = button.classList.contains('active');
      
      // Get form data and submit with fetch
      const formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      })
      .then(result => {
        // Update cart count
        return fetch('/cart.js');
      })
      .then(response => response.json())
      .then(cart => {
        // Update the cart count display
        const cartCount = document.querySelector('.cart-count');
        if (cartCount) {
          cartCount.textContent = cart.item_count;
          cartCount.style.display = cart.item_count > 0 ? 'block' : 'none';
        }
        
        // Show success state
        button.textContent = 'Added';
        button.classList.remove('active'); // Remove potentially conflicting classes
        button.classList.add('success');
        
        // Reset button after 2 seconds
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('success');
          // Re-add active class if it was active before
          if (wasActive) {
            button.classList.add('active');
          }
        }, 2000);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        button.textContent = 'Error';
        button.classList.remove('active');
        button.classList.add('error');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('error');
          // Re-add active class if it was active before
          if (wasActive) {
            button.classList.add('active');
          }
        }, 2000);
      });
      
      return false; // Prevent default form submission
    },

    initPage() {
      // Run once per page
      document.querySelectorAll('[data-product-card]').forEach(card => {
        this.initCard(card);
      });
    },

    initCard(card) {
      const productId = card.getAttribute('data-product-card');
      const productData = this.getProductData(productId, card);

      if (!productData) return;

      // 1. Pre-select first available variant
      const defaultVariant = productData.variants.find(v => v.available) || productData.variants[0];

      if (defaultVariant) {
        const variantImages = this.getImagesForVariant(defaultVariant, productData.images);
        this.updateCardImages(productId, variantImages);
      }

      // 2. Handle has_only_default_variant edge case TODO: refactor to own method
      if (productData.has_only_default_variant) {
        const forms = card.querySelectorAll(`form[data-product-form="${productId}"]`);
          forms.forEach(form => {
            const addButton = form.querySelector('.add-to-cart-button');
            if (addButton) {
              // Check if the default variant is available
              const defaultVariant = productData.variants[0];
              if (defaultVariant && defaultVariant.available) {
                addButton.disabled = false;
                addButton.classList.add('active');
                
                // Show inventory if quantity is low
                if (defaultVariant.inventory_quantity <= 10 && 
                    defaultVariant.inventory_quantity > 0 && 
                    defaultVariant.inventory_management === 'shopify') {
                  const inventoryIndicator = document.createElement('div');
                  inventoryIndicator.className = 'inventory-indicator text-xs mt-1';
                  inventoryIndicator.textContent = `Only ${defaultVariant.inventory_quantity} left`;
                  addButton.parentNode.appendChild(inventoryIndicator);
                }
              } else {
                // Default variant is out of stock
                addButton.disabled = true;
                addButton.classList.add('out-of-stock');
                addButton.textContent = 'OUT OF STOCK';
              }
            }
          });
      }
    },
    
    // Empty placeholder for checkCardVisibility (overridden to do nothing on mobile)
    checkCardVisibility: function() {
      // This is intentionally empty for mobile - we only want click behavior
      return;
    }


  };

  // Make ProductCardObject globally available immediately
  // window.ProductCardObject = ProductCardObject;
  // window.loadHighResImage = ProductCardObject.loadHighResImage;
  window.toggleProductImages = ProductCardObject.toggleProductImages;
  window.handleProductCardClick = ProductCardObject.handleProductCardClick.bind(ProductCardObject);


  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    ProductCardObject.initPage();

    console.log("Setting up event delegation...");
    // Handle product card clicks with delegation
    // document.addEventListener('click', function(event) {
    //   console.log("Document click detected, target:", event.target);

    //   const productLink = event.target.closest('.product-card-link');
    //   console.log("Product link from delegation:", productLink);

    //   if (productLink) {
    //     const productId = productLink.dataset.productId;
    //     console.log("Calling handleProductCardClick with ID:", productId);
    //     ProductCardObject.handleProductCardClick(event, productId);
    //   }
    // }, true); // ← Add 'true' for capture phase

    // Remove all viewport-based classes on initialization
    document.querySelectorAll('.group').forEach(card => {
      card.classList.remove('card-visible');
      card.classList.remove('card-visible-delayed');
    });
    
    // Function to normalize variant button sizes within a product card
    function normalizeVariantButtonSizes() {
      // Process each product card separately
      document.querySelectorAll('[data-product-card]').forEach(card => {
        // Find the maximum width for color variants
        let maxColorWidth = 0;
        card.querySelectorAll('.color-variant').forEach(btn => {
          // Temporarily remove inline styles for accurate measurement
          const originalStyles = btn.getAttribute('style');
          btn.removeAttribute('style');
          const width = btn.offsetWidth;
          if (width > maxColorWidth) maxColorWidth = width;
          // Restore original styles
          if (originalStyles) btn.setAttribute('style', originalStyles);
        });
        
        // Find the maximum width for size variants
        let maxSizeWidth = 0;
        card.querySelectorAll('.size-variant').forEach(btn => {
          // Temporarily remove inline styles for accurate measurement
          const originalStyles = btn.getAttribute('style');
          btn.removeAttribute('style');
          const width = btn.offsetWidth;
          if (width > maxSizeWidth) maxSizeWidth = width;
          // Restore original styles
          if (originalStyles) btn.setAttribute('style', originalStyles);
        });
        
        // Apply the max widths to all buttons in each column
        if (maxColorWidth > 0) {
          card.querySelectorAll('.color-variant').forEach(btn => {
            btn.style.width = maxColorWidth + 'px';
          });
        }
        
        if (maxSizeWidth > 0) {
          card.querySelectorAll('.size-variant').forEach(btn => {
            btn.style.width = maxSizeWidth + 'px';
          });
        }
      });
    }
    
    // Run the normalization after a small delay to ensure DOM is fully rendered
    setTimeout(normalizeVariantButtonSizes, 100);
    
    // Add a click handler to close expanded cards when clicking outside
    document.addEventListener('click', function(event) {
      // Only on mobile
      if (window.innerWidth >= 767) {
        console.log("🟡 Desktop - skipping");
        return;
      }

      console.log("🟡 is mobile");
      
      // Get all expanded cards
      const expandedCards = document.querySelectorAll('.mobile-expanded');
      if (expandedCards.length === 0) return;
      
      // Check if the click was outside of any expanded card
      let clickedOutside = true;
      for (const card of expandedCards) {
        if (card.contains(event.target)) {
          clickedOutside = false;
          break;
        }
      }

      console.log("🟡 Clicked outside?", clickedOutside);
      
      // If clicked outside, collapse all expanded cards
      if (clickedOutside) {
        expandedCards.forEach(card => {
          console.log("🟡 Collapsing all cards");
          card.classList.remove('mobile-expanded');
          
          // Hide the thumbnail toggle
          const productId = card.getAttribute('data-product-card');
          const thumbnailToggle = document.getElementById(`thumbnail-toggle-${productId}`);
          if (thumbnailToggle) {
            thumbnailToggle.classList.add('mobile-hidden');
          }
          
          // Hide the dropdown
          const dropdown = card.querySelector('.product-dropdown');
          if (dropdown) {
            dropdown.classList.remove('mobile-dropdown-visible');
            dropdown.classList.add('mobile-dropdown-hidden');
          }
        });
      }
    });

    // Modify the selectVariant function to update button styles
    const originalSelectVariant = ProductCardObject.selectVariant;
    ProductCardObject.selectVariant = function(button, productId, optionPosition, optionValue) {
      // Call the original function first
      originalSelectVariant.call(this, button, productId, optionPosition, optionValue);
      
      // Get the product card
      const productCardElement = button.closest(`[data-product-card="${productId}"]`);
      if (!productCardElement) return;
      
      // Get all selected buttons to ensure they keep their styles
      const allSelectedButtons = productCardElement.querySelectorAll('.variant-button.selected');
      allSelectedButtons.forEach(btn => {
        // Make sure selected buttons maintain their style
        btn.style.backgroundColor = 'rgba(217, 217, 217, 0.9)';
        btn.style.color = 'black';
        btn.style.fontWeight = '500';
      });
      
      // Clear any inline styles from non-selected buttons to allow hover effects
      const allNonSelectedButtons = productCardElement.querySelectorAll('.variant-button:not(.selected)');
      allNonSelectedButtons.forEach(btn => {
        btn.style.backgroundColor = '';
        btn.style.color = '';
        btn.style.fontWeight = '';
      });
    };

    // New click handler for product card color chips
    document.addEventListener('click', function(event) {
      const chip = event.target.closest('.color-chip');
      if (!chip) {
        return; // Not a chip click, ignore
      }

      // We are inside a product card and clicked a color chip.
      event.stopPropagation(); // Prevent other click handlers on the card.

      const productCardElement = chip.closest('[data-product-card]');
      // const productCardElement = event.target.closest('[data-product-card]');
      if (!productCardElement) return;

      productCardElement.querySelectorAll('.color-chip-container').forEach(c => c.classList.remove('active'));
      chip.closest('.color-chip-container').classList.add('active');

      // Handle active state
      // const allChipContainers = productCardElement.querySelectorAll('.color-chip-container');
      // allChipContainers.forEach(container => container.classList.remove('active'));
      // chip.closest('.color-chip-container').classList.add('active');
    });

  });
</script>

<div class="group relative flex flex-col text-black
            {% if custom_aspect_ratio %}h-full{% endif %} overflow-visible "
      data-product-card="{{ unique_id }}">
  <!-- Hidden product data for JavaScript -->
  <div class="hidden"
        data-product-json=
          '{"id":{{ product.id }},
          "variants":{{ product.variants | json }},
          "images":{{ product.images | json }},
          "options":{{ product.options_with_values | json }},
          "has_only_default_variant":{{ product.has_only_default_variant | json }}}'>
  </div>

  <!-- Product link (image only) -->
  <a href="{{ product.url }}"
      class="block relative w-full overflow-hidden product-card-link
            {% if custom_aspect_ratio %}flex-grow{% endif %}"
      style="aspect-ratio: 4 / 5;"
      id="product-link-{{ product.id }}"
      onclick="handleProductCardClick(event, '{{ product.id }}')">
    <img
      id="primary-image-{{ product.id }}"
      class="relative h-full w-auto mx-auto object-contain md:group-hover:opacity-0"
      alt="{{ product.title }}"
      src="{{ first_image | image_url: width: 400 }}"
      srcset="
        {{ first_image | image_url: width: 400 }} 400w,
        {{ first_image | image_url: width: 600 }} 600w,
        {{ first_image | image_url: width: 900 }} 900w,
        {{ first_image | image_url: width: 1200 }} 1200w,
      "
      sizes="{{ card_sizes }}"
      loading="eager"
    >
    <img
      id="secondary-image-{{ product.id }}"
      class="absolute inset-0 h-full w-auto mx-auto object-contain opacity-0 md:group-hover:opacity-100"
      alt="{{ product.title }}"
      src="{{ second_image | image_url: width: 400 }}"
      srcset="
        {{ second_image | image_url: width: 400 }} 400w,
        {{ second_image | image_url: width: 600 }} 600w,
        {{ second_image | image_url: width: 800 }} 800w,
        {{ second_image | image_url: width: 1200 }} 1200w,
      "
      sizes="{{ card_sizes }}"
      loading="eager"
    >
  </a>
  
  <!-- Secondary image thumbnail (mobile only) -->
  <button 
    class="absolute top-0 right-0 w-auto h-auto z-20 overflow-hidden md:hidden product-thumbnail-toggle mobile-hidden" 
    onclick="toggleProductImages(this, event, '{{ product.id }}')"
    data-primary-image="{{ first_image | image_url: width: 120 }}"
    data-secondary-image="{{ second_image | image_url: width: 120 }}"
    style="padding: 0; margin: 0; line-height: 0; top: 20px; right: 0; border: none; background: none;"
    id="thumbnail-toggle-{{ product.id }}">
    <!-- Container for the active thumbnail image -->
    <div id="thumb-container-{{ product.id }}">
      {% comment %} <img 
        src="{{ second_image | image_url: width: 120 }}"
        alt="{{ product.title }} (alternate)" 
        class="w-full h-auto object-contain block"
        loading="eager"
        width="{{ second_image.width | default: 120 }}"
        height="{{ second_image.height | default: 120 }}"
        id="thumb-active-{{ product.id }}"
        style="display: block; margin: 0;"
      > {% endcomment %}
    </div>
  </button>

  {% comment %} TODO: remove all remaining code pertaining to add to cart button, which was removed {% endcomment %}
  <!-- Product info and dropdown container -->
  <div class="relative z-10">
    <!-- Product info bar (always visible) -->
    {% comment %} TODO: edit height (was 49px) {% endcomment %}
    <div class="product-info-bar relative rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] px-4 py-3">

      <!-- Row 1: Title and Price -->
      <div class="flex justify-between items-center mb-1">
        <a href="{{ product.url }}" class="uppercase text-xs text-black tracking-wide">{{ product.title }}</a>
        <div class="text-xs text-black">
          {% if product.available %}
            {{ product.price | money_without_trailing_zeros }}
            {% comment %} {% if product.inventory_quantity <= 10 and product.inventory_quantity > 0 and product.inventory_management == 'shopify' %}
              <span class="stock-status in-stock text-sm ml-2">({{ product.inventory_quantity }} left)</span>
            {% endif %} {% endcomment %}
          {% else %}
            <span class="stock-status out-of-stock">Sold Out</span>
          {% endif %}
        </div>
      </div>
      <!-- Row 2: Color Chips -->
      <div class="flex items-center gap-1 pt-2">
        {%- for option in product.options_with_values -%} <!--  -->
          {%- if option.name == 'Color' -%}
            {%- for value in option.values -%} <!-- COLOR OPTION NAMES eg. Mustard, Carbon/Stripe etc. --> 
            {%- assign variant_for_color = null -%}
              {%- for variant in product.variants -%} <!-- ALL PRODUCT VARIANT TITLES eg. Mustard1, Mustard2 etc. -->
                {%- if variant.options contains value -%} <!-- variant title will contain color name, usually 1st variant category -->
                  {%- assign variant_for_color = variant -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if variant_for_color  -%}
                {%- assign is_selected = false -%}

                {%- comment -%} Check if the currently selected variant has the same color as this chip {%- endcomment -%}
                {%- if product.selected_or_first_available_variant.options contains value -%}
                  {%- assign is_selected = true -%}
                {%- endif -%}

                {%- assign has_image = variant_for_color.featured_image -%}
                {%- assign color_obj = shop.metaobjects['shopify--color-pattern'][value] -%}
                {% assign pattern_image = color_obj.image %}
                {% if pattern_image %}
                  {% assign swatch_img = pattern_image | image_url: width: 30 %}
                {% endif %}

                <div class="color-chip-container{% if is_selected %} active{% endif %}{% unless has_image %} disabled{% endunless %}">
                  <button
                    type="button"
                    class="color-chip"
                    {% comment %} style="background-color: {{ value.swatch.color }};{% unless has_image %}opacity: 0.5;{% endunless %}" {% endcomment %}
                    style="
                                      {% if pattern_image %}
                                        background-image: url('{{ swatch_img | image_url: '30x30' }}');
                                        background-size: cover;
                                        background-position: center;
                                      {% else %}
                                        background-color: {{ value.swatch.color }};
                                      {% endif %}
                                    "
                    data-color-name="{{ value | escape }}"
                    data-option-position="1" 
                    data-value="{{ value }}"
                    {% if has_image  %}
                      onclick="ProductCardObject.selectVariant(this, '{{ product.id }}', 1, '{{ value }}')"
                      aria-disabled="false"
                    {% else %}
                      disabled aria-disabled="true"
                    {% endif %}
                    aria-label="Select color {{ value | escape }}"
                  ></button>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

