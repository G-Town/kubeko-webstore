      }

      _replaceMobileImage(el, url, preloadWidth = 400) {
        this._replaceRightImage(el, url, { preloadWidth });
      }

      _syncMobileGallery(urls = []) {
        const container = document.getElementById('mobile-gallery-container');
        if (!container) return;

        // Collect existing slides, but KEEP index 0 (mobile-hero)
        const slides = Array.from(container.querySelectorAll('.mobile-gallery-slide'));

        const needed = urls.length;

        // Existing: slides.length
        // Desired: needed

        // Add missing slides
        for (let i = slides.length; i < needed; i++) {
          const url = urls[i];

          const slide = document.createElement('div');
          slide.className = "w-full h-full flex-shrink-0 snap-center mobile-gallery-slide relative";

          const img = document.createElement('img');
          img.className = "w-full h-full object-contain";
          img.loading = "lazy";
          img.decoding = "async";
          img.src = this._buildSizedUrl(url, 400);

          slide.appendChild(img);
          container.appendChild(slide);
        }

        // Remove extra slides
        if (slides.length > needed) {
          for (let i = needed; i < slides.length; i++) {
            slides[i].remove();
          }
        }
      }
    }

    /* ===========================
      Revised selectVariant
      - quick guards
      - immediate image load for color-only selection (uses first variant with that color)
      =========================== */
    function selectVariant(element, optionPosition, optionValue) {
      if (!element) return;

      // Ignore disabled or aria-disabled
      if (element.disabled || element.getAttribute('aria-disabled') === 'true' || element.dataset.hasImage === 'false') return;

      // Don't re-select active
      if (element.closest('.color-chip-container')?.classList.contains('active')) return;

      // Clear previous selection for this option group
      const selectableItems = document.querySelectorAll(
        `.variant-button[data-option-position="${optionPosition}"], .color-chip[data-option-position="${optionPosition}"]`
      );
      selectableItems.forEach(item => {
        item.removeAttribute('data-selected');
        item.classList.remove('bg-[#D9D9D9]');
      });

      // Mark clicked
      element.setAttribute('data-selected', 'true');
      if (element.classList.contains('variant-button') && !element.classList.contains('color-chip')) {
        element.classList.add('bg-[#D9D9D9]');
      }

      // Build selections map
      const selections = {};
      document.querySelectorAll('.variant-button[data-selected="true"], .color-chip[data-selected="true"]').forEach(selectedItem => {
        const pos = selectedItem.getAttribute('data-option-position');
        const val = selectedItem.getAttribute('data-value');
        selections[`option${pos}`] = val;
      });

      const totalOptionTypes = {{ product.options | size }};
      const allOptionsSelected = Object.keys(selections).length === totalOptionTypes;

      const variants = window.productVariants || [];

      // When a Color (optionPosition === "1") is clicked: show images for that color immediately
      if (optionPosition === "1") {
        const colorValue = optionValue;
        // find first variant with that color that has a featured image (prefer available)
        let colorVariant = variants.find(v => v.option1 === colorValue && v.featured_image && v.available) ||
                          variants.find(v => v.option1 === colorValue && v.featured_image) ||
                          variants.find(v => v.option1 === colorValue);

        if (colorVariant && window.productImageManager) {
          window.productImageManager.loadVariant(colorVariant);
        }

        // Collect available sizes for this color
        const availableSizes = variants
          .filter(v => v.option1 === colorValue && v.available)
          .map(v => v.option2);

        // 1. If no sizes are available, disable ATC immediately
        if (availableSizes.length === 0) {
          updateAddToCartButtons(false, null, true);
        }

        // 2. Update size buttons availability
        const sizeButtons = document.querySelectorAll(
          '.variant-button[data-option-position="2"]'
        );

        sizeButtons.forEach(btn => {
          const sizeValue = btn.getAttribute("data-value");

          if (!availableSizes.includes(sizeValue)) {
            btn.disabled = true;
            btn.classList.add("opacity-50");
          } else {
            btn.disabled = false;
            btn.classList.remove("opacity-50");
          }
        });
      }

      // Determine full matching variant only if all options are selected
      let matchingVariant = null;
      if (allOptionsSelected) {
        matchingVariant = variants.find(variant => {
          return Object.keys(selections).every(option => {
            const position = parseInt(option.replace('option', ''), 10);
            return variant[`option${position}`] === selections[`option${position}`];
          });
        });
      }

      // Compute unavailable combination state
      let isUnavailableCombination = false;
      if (allOptionsSelected && !matchingVariant) isUnavailableCombination = true;

      // Update add-to-cart + inventory UI
      if (matchingVariant) {
        updateAddToCartButtons(true, matchingVariant);
      } else if (isUnavailableCombination) {
        updateAddToCartButtons(false, null, true);
      } else {
        // Not all options selected: only enable cart when a combination exists? keep your existing logic
        updateAddToCartButtons(false);
      }

      // Update variant-id only when we have a full matchingVariant
      if (matchingVariant) {
        const desktopId = document.getElementById('variant-id');
        const mobileId = document.getElementById('variant-id-mobile');
        if (desktopId) desktopId.value = matchingVariant.id;
        if (mobileId) mobileId.value = matchingVariant.id;
      }
    }

