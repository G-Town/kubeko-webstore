{% schema %}
{
  "name": "Intro Video",
  "settings": [
    {
      "type": "range",
      "id": "fade_duration",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "label": "Fade-out Duration",
      "default": 1.5
    }
  ],
  "presets": [
    {
      "name": "Intro Video",
      "category": "Video"
    }
  ]
}
{% endschema %}

{% if settings.intro_video_desktop != blank or settings.intro_video_mobile != blank %}
{% comment %} <div id="intro-video-container"
    class="fixed inset-0 z-[9999] w-screen h-screen bg-black flex items-center justify-center opacity-100 transition-opacity"
      style=" position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
  <div class="relative w-full h-full">
    {% if settings.intro_video_desktop != blank %}
    <div class="desktop-video-container w-full h-full hidden md:block">
      {{ settings.intro_video_desktop | video_tag: class: 'w-full h-full object-cover',
                                        controls: false, autoplay: true, muted: true, playsinline: true, id: 'intro-video-desktop' }}
    </div>
    {% endif %}
    
    {% if settings.intro_video_mobile != blank %}
    <div class="mobile-video-container w-full h-full block md:hidden">
      {{ settings.intro_video_mobile | video_tag: class: 'w-full h-full object-cover',
                                        controls: false, autoplay: true, muted: true, playsinline: true, id: 'intro-video-mobile' }}
    </div>
    {% endif %}
  </div>
</div> {% endcomment %}

{% assign desktop_video = settings.intro_video_desktop.sources | where: "format", "mp4" | last %}
{% assign mobile_video = settings.intro_video_mobile.sources | where: "format", "mp4" | last %}
<div id="intro-video-container"
    class="fixed inset-0 z-[9999] w-screen h-screen bg-black flex items-center justify-center opacity-100">

  <div class="relative w-full h-full">

    <!-- Desktop video -->
    <video
      id="intro-video-desktop"
      class="w-full h-full object-cover hidden md:block"
      muted
      autoplay
      playsinline
      preload="metadata"
      poster="{{ settings.intro_video_desktop.preview_image | image_url: width: 1200 }}"
      data-src="{{ desktop_video.url }}"
    ></video>

    <!-- Mobile video -->
    <video
      id="intro-video-mobile"
      class="w-full h-full object-cover block md:hidden"
      muted
      autoplay
      playsinline
      preload="metadata"
      poster="{{ settings.intro_video_mobile.preview_image | image_url: width: 800 }}"
      data-src="{{ mobile_video.url }}"
    ></video>

  </div>
</div>

<script>
  (function() {
    
    if (localStorage.getItem('introSeen')) {
      document.getElementById('intro-video-container')?.remove();
      return;
    }

    const container = document.getElementById('intro-video-container');
    const desktop = document.getElementById('intro-video-desktop');
    const mobile = document.getElementById('intro-video-mobile');

    const video = window.matchMedia('(max-width: 767px)').matches
      ? mobile
      : desktop;
    
    if (!video || !container) return;

    const src = video.dataset.src;

    if (src && !video.querySelector('source')) {
      const source = document.createElement('source');
      source.src = src;
      source.type = 'video/mp4';
      video.appendChild(source);
      video.load();
    }
    // document.body.style.overflow = 'hidden';

    // Safari autoplay safeguard
    video.play().catch(() => {});

    video.addEventListener('ended', () => {
      console.log("intro video ended");
      localStorage.setItem('introSeen', 'true');
      container.style.transition = 'opacity .8s';
      container.style.opacity = '0';
      // always load video
      // localStorage.removeItem('introSeen');

      setTimeout(() => {
        container.remove();
        document.body.style.overflow = '';
      }, 800);
    });
  })();
</script>

<style>
  #intro-video-container {
    transition: opacity {{ section.settings.fade_duration | default: 1.5 | divided_by: 2 }}s ease-out;
  }
  
  @media (min-width: 768px) {
    .desktop-video-container {
      display: block;
    }
    .mobile-video-container {
      display: none;
    }
  }
  
  @media (max-width: 767px) {
    .desktop-video-container {
      display: none;
    }
    .mobile-video-container {
      display: block;
    }
  }
</style>
{% endif %} 