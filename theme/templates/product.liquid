    class ProductImageManager {
      constructor(product) {
        this.product = product;
        this.variants = product.variants;
        this.allImages = product.images;
        this.imageCache = new Map();
        this.loadedVariants = new Set();
        this.currentVariant = null;
        
        this.init();
      }

      init() {
        const firstVariant = this.variants.find(v => v.available);
        // if (firstVariant) {
        //   this.loadVariant(firstVariant, true); // true = immediate load
        // }
        if (firstVariant) {
          // Get images for first variant
          const images = this.getImagesForVariant(firstVariant);
          console.log("🚀 ~ init ~ Loading first variant images:", images.length);
          
          // Load main and second image immediately on page load
          if (images.length > 0) {
            this.updateMainImageImmediate(firstVariant, images[0]);
          }
          if (images.length > 1) {
            // Load second image immediately too
            this.updateRightGallery(firstVariant, images.slice(1));
          }
          
          // Load mobile gallery
          this.updateMobileGallery(firstVariant, images);
          this.updateMobileThumbnails(firstVariant, images);
          
          // Mark this variant as loaded
          this.loadedVariants.add(firstVariant.id);
          this.currentVariant = firstVariant;
          
          // Initialize mobile gallery after a short delay
          setTimeout(() => initMobileGallery(false), 100);
        }
      }

      getImagesForVariant(variant) {
        if (!variant.featured_image) return [];
        
        const normalize = url => url ? url.replace(/^https?:/, '') : '';
        const featuredSrc = normalize(variant.featured_image.src);
        const startIndex = this.allImages.findIndex(imgUrl => 
          normalize(imgUrl).includes(featuredSrc)
        );
        
        if (startIndex === -1) return [];
        
        const result = [];
        for (let i = startIndex; i < this.allImages.length; i++) {
          const current = normalize(this.allImages[i]);
          const isAnotherFeatured = i > startIndex && this.variants.some(other =>
            other.featured_image && normalize(other.featured_image.src) === current
          );
          if (isAnotherFeatured) break;
          result.push(this.allImages[i]);
        }
        
        return result;
      }

      preloadVariantImages(variant) {
        if (this.loadedVariants.has(variant.id)) return Promise.resolve();
        
        const images = this.getImagesForVariant(variant);
        const loadPromises = images.map(imgUrl => this.preloadImage(imgUrl));
        
        return Promise.all(loadPromises).then(() => {
          this.loadedVariants.add(variant.id);
          console.log(`✅ Preloaded ${images.length} images for variant ${variant.id}`);
        });
      }

      preloadImage(src) {
        if (this.imageCache.has(src)) return Promise.resolve();
        
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            this.imageCache.set(src, img);
            resolve(img);
          };
          img.onerror = reject;
          img.src = src;
        });
      }

      // Load variant immediately (for active variant)
      async loadVariant(variant, immediate = false) {
        console.log("🚀 ~ loadVariant called with variant:", variant.id, variant);
        this.currentVariant = variant;
        const images = this.getImagesForVariant(variant);
        console.log("🚀 ~ loadVariant ~ images found:", images.length, images);
        
        if (immediate || this.loadedVariants.has(variant.id)) {
          this.updateGalleryDOM(variant, images);
          if (!this.loadedVariants.has(variant.id)) {
            await this.preloadVariantImages(variant);
          }
        } else {
          // this.showLoadingState();
          await this.preloadVariantImages(variant);
          this.updateGalleryDOM(variant, images);
        }
        
        this.preloadAdjacentVariants(variant);
      }

      // Preload nearby variants for faster switching
      preloadAdjacentVariants(currentVariant) {
        const currentIndex = this.variants.findIndex(v => v.id === currentVariant.id);
        const toPreload = [];
        
        if (currentIndex > 0) toPreload.push(this.variants[currentIndex - 1]);
        if (currentIndex < this.variants.length - 1) toPreload.push(this.variants[currentIndex + 1]);
        
        toPreload.forEach(variant => {
          if (variant.available && !this.loadedVariants.has(variant.id)) {
            setTimeout(() => this.preloadVariantImages(variant), 500);
          }
        });
      }

      // showLoadingState() {
      //   // Add loading spinner to main image
      //   const mainImage = document.getElementById('main-image');
      //   if (mainImage) {
      //     mainImage.style.opacity = '0.5';
      //     // You could add a spinner overlay here
      //   }
      // }

      updateGalleryDOM(variant, images) {
        this.updateMainImage(variant, images[0]);
        this.updateRightGallery(variant, images.slice(1));
        this.updateMobileGallery(variant, images);
        this.updateMobileThumbnails(variant, images);
        setTimeout(() => initMobileGallery(true), 100);
      }

      // Immediate update for page load (no loading states or transitions)
      updateMainImageImmediate(variant, imageUrl) {
        const mainImage = document.getElementById('main-image');
        if (!mainImage || !imageUrl) return;
        
        console.log("🚀 ~ updateMainImageImmediate ~ imageUrl:", imageUrl);
        
        // Don't add loading states on initial load
        mainImage.setAttribute('src', imageUrl);
        mainImage.setAttribute('data-src', imageUrl);
        mainImage.removeAttribute('srcset');
        mainImage.removeAttribute('onload');
        
        // Set proper dimensions to prevent size jumping
        if (variant.featured_image?.width && variant.featured_image?.height) {
          mainImage.setAttribute('width', variant.featured_image.width);
          mainImage.setAttribute('height', variant.featured_image.height);
        }
        
        // Update alt text
        mainImage.setAttribute('alt', variant.featured_image?.alt || variant.title || 'Product image');
        
        // Remove any blur classes that might be applied
        mainImage.classList.remove('blur-up', 'blur-sm');
        mainImage.style.opacity = '1';
        mainImage.dataset.loaded = 'true';
        mainImage.dataset.highResLoaded = 'true';
      }

      updateMainImage(variant, imageUrl) {
        const mainImage = document.getElementById('main-image');
        if (!mainImage || !imageUrl) return;
        console.log("🚀 ~ updateMainImage ~ imageUrl:", imageUrl)
        
        mainImage.style.opacity = '0.5';
        // mainImage.src = imageUrl;
        
        mainImage.setAttribute('src', imageUrl);
        mainImage.setAttribute('data-src', imageUrl);
        mainImage.removeAttribute('srcset');
        mainImage.removeAttribute('onload');

        mainImage.setAttribute('alt', variant.featured_image?.alt || variant.title || 'Product image');
        if (variant.featured_image?.width) mainImage.setAttribute('width', variant.featured_image.width);
        if (variant.featured_image?.height) mainImage.setAttribute('height', variant.featured_image.height);
        
        
        mainImage.onload = () => {
          console.log('[updateMainImage] loaded successfully');
          mainImage.style.opacity = '1';
          mainImage.dataset.highResLoaded = true;
          mainImage.classList.remove('blur-sm');
        };
      }

      updateRightGallery(variant, images) {
        const rightSideGallery = document.getElementById('image-scroll-container');
        if (!rightSideGallery) return;
        
        rightSideGallery.innerHTML = '';
        
        if (images.length === 0) {
          rightSideGallery.innerHTML = '<div class="w-full h-full flex items-center justify-center text-gray-400">No additional images</div>';
          return;
        }
        
        images.forEach((imgUrl, idx) => {
          const scrollItem = document.createElement('div');
          scrollItem.className = 'w-full h-full snap-center image-scroll-item';
          scrollItem.innerHTML = `
            <img
              src="${imgUrl}" 
              alt="${variant.title || 'Product image'}"
              class="w-full h-full object-contain"
              loading="lazy"
            >
          `;
          rightSideGallery.appendChild(scrollItem);
        });
      }

      updateMobileGallery(variant, images) {
        const mobileGallery = document.getElementById('mobile-gallery-container');
        if (!mobileGallery) return;
        
        mobileGallery.innerHTML = '';
        images.forEach((imgUrl, idx) => {
          const slide = document.createElement('div');
          slide.className = "w-full h-full flex-shrink-0 snap-center mobile-gallery-slide relative";
          slide.dataset.index = idx;
          slide.onclick = () => scrollToMobileImage(idx);
          slide.innerHTML = `
            <img 
              src="${imgUrl}" 
              alt="${variant.title || ''}" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          `;
          mobileGallery.appendChild(slide);
        });
      }

      updateMobileThumbnails(variant, images) {
        const mobileThumbnailWrapper = document.querySelector('.mobile-thumbnail-wrapper .mobile-gallery');
        if (!mobileThumbnailWrapper) return;
        
        mobileThumbnailWrapper.innerHTML = '';
        images.forEach((imgUrl, idx) => {
          const thumbnailButton = document.createElement('button');
          thumbnailButton.type = 'button';
          thumbnailButton.className = 'flex-shrink-0 h-[70px] w-[45.5px] mr-3 mobile-thumbnail bg-transparent border-0 p-0';
          thumbnailButton.dataset.index = idx;
          thumbnailButton.onclick = () => scrollToMobileImage(idx);
          thumbnailButton.innerHTML = `
            <img 
              src="${imgUrl}" 
              alt="${variant.title || ''}" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          `;
          mobileThumbnailWrapper.appendChild(thumbnailButton);
        });
      }
    }

