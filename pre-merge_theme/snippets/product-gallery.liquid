{% comment %} Defer scripts for better performance {% endcomment %}
<script src="{{ 'photoswipe-lightbox.umd.min.js' | asset_url }}" defer></script>
<script src="{{ 'photoswipe.umd.min.js' | asset_url }}" defer></script>
{{ 'photoswipe.css' | asset_url | stylesheet_tag }}




{% comment %} script {% endcomment %}
<script>
  // on page load
  const leftArrowSVGString = '<svg  aria-hidden="true" focusable="false" role="presentation" class="icon w-8 fill-current icon-next right-2 fixed" viewBox="0 0 64 64"><path d="M38.764 14.407l16.753 17.525-16.753 17.525-1.94-2.03 13.375-13.994H8.036v-3.002L50.2 30.43 36.824 16.437l1.94-2.03z"></path></svg>';
  const rightArrowSVGString = '<svg  aria-hidden="true" focusable="false" role="presentation" class="icon w-8 flex left-2 fixed justify-end fill-current icon-next" viewBox="0 0 64 64"><path d="M25.236 49.593L8.483 32.068l16.753-17.525 1.94 2.03-13.375 13.994h42.103v3.002L13.8 33.57l13.376 13.993-1.94 2.03z"></path></svg>';
  const closeSVGString = '<svg aria-hidden="true" focusable="false" role="presentation" class="icon fill-current icon-close" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M18.364 4.222l1.414 1.414L13.414 12l6.364 6.364-1.414 1.414L12 13.414l-6.364 6.364-1.414-1.414L10.586 12 4.222 5.636l1.414-1.414L12 10.586z"></path></svg>';
  window.onload = function() {
 
      // init PhotoSwipe
      var lightbox = new PhotoSwipeLightbox({
        gallery: '#pswipe-gallery',
        arrowPrevSVG:rightArrowSVGString ,
        arrowNextSVG:  leftArrowSVGString,
        closeSVG: closeSVGString,
        children: 'a',
        // dynamic import is not supported in UMD version
        pswpModule: PhotoSwipe 
      });
      console.log("gallery is" ,document.getElementById('pswipe-gallery'))
      lightbox.init()
    };
    // init PhotoSwipe
}

</script>



<div class="hidden sm:flex flex-col gap-[10px] pswp-gallery pswp-gallery--single-column test-gallery" id="pswipe-gallery">
  {% if product.images %}
    {% for image in product.images %}
      <a 
      href="{{ image | image_url }}"
      data-pswp-width="{{image.width}}" 
      data-pswp-height="{{image.height}}" 
      target="_blank">
      <img
        class="blur-up"
        alt="{{ product.title }}"
        src="{{ image | img_url: '100x' }}"
        data-src="{{ image | image_url }}"
        loading="lazy"
        srcset="
          {{ image | img_url: '100x' }} 100w,
          {{ image | img_url: '375x' }} 375w,
          {{ image | img_url: '750x' }} 750w,
          {{ image | img_url: '1280x' }} 1280w,
          {{ image | img_url: '2048x' }} 2048w
        "
        sizes="(max-width: 767px) 100vw, 50vw"
        width="{{ image.width }}"
        height="{{ image.height }}"
        onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
      ></a>
    {% endfor %}
  {% endif %}
</div>
{% comment %}mobile {% endcomment %}
<product-slideshow class="swiper  w-screen sm:!hidden gap-[15px]">


  <div class="swiper-wrapper">
    {% if product.images %}
      {% for image in product.images %}
        <div class="swiper-slide">
          <img
            class="w-screen blur-up"
            style="height: calc(100vw / {{ image.aspect_ratio }});"
            alt="{{ product.title }}"
            src="{{ image | img_url: '100x' }}"
            data-src="{{ image | image_url }}"
            loading="lazy"
            srcset="
              {{ image | img_url: '100x' }} 100w,
              {{ image | img_url: '375x' }} 375w,
              {{ image | img_url: '750x' }} 750w,
              {{ image | img_url: '1280x' }} 1280w,
              {{ image | img_url: '2048x' }} 2048w
            "
            sizes="100vw"
            width="{{ image.width }}"
            height="{{ image.height }}"
            onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
          >
        </div>
      {% endfor %}
    {% endif %}
  </div>
</product-slideshow>
