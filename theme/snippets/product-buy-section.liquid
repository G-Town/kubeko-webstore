{% form 'product', product %}
<div class="flex flex-col sm:h-screen gap-[15px] justify-center top-0 sticky">
  <div class="flex justify-between flex-col gap-[10px] sm:gap-[5px] ">
    {% comment %} get collections product is in and link to it {% endcomment %}
    <div class="flex gap-[6px]">
      {% for collection in product.collections %}
        {% unless collection.title == 'All' %}
          <a href="{{ collection.url }}" class="bold-body"> {{ collection.title }}</a>
          <span class="bold-body">/</span>
        {% endunless %}
      {% endfor %}
    </div>
    <h1 class="page-title ">
      {{ product.title | replace: ',', '<br>' }}
      
    </h1>
    <span class="text-[17px] font-bold !text-normal">
      {% comment %} compare at {% endcomment %}
      {% if product.compare_at_price > product.price %}
        <span class="line-through opacity-30">{{ product.compare_at_price | money_with_currency }}</span>
      {% endif %}
      {{ product.price | money_with_currency }}

    </span>
    {{ form | payment_terms }}

  </div>
  {% render 'product-form' %}

  <div class="pointer-events-auto flex overflow-x-hidden flex-col gap-[12px] mb-[6px] sm:mb-0">
      {% render 'product-description-section'   %}
  </div>
</div>
{% endform %}
