{% comment %}
  Side by Side Assets Section
  - Displays two full-height columns side-by-side on desktop (flex-row)
  - Stacks vertically on mobile (flex-col)
  - Each column can display either a product or an image
  - Products are rendered using the product-card snippet
{% endcomment %}

{% comment %} bg-[#f4f4f4] {% endcomment %}
<div class="side-by-side-assets flex flex-col md:flex-row w-full mx-auto  md:my-36 ">
  {%- comment -%} Left Column {%- endcomment -%}
  <div class="side-by-side-column w-full md:w-1/2  relative">
    {% assign product_1 = all_products[section.settings.product_1] %}
    {% assign image_1 = section.settings.image_1 %}
    
    {% if image_1 %}

      {%- assign img1_700 = image_1 | image_url: width: 700 -%}
      {%- assign img1_900 = image_1 | image_url: width: 900 -%}
      {%- assign img1_1200 = image_1 | image_url: width: 1200 -%}
      {%- assign img1_1600 = image_1 | image_url: width: 1600 -%}

      {% comment %} TODO: update to "image_url" {% endcomment %}
      <img
        class="h-full object-cover p-8 md:p-0"
        alt="{{ product_1.title | default: section.settings.image_1_alt | default: 'Left column image' }}"
        src="{{ image_1 | image_url: 1000 }}"
        {% comment %} data-src="{{ image_1 | image_url }}" {% endcomment %}
        width="{{ image_1.width }}"
        height="{{ image_1.height }}"
        loading="lazy"
        srcset="{{ img1_700 }} 700w,
                {{ img1_900 }} 900w,
                {{ img1_1200 }} 1200w,
                {{ img1_1600 }} 1600w,"
        sizes="(max-width: 767px) 100vw, 50vw"
        {% comment %} onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) {  window.loadHighResImage(this); }" {% endcomment %}
      >
      {% comment %} blur-up - this.classList.add('blur-sm'); {% endcomment %}
    {% elsif product_1 %}
      <div class="h-full w-full pb-4 bg-[#f4f4f4]">
        {% render 'product-card',
          product: product_1,
          custom_aspect_ratio: true,
          image_sizes: "(max-width: 767px) 100vw, 40vw"
        %}
      </div>
    {% endif %}
  </div>
  
  {%- comment -%} Right Column {%- endcomment -%}
  <div class="side-by-side-column w-full md:w-1/2 relative ">
    {% assign product_2 = all_products[section.settings.product_2] %}
    {% assign image_2 = section.settings.image_2 %}
    
    {% if image_2 %}

      {%- assign img2_700 = image_2 | image_url: width: 700 -%}
      {%- assign img2_900 = image_2 | image_url: width: 900 -%}
      {%- assign img2_1200 = image_2 | image_url: width: 1200 -%}
      {%- assign img2_1600 = image_2 | image_url: width: 1600 -%}

      {% comment %} TODO: update to "image_url" {% endcomment %}
      <img
        class="w-full h-full object-cover p-8 md:p-0"
        alt="{{ product_2.title | default: section.settings.image_2_alt | default: 'Right column image' }}"
        src="{{ image_2 | image_url: 1000 }}"
        {% comment %} data-src="{{ image_2 | image_url }}" {% endcomment %}
        width="{{ image_2.width }}"
        height="{{ image_2.height }}"
        loading="lazy"
        srcset="{{ img2_700 }} 700w,
                {{ img2_900 }} 900w,
                {{ img2_1200 }} 1200w,
                {{ img2_1600 }} 1600w,"
        sizes="(max-width: 767px) 100vw, 500vw"
        {% comment %} onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) {  window.loadHighResImage(this); }" {% endcomment %}
      >
      {% comment %} blur-up - this.classList.add('blur-sm'); {% endcomment %}
    {% elsif product_2 %}
      <div class="h-full w-full pb-4 bg-[#f4f4f4]">
        {% render 'product-card',
          product: product_2,
          custom_aspect_ratio: true,
          image_sizes: "(max-width: 767px) 100vw, 40vw"
        %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  /*
   * Responsive Height Control for Side-by-Side Section
   *
   * Use this block to set the maximum height of the section at different screen sizes.
   * - `max-height` prevents the section from exceeding a certain height while allowing it to be shorter if content is smaller.
   * - `vh` stands for "viewport height", where 100vh is the full browser window height.
  */

  /* Default height for mobile screens */
  .side-by-side-assets {
    /* height: auto; */
  }
  .side-by-side-column {
    height: 80vh;
    max-height: 750px; /* Optional: cap the max height on very tall devices */
  }

  /* Tablet screens (e.g., between 768px and 1024px) */
  @media (min-width: 768px) {
    .side-by-side-assets {
      height: 75vh;
      max-width: 850px;
    }
    .side-by-side-column {
      height: 100%; /* Columns fill the container height */
    }
  }

  /* Large desktop screens (e.g., wider than 1024px) */
  @media (min-width: 1025px) {
    .side-by-side-assets {
      max-width: 1100px;
    }
  }

  @media (min-width: 1280px) {
    .side-by-side-assets {
      max-width: 1150px;
    }
  }

  @media (min-width: 1536px) {
    .side-by-side-assets {
      max-width: 1200px;
      /* height: 90vh; */
    }
  }

  @media (min-width: 1720px) {
    .side-by-side-assets {
      max-width: 1300px;
      /* height: 90vh; */
    }
  }
</style>

{% schema %}
{
  "name": "Side by Side Assets",
  "settings": [
    {
      "type": "header",
      "content": "Left Column"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "Image alt text",
      "info": "Optional alt text for the image (for accessibility)"
    },
    {
      "type": "header",
      "content": "Right Column"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Image alt text",
      "info": "Optional alt text for the image (for accessibility)"
    }
  ],
  "presets": [
    {
      "name": "Side by Side Assets",
      "category": "Assets"
    }
  ]
}
{% endschema %}