    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-gallery-slide img {
    pointer-events: none;
    display: block;
  }

  /* Ensure smooth scrolling on iOS and fix potential touch issues */
  #mobile-gallery-container {
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  /* This class seems redundant but we keep it for safety */
  .mobile-gallery-container {
    pointer-events: auto !important;
    touch-action: pan-x pinch-zoom;
  }

  /* --- Mobile-Only Styles (Screen Width <= 767px) --- */
  @media (max-width: 767px) {
    #mobile-gallery-container {
      /* FIX: Remove conflicting 1/1 aspect ratio. Let the images dictate height. */
      /* FIX: Ensure container is flex for the slider */
      display: flex !important;
      flex-direction: row;
      overflow-x: auto;
      overflow-y: visible;
      
      /* Slider behavior */
      scroll-snap-type: x mandatory;
      
      /* Enforce full screen width and auto height to prevent zoom */
      width: 100%;
      height: auto !important;
      max-width: 100vw; 
    }

    .mobile-gallery-slide {
      /* FIX: Use 100% width, combined with flex-shrink: 0, forces one slide per view */
      width: 100%; 
      flex-shrink: 0; /* Critical for flex sliders */

      /* Slider behavior */
      scroll-snap-align: center;
      scroll-snap-stop: always;
      
      cursor: pointer;
    }

    .mobile-gallery-slide img {
      /* FIX: Ensure image fills its container (the slide) but does not exceed it */
      width: 100%;
      height: 100%;

      /* FIX: object-fit: contain shows the whole image, preventing the "blown up" look. */
      object-fit: contain; 
      
      /* Enforce constraints */
      max-width: 100%; 
      max-height: 100%;
    }
  }

  /* --- Desktop-Only Styles (Screen Width >= 768px) --- */
  @media (min-width: 768px) {
    #mobile-gallery-container,
    .mobile-gallery-container {
      display: none !important; /* Hide mobile gallery on desktop */
    }
  }
</style>

