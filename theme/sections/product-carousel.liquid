{% comment %}
  Product Carousel Section
  - Displays a swipeable carousel of products from a selected collection.
  - Uses Swiper.js for carousel functionality.
  - Customizable via the theme editor.
{% endcomment %}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

<div class="product-carousel-section mx-auto isolate py-10 md:my-12" data-section-id="{{ section.id }}">
  <div class="w-full md:px-8 relative">
    {%- if section.settings.title != blank -%}
      <h2 class="text-2xl md:text-lg text-center font-helvetica uppercase my-4">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- assign collection = collections[section.settings.featured_collection] -%}
    {%- assign products_limit = section.settings.products_to_show -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="swiper-container relative overflow-hidden " id="product-carousel-{{ section.id }}">
        <div class="swiper-wrapper">
          {%- for product in collection.products limit: products_limit -%}
            <div class="swiper-slide">
              {% render 'product-card',
                product: product,
                image_sizes: "(max-width: 767px) 50vw, (max-width: 1536px) 20vw, 300px" 
              %}
            </div>
          {%- endfor -%}
        </div>
        <!-- Add Pagination -->
        <div class="swiper-pagination"></div>
      </div>
      <!-- Add Navigation -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="text-center">
          <p>Please select a collection in the theme editor to display products.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carouselContainer = document.getElementById('product-carousel-{{ section.id }}');
    if (carouselContainer) {
      const swiper = new Swiper(carouselContainer, {
        loop: true,
        autoHeight: true,
        slidesPerView: 'auto',
        centeredSlides: true,
        spaceBetween: 0, // Use padding for spacing
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        navigation: {
          nextEl: '[data-section-id="{{ section.id }}"] .swiper-button-next',
          prevEl: '[data-section-id="{{ section.id }}"] .swiper-button-prev',
        },
        breakpoints: {
          // Tablet screens (768px and up)
          768: {
            // slidesPerView: {{ section.settings.products_per_view | default: 3 }},
            slidesPerView: 3,
            spaceBetween: 5,
            centeredSlides: false,
          },
          // Desktop screens (1024px and up)
          1024: {
            slidesPerView: 4, // EDIT THIS: Number of slides for desktops
            spaceBetween: 10,
            centeredSlides: false,
          },
          // Large desktop screens (1280px and up)
          1280: {
            slidesPerView: 4, // EDIT THIS: Number of slides for large desktops
            spaceBetween: 10,
            centeredSlides: false,
          },
          // Extra Large desktop screens (1536px and up)
          1280: {
            slidesPerView: 4, // EDIT THIS: Number of slides for large desktops
            spaceBetween: 10,
            centeredSlides: false,
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Number of products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_view",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Products per view (Desktop)",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product Carousel",
      "category": "Products"
    }
  ]
}
{% endschema %}

{% style %}
  .swiper-slide {
    height: auto;
    margin: 0px 0px;
  }

  [data-section-id="{{ section.id }}"] .swiper-container {
    padding-bottom: 40px; /* Space for pagination */
    margin-left: 18px;
    margin-right: 18px;
  }

  [data-section-id="{{ section.id }}"] .swiper-button-next,
  [data-section-id="{{ section.id }}"] .swiper-button-prev {
    color: #000; /* Or use a theme variable */
    top: 45%;
    transform: translateY(-50%);
    height: 20px;
  }

  [data-section-id="{{ section.id }}"] .swiper-button-prev {
    left: 5px;
  }

  [data-section-id="{{ section.id }}"] .swiper-button-next {
    right: 5px;
  }

  [data-section-id="{{ section.id }}"] .swiper-pagination {
    bottom: 20px;
  }

  [data-section-id="{{ section.id }}"] .swiper-pagination-bullet {
    background: #000;
  }

  @media (max-width: 767px) {
    [data-section-id="{{ section.id }}"] .swiper-container {
      margin-left: 0px;
      margin-right: 0px;
      padding-bottom: 20px; /* Reduced padding for mobile */
    }

    [data-section-id="{{ section.id }}"] .swiper-pagination {
      /* bottom: 0px; Adjust pagination position */
    }

    [data-section-id="{{ section.id }}"] .swiper-button-next,
    [data-section-id="{{ section.id }}"] .swiper-button-prev {
      display: none; /* Hide arrows on mobile, rely on swipe */
    }

    [data-section-id="{{ section.id }}"] .swiper-slide {
      /* width: 60%; */
      width: 250px;
      height: auto;
      transition: transform 0.3s ease;
      transform: scale(0.9);
      padding: 0px 0px; /* Add horizontal padding for spacing */
    }

    [data-section-id="{{ section.id }}"] .swiper-slide-active {
      transform: scale(1);
    }

    /* Ensure the image is contained, not cropped */
    [data-section-id="{{ section.id }}"] .swiper-slide .group img {
      object-fit: contain !important;
    }
  }

  /*
   * --- Responsive Height Control for Product Carousel ---
   * Use the rules below to set the height of the product cards for different screen sizes.
   * On desktop, height is usually automatic. Uncomment the rules for tablets or desktops
   * if you want to enforce a specific height.
  */

  /* Mobile screens (up to 767px) */
  @media (max-width: 767px) {
    /* [data-section-id="{{ section.id }}"] .swiper-slide .group {
      height: 65vh; 
    } */
  }

  /* Tablet screens (e.g., between 768px and 1024px) */
  
  @media (min-width: 768px)  {
    [data-section-id="{{ section.id }}"] .swiper-slide .group {
      height: 60vh;
      height: auto;
    }

    .product-carousel-section {
      max-width: 850px;
    }
  }



  /* Large desktop screens (e.g., wider than 1024px) */
  
  @media (min-width: 1025px) {
    [data-section-id="{{ section.id }}"] .swiper-slide .group {
      height: 55vh;
      height: auto;
    }

    .product-carousel-section {
      max-width: 1100px;
    }
  }

  @media (min-width: 1280px) {
    /* [data-section-id="{{ section.id }}"] .swiper-slide .group {
      height: 50vh;
    } */

    .product-carousel-section {
      max-width: 1250px;
    }
  }

  @media (min-width: 1536px) {
    
    [data-section-id="{{ section.id }}"] .swiper-slide .group {
      height: 65vh;
      height: auto;
    }
    .product-carousel-section {
      max-width: 1350px;
    }
  }

{% endstyle %}