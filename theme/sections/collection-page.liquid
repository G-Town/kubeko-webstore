{% render 'collection-nav-filter', collection: collection %}

{% paginate collection.products by 24 %}
  <!-- Product Grid -->
  <div
    class="px-[15px] sm:px-[30px] p-[80px] grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-[15px] items-end sm:pt-[80px] pt-[40px]"
    id="product-grid"
    data-current-page="{{ paginate.current_page }}"
    data-total-pages="{{ paginate.pages }}"
  >
    {% for product in collection.products %}
      {% if product.handle != 'routeins' %}
        <div id="product-{{ forloop.index }}-{{ paginate.current_page }}">
          {% render 'product-card', product: product %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Pagination -->
  {% if paginate.pages != 1 %}
    <div class="flex w-full justify-center mb-[30px]">
      <a
        href="{{ paginate.previous.url }}"
        class="cta mr-[9px] font-semibold {% if paginate.previous == blank %}opacity-50 pointer-events-none{% endif %}"
      >
        Previous Page
      </a>

      <a
        href="{{ paginate.next.url }}"
        class="cta ml-[9px] font-semibold {% if paginate.next == blank %}opacity-50 pointer-events-none{% endif %}"
      >
        Next Page
      </a>
    </div>
  {% endif %}
{% endpaginate %}

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "label": "List of Filter Collections",
      "id": "filters",
      "type": "collection_list",
      "info": "Select the collections that will be used as filters on this page."
    }
  ]
}
{% endschema %}
