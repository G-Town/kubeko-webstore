<head>
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.title | escape }}">
  <meta property="og:description" content="{{ product.description | strip_html | truncate: 160 | escape }}">
  <meta property="og:url" content="{{ canonical_url | default: shop.url }}{{ product.url }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:image" content="{{ product.images[0] | img_url: "1200x" | replace_first: "//", "https://" }}">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ shop.currency }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ product.title | escape }}">
  <meta name="twitter:description" content="{{ product.description | strip_html | truncate: 160 | escape }}">
  <meta name="twitter:image" content="{{ product.images[0] | img_url: "1200x" | replace_first: "//", "https://" }}">
  <meta name="twitter:site" content="@kubeko">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    /* Standardize transitions */
    .nav-container,
    #header-overlay {
      transition: background-color 300ms ease !important;
    }

    /* Ensure consistent timing for background color changes */
    .product-info-container:hover .nav-container,
    .product-info-container:hover #header-overlay {
      transition: background-color 300ms ease !important;
    } 

    /* Keep existing styles */
    .product-info-container {
      transition: all 300ms ease;
    }

    .product-details-container {
      transition: all 300ms ease;
    }

    .popup-content {
      transition: all 300ms ease;
    }

    /* Ensure consistent timing when popup is active */
    body.popup-active .nav-container,
    body.popup-active #header-overlay {
      {% comment %} background-color: white !important; {% endcomment %}
      transition: background-color 300ms ease !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const productInfoContainer = document.querySelector('.product-info-container');
      const headerOverlay = document.querySelector('#header-overlay');
      const navContainer = document.querySelector('.nav-container');
      
      if (productInfoContainer && headerOverlay && navContainer) {
        productInfoContainer.addEventListener('mouseenter', function() {
          {% comment %} requestAnimationFrame(() => {
            headerOverlay.style.backgroundColor = 'white';
            navContainer.style.backgroundColor = 'white';
          }); {% endcomment %}
        });
        
        productInfoContainer.addEventListener('mouseleave', function() {
          requestAnimationFrame(() => {
            headerOverlay.style.backgroundColor = 'rgba(254,254,254,0.60)';
            navContainer.style.backgroundColor = 'rgba(254,254,254,0.60)';
          });
        });
      }
    });
  </script>
</head>

{%- assign show_recently_viewed = false -%}
{%- if template.name == 'product' and request.path contains 'recently-viewed' -%}
  {%- assign show_recently_viewed = true -%}
{%- endif -%}

{% if show_recently_viewed %}
  <div class="recently-viewed-card hidden">
    {% render 'product-card', product: product %}
  </div>
{% else %}
  {% assign first_image = product.images[0] %}
  {% assign second_image = product.images[1] | default: first_image %}

  <script>
    // Store all product images in a global variable for client-side filtering
    window.allProductImages = {{ product.images | json }};
    window.productOptions = {{ product.options_with_values | json }};
    window.productVariants = {{ product.variants | json }};
  </script>
  
  <!-- Product Layout -->
  <div class="flex flex-col text-black md:h-90 w-full pt-0 bg-[#f4f4f4]">
    <!-- Product Content -->
    <div class="flex flex-col md:flex-row h-full md:h-full relative overflow-visible  mx-auto">
      <!-- Back Button -->
      <div class="absolute top-4 left-2 z-50">
        <a href="javascript:history.back()" class="uppercase text-sm text-[#444444] p-2 hover:bg-[#D9D9D9] transition-colors">
          &larr; Back
        </a>
      </div>
      <!-- Product Navigation Bar - Only visible on desktop -->
      {% comment %} <div class="hidden md:flex h-[49px] max-w-[650px] absolute top-[57px]  left-1/2 -translate-x-1/2 w-[calc(100%-8px)] justify-between items-center  z-[50] rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] nav-container transition-colors duration-300">
        <nav class="flex py-[10px] px-0 flex-row relative w-full items-center uppercase">
          {% if collection == blank and product.collections != blank %}
            {% assign collection = collections.all %}
          {% endif %}
          
          {% if collection != blank %}
            <!-- Find adjacent products -->
            {% assign found_prev = false %}
            {% assign found_current = false %}
            {% assign prev_product = false %}
            {% assign next_product = false %}
            
            {% for p in collections.all.products %}
              {% if found_current %}
                {% assign next_product = p %}
                {% break %}
              {% endif %}
              
              {% if p.id == product.id %}
                {% assign found_current = true %}
                {% assign found_prev = true %}
              {% elsif found_prev == false %}
                {% assign prev_product = p %}
              {% endif %}
            {% endfor %}
            
            <!-- Loop to beginning/end if needed -->
            {% if prev_product == false and collections.all.products.size > 1 %}
              {% assign prev_product = collections.all.products.last %}
            {% endif %}
            
            {% if next_product == false and collections.all.products.size > 1 %}
              {% assign next_product = collections.all.products.first %}
            {% endif %}
            
            <div class="w-1/2 pl-[19px] flex items-center">
              {% if prev_product %}
                <a href="{{ prev_product.url }}" class="uppercase text-sm text-[#444444] p-[5px] hover:bg-[#D9D9D9] transition-colors">PREVIOUS</a>
              {% else %}
                <span class="uppercase text-sm opacity-40">PREVIOUS</span>
              {% endif %}
            </div>
            
            <div class="w-1/2 pr-[19px] flex items-center justify-end">
              {% if next_product %}
                <a href="{{ next_product.url }}" class="uppercase text-sm text-[#444444] p-[5px] hover:bg-[#D9D9D9] transition-colors">NEXT</a>
              {% else %}
                <span class="uppercase text-sm opacity-40">NEXT</span>
              {% endif %}
            </div>
          {% else %}
            <div class="w-1/2 pl-[60px] flex items-center">
              <a href="/collections/all" class="uppercase text-sm text-[#444444] p-[5px] hover:bg-[#D9D9D9] transition-colors">PREVIOUS</a>
            </div>
            <div class="w-1/2 pr-[60px] flex items-center justify-end">
              <a href="/collections/all" class="uppercase text-sm text-[#444444] p-[5px] hover:bg-[#D9D9D9] transition-colors">NEXT</a>
            </div>
          {% endif %}
        </nav>
      </div> {% endcomment %}
      
      <!-- Popups for Materials, Size Guide, and Shipping -->
      <div id="popup-overlay" class="hidden fixed inset-0 bg-transparent z-[54]"></div>
      
      <div id="shipping-popup" class="hidden absolute max-w-[864px] w-[calc(100%-8px)] left-1/2 -translate-x-1/2 top-[1px] md:top-[127px] z-[55] popup-container">
        <div class="bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] rounded-[1px] py-3 px-4 popup-content transition-colors duration-300">
          <div class="flex justify-between items-center mb-4">
            <h2 class="uppercase text-sm font-medium">SHIPPING</h2>
            <button onclick="closePopup('shipping-popup')" class="text-[#444444] hover:bg-[#D9D9D9] transition-colors uppercase text-[13px] px-[5px] py-[5px]">
              CLOSE
            </button>
          </div>
          <div class="prose prose-sm text-[13px] max-w-none md:w-1/2 w-full popup-formatted-content">
            {% if settings.default_shipping_info != blank %}
              {{ settings.default_shipping_info | newline_to_br }}
            {% elsif product.metafields.custom.shipping %}
              {{ product.metafields.custom.shipping | newline_to_br }}
            {% else %}
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">For ready-to-ship items, please allow 2-3 days for the item to dispatch.</p>
              
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">For made-to-order items, please allow 3-4 weeks for the item to dispatch.</p>
              
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">You will receive an email notification to confirm your order has been dispatched.</p>
              
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">If you require any additional information please contact <span class="underline">info@kubeko.co</span></p>
              
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">We offer complimentary shipping for orders above $350 within the USA and South Korea.</p>
              
              <p class="text-[13px] leading-relaxed mb-[8px] text-[#444444]">Please note that customers outside the USA and South Korea will be responsible for all import duties and tax charges that may be applied by their local customs office on delivery to country of destination.</p>
              
              <p class="text-[13px] leading-relaxed text-[#444444]">For return requests, please contact <span class="underline">info@kubeko.co</span> within 14 days of the order's delivery date. After confirming the condition of the returning item(s), we will email you with return instructions. Items must be returned new, unused, unworn, unwashed, unaltered, and undamaged condition, with its original tags attached.</p>
            {% endif %}
          </div>
        </div>
      </div>
      
      <div id="size-guide-popup" class="hidden absolute max-w-[864px] w-[calc(100%-8px)] left-1/2 -translate-x-1/2 top-[127px] md:top-[127px] z-[55] popup-container">
        <div class="bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] rounded-[1px] py-6 px-5 popup-content transition-colors duration-300">
          <div class="flex justify-between items-center mb-4">
            <h2 class="uppercase text-sm font-medium">SIZE GUIDE</h2>
            <button onclick="closePopup('size-guide-popup')" class="text-[#444444] hover:bg-[#D9D9D9] transition-colors uppercase text-[13px] px-[5px] py-[5px]">
              CLOSE
            </button>
          </div>
          <div class="popup-formatted-content text-center">
            {% if product.metafields.custom.size_guide %}
              <!-- Using the recommended metafield_tag filter from Shopify docs -->
              <div class="w-full md:w-1/2 mx-auto">
                {{ product.metafields.custom.size_guide | metafield_tag }}
              </div>
            {% else %}
              <!-- No size guide available message -->
              <div class="w-full md:w-1/2 mx-auto">
                <p class="text-[13px] text-black leading-relaxed">No size guide available for this product.</p>
              </div>
            {% endif %}
            <p class="text-[13px] text-gray-600 mt-4">For any specific sizing questions, please contact us at <span class="underline">info@kubeko.co</span></p>
          </div>
        </div>
      </div>
      
      <div id="materials-popup" class="hidden absolute max-w-[864px] text-black w-[calc(100%-8px)] left-1/2 -translate-x-1/2 top-[127px] md:top-[127px] z-[55] popup-container">
        <div class="bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] rounded-[1px] px-5 py-6 popup-content transition-colors duration-300">
          <div class="flex justify-between items-center mb-4">
            <h2 class="uppercase text-sm font-medium">MATERIALS</h2>
            <button onclick="closePopup('materials-popup')" class="text-[#444444] hover:bg-[#D9D9D9] transition-colors uppercase text-[13px] px-[5px] py-[5px]">
              CLOSE
            </button>
          </div>
          <div class="prose prose-sm text-[13px] max-w-none md:w-1/2 w-full popup-formatted-content" id="materials-content-container">
            {% if product.metafields.custom.materials %}
              <div id="materials-content-wrapper">
                {% if product.metafields.custom.materials.type == 'json' %}
                  {{ product.metafields.custom.materials | metafield_tag }}
                {% else %}
                  {{ product.metafields.custom.materials }}
                {% endif %}
              </div>

              <style>
                /* Add styling to properly format the metafield content */
                #materials-content-wrapper p {
                  font-size: 13px;
                  line-height: 1.7;
                  margin-bottom: 1.5rem;
                }
                
                #materials-content-wrapper > div > p {
                  font-size: 13px;
                  line-height: 1.7;
                  margin-bottom: 1.5rem;
                }
                
                #materials-content-wrapper > p:last-child,
                #materials-content-wrapper > div > p:last-child {
                  margin-bottom: 0;
                }
              </style>
            {% else %}
              <p class="text-[13px] leading-relaxed">Materials information not available for this product.</p>
            {% endif %}
          </div>
        </div>
      </div>
      
      <!-- Left Side - Main Product Image (Full width on mobile) -->
      <div class="w-full md:w-1/2 md:h-full relative pb-12 md:pb-0">
        <!-- Main Image for Desktop -->
        <div class="hidden md:block w-full h-full">
          <img 
            id="main-image"
            src="{{ first_image | img_url: '100x' }}" 
            data-src="{{ first_image | image_url }}"
            alt="{{ product.title }}"
            {% comment %} TODO: contain vs cover to prevent img cutoff {% endcomment %}
            class="w-full h-full object-contain blur-up"
            width="{{ first_image.width }}"
            height="{{ first_image.height }}"
            loading="eager"
            srcset="{{ first_image | img_url: '400x' }} 400w,
                    {{ first_image | img_url: '600x' }} 600w,
                    {{ first_image | img_url: '800x' }} 800w,
                    {{ first_image | img_url: '1200x' }} 1200w,
                    {{ first_image | img_url: 'master' }} {{ first_image.width }}w"
            sizes="(max-width: 767px) 100vw, 50vw"
            onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
          >
        </div>
        
        <!-- Mobile Main Image (Slideshow on mobile) -->
        <div id="mobile-gallery-container" class="block md:hidden w-full aspect-[45.5/70] overflow-x-auto snap-x snap-mandatory whitespace-nowrap" style="display: flex; flex-direction: row;">
          {% for image in product.images %}
            <div 
              class="w-full h-full flex-shrink-0 snap-center mobile-gallery-slide relative" 
              data-index="{{ forloop.index0 }}"
              onclick="scrollToMobileImage({{ forloop.index0 }})"
            >
              <img 
                src="{{ image | img_url: '100x' }}" 
                data-src="{{ image | image_url }}"
                alt="{{ product.title }}" 
                class="w-full h-full object-cover blur-up"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                srcset="{{ image | img_url: '200x' }} 200w,
                        {{ image | img_url: '400x' }} 400w,
                        {{ image | img_url: '600x' }} 600w,
                        {{ image | img_url: '800x' }} 800w,
                        {{ image | img_url: '1200x' }} 1200w,
                        {{ image | img_url: 'master' }} {{ image.width }}w"
                sizes="100vw"
                onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
              >
            </div>
          {% endfor %}
        </div>
        
        <!-- Mobile Thumbnail Gallery -->
        <div class="block md:hidden w-full h-[80px] overflow-x-auto absolute bottom-0 left-0 z-10 mobile-gallery-container mobile-thumbnail-wrapper">
          <div class="flex flex-row items-center h-full px-4 mobile-gallery">
            {% for image in product.images %}
              <button 
                type="button"
                class="flex-shrink-0 h-[70px] w-[45.5px] mr-3 mobile-thumbnail bg-transparent border-0 p-0" 
                data-index="{{ forloop.index0 }}"
                onclick="scrollToMobileImage({{ forloop.index0 }})"
              >
                <img 
                  src="{{ image | img_url: '200x' }}" 
                  alt="{{ product.title }}" 
                  class="w-full h-full object-cover"
                  width="45.5"
                  height="70"
                  loading="lazy"
                  srcset="{{ image | img_url: '46x70_crop_center' }} 46w"
                  sizes="45.5px"
                >
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
      
      <!-- Right Side - Second Image with Thumbnails (Hidden on mobile) -->
      <div class="hidden md:block md:w-1/2 h-full relative">
        <!-- Right Main Image replaced with scrollable gallery -->
        <div id="image-scroll-container" class="w-full h-full overflow-y-auto custom-scrollbar scroll-snap-container">
          {% assign images_for_right_side = product.images | slice: 1, product.images.size %}
          {% for image in images_for_right_side %}
            <div 
              class="w-full h-full snap-center image-scroll-item" 
              data-image-id="{{ image.id }}"
              id="scroll-image-{{ image.id }}"
            >
              <img
                src="{{ image | img_url: '100x' }}" 
                data-src="{{ image | image_url }}"
                alt="{{ product.title }}"
                {% comment %} TODO: contain vs cover to prevent img cutoff {% endcomment %}
                class="w-full h-full object-contain blur-up"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                srcset="{{ image | img_url: '400x' }} 400w,
                        {{ image | img_url: '600x' }} 600w,
                        {{ image | img_url: '800x' }} 800w,
                        {{ image | img_url: '1200x' }} 1200w,
                        {{ image | img_url: 'master' }} {{ image.width }}w"
                sizes="(max-width: 767px) 100vw, 50vw"
                onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
              >
            </div>
          {% endfor %}
        </div>
        
        <!-- Thumbnail Column - Scrollable (Desktop only) -->
        {% comment %} <div class="absolute right-4 top-0 h-full flex flex-col items-end z-10 overflow-y-auto max-h-full py-4 custom-scrollbar">
          <div class="flex flex-col items-end">
            {% for image in images_for_right_side %}
              <div 
                class="w-[130px] h-[200px] cursor-pointer mb-2 thumbnail-image {% if forloop.first %}opacity-100{% else %}opacity-60{% endif %}" 
                data-image-id="{{ image.id }}"
                data-target-scroll-id="scroll-image-{{ image.id }}"
              >
                <img 
                  src="{{ image | img_url: '200x' }}" 
                  alt="{{ product.title }}" 
                  class="w-full h-full object-cover"
                  width="100"
                  height="100"
                  loading="lazy"
                  srcset="{{ image | img_url: '60x' }} 60w,
                          {{ image | img_url: '120x' }} 120w,
                          {{ image | img_url: '200x' }} 200w"
                  sizes="100px"
                >
              </div>
            {% endfor %}
          </div>
        </div> {% endcomment %}
      </div>
      
      <!-- Mobile Product Info - Below the images on mobile, hidden on desktop -->
      <div class="block bg-[#EFEFEF] md:hidden w-full z-10">
        <!-- Product Header Row -->
        <div class="p-[4px]">
          <div class="px-4 bg-white py-3 flex justify-between items-center">
            <h1 class="uppercase text-[13px] font-medium text-[#444444]">{{ product.title }}</h1>
            <span class="text-[13px] text-[#444444]">${{ product.price | money_without_currency }}</span>
          </div>
        </div>
        
        <!-- Container for all product info -->
        <div class="px-[4px] pb-[4px]">
          <div class="flex bg-white flex-col p-4">
            {% if product.has_only_default_variant == false %}
              {% assign options = product.options_with_values %}
              
              <!-- Options grid in two columns -->
              <div class="grid grid-cols-2 gap-4 mb-4">
                <!-- First option column (Color) -->
                <div class="flex flex-col items-start gap-[8px]">
                  {%- assign color_option = null -%}
                  {%- for opt in product.options_with_values -%}
                    {%- if opt.name == 'Color' -%}
                      {%- assign color_option = opt -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {% if color_option %}
                    <span id="mobile-selected-color-name" class="uppercase text-[13px] text-[#444444] mb-2"></span>
                    <div class="flex items-center flex-wrap gap-1 pt-2" id="mobile-color-chips-container">
                      {%- for value in color_option.values -%}
                        {%- assign variant_for_color = null -%}
                        {%- for variant in product.variants -%}
                          {%- if variant.options contains value -%}
                            {%- assign variant_for_color = variant -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}

                        {%- if variant_for_color -%}
                          {%- assign is_selected = false -%}
                          {%- if product.selected_or_first_available_variant.options contains value -%}
                            {%- assign is_selected = true -%}
                          {%- endif -%}

                          <div class="color-chip-container{% if is_selected %} active{% endif %}">
                            <button
                              type="button"
                              class="color-chip"
                              style="background-color: {{ value.swatch.color }};"
                              data-color-name="{{ value | escape }}"
                              data-option-position="{{ color_option.position }}"
                              data-value="{{ value | escape }}"
                              onclick="selectVariant(this, '{{ color_option.position }}', '{{ value | escape }}')"
                              aria-label="Select color {{ value | escape }}"
                            ></button>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {% endif %}
                </div>
                
                <!-- Second option column (Size) -->
                <div class="flex flex-col items-end gap-[8px]">
                  {%- assign size_option = null -%}
                  {%- for opt in product.options_with_values -%}
                    {%- if opt.name == 'Size' -%}
                      {%- assign size_option = opt -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {% if size_option %}
                    {% for value in size_option.values %}
                      <button 
                        type="button"
                        class="variant-button text-right uppercase text-[13px] text-[#444444] {% if forloop.first %}font-medium{% endif %}" 
                        data-option-position="{{ size_option.position }}" 
                        data-value="{{ value | escape }}"
                        onclick="selectVariant(this, '{{ size_option.position }}', '{{ value | escape }}')"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>
              
              <!-- Add to cart button centered below variants -->
              <div class="text-center mb-6">
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-mobile">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="w-full bg-neutral-200 h-[33px] text-black text-sm uppercase py-2 transition-colors add-to-cart-btn" disabled>ADD TO CART</button>
                  <div id="mobile-inventory-status" class="inventory-status text-xs mt-1" style="display: none;"></div>
                {% endform %}
              </div>
            {% else %}
              <!-- Only Add to Cart when no variants -->
              <div class="text-center mb-6">
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-mobile">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="w-full h-[33px] bg-neutral-200 text-black text-sm uppercase py-2 transition-colors add-to-cart-btn">ADD TO CART</button>
                  <div id="mobile-inventory-status" class="inventory-status text-xs mt-1" style="display: none;"></div>
                {% endform %}
              </div>
            {% endif %}
            
            <!-- Product Description -->
            <div class="mb-6">
              <p class="font-garamond text-[16px] text-[#444444] font-normal">{{ product.description | strip_html }}</p>
            </div>
            
            <!-- Info Links -->
            <div class="flex flex-col space-y-2">
              <button onclick="openPopup('materials-popup')" class="flex justify-between items-center w-full px-[5px] py-[2px] text-left hover:bg-[#D9D9D9] transition-colors">
                <span class="uppercase text-[13px] text-[#444444]">MATERIALS</span>
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="7" height="7" viewBox="0 0 7 7" fill="none">
