{% comment %}
  TODO: revisit top spacing after the header no longer overlays section content.
  Consider a merchant-editable top padding and/or an optional intro heading then.
{% endcomment %}
<div class="curated-collections">
  <div class="curated-collections__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = collections[block.settings.collection] -%}
      {%- if collection and collection.handle != blank -%}
        {%- assign first_image = collection.image -%}
        {%- if first_image == blank -%}
          {%- assign first_image = collection.products.first.featured_image -%}
        {%- endif -%}
        {%- assign second_image = collection.metafields.custom.second_image -%}

        <div class="curated-collections__card">
          <a
            href="{{ collection.url }}"
            class="curated-collections__link{% if first_image and second_image %} curated-collections__link--has-secondary{% endif %}"
          >
            <div class="curated-collections__media">
              {%- if first_image -%}
                <img
                  src="{{ first_image | image_url: width: 900 }}"
                  srcset="
                    {{ first_image | image_url: width: 700 }} 700w,
                    {{ first_image | image_url: width: 900 }} 900w,
                    {{ first_image | image_url: width: 1200 }} 1200w,
                    {{ first_image | image_url: width: 1600 }} 1600w
                  "
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  width="{{ first_image.width }}"
                  height="{{ first_image.height }}"
                  alt="{{ collection.title | escape }}"
                  class="curated-collections__image curated-collections__image--primary"
                  loading="lazy"
                >
                {%- if second_image -%}
                  <img
                    src="{{ second_image | image_url: width: 900 }}"
                    srcset="
                      {{ second_image | image_url: width: 700 }} 700w,
                      {{ second_image | image_url: width: 900 }} 900w,
                      {{ second_image | image_url: width: 1200 }} 1200w,
                      {{ second_image | image_url: width: 1600 }} 1600w
                    "
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    width="{{ second_image.width }}"
                    height="{{ second_image.height }}"
                    alt=""
                    class="curated-collections__image curated-collections__image--secondary"
                    loading="lazy"
                  >
                {%- endif -%}
              {%- endif -%}
            </div>

            <div class="curated-collections__title-bar">
              <div class="curated-collections__title-panel">
                <h2 class="curated-collections__title">{{ collection.title }}</h2>
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Curated Collections",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Collections",
      "category": "Collections"
    }
  ]
}
{% endschema %}

{% style %}
  #shopify-section-{{ section.id }} .curated-collections {
    box-sizing: border-box;
    max-width: 1260px;
    margin: 0 auto;
    padding: 1.5rem 5px 0;
  }

  #shopify-section-{{ section.id }} .curated-collections__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .curated-collections__card {
    flex: 0 0 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .curated-collections__card {
      flex-basis: calc((100% - 10px) / 2);
    }
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .curated-collections__card {
      flex-basis: calc((100% - 20px) / 3);
    }
  }

  #shopify-section-{{ section.id }} .curated-collections__link {
    position: relative;
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .curated-collections__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #444444;
  }

  #shopify-section-{{ section.id }} .curated-collections__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .curated-collections__link--has-secondary .curated-collections__image--primary {
    transition: opacity 300ms ease;
  }

  #shopify-section-{{ section.id }} .curated-collections__link--has-secondary .curated-collections__image--secondary {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  #shopify-section-{{ section.id }} .curated-collections__title-bar {
    position: absolute;
    right: 4px;
    bottom: 4px;
    left: 4px;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .curated-collections__title-panel {
    padding: 0.75rem 1rem;
    background: rgba(245, 245, 245, 0.6);
    -webkit-backdrop-filter: blur(12.5px);
    backdrop-filter: blur(12.5px);
  }

  #shopify-section-{{ section.id }} .curated-collections__title {
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .curated-collections__link--has-secondary:hover .curated-collections__image--primary {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .curated-collections__link--has-secondary:hover .curated-collections__image--secondary {
      opacity: 1;
    }
  }
{% endstyle %}
