      // Completely revised mobile gallery initialization and synchronization
      function initMobileSwipeGallery() {
        const mobileGalleryContainer = document.getElementById('mobile-gallery-container');
        const mobileThumbnails = document.querySelectorAll('.mobile-thumbnail');
        
        if (!mobileGalleryContainer || mobileThumbnails.length === 0) return;
        
        // Direct fix: Force the first image to be shown and first thumbnail to be highlighted
        setTimeout(function() {
          // Reset scroll position to first image
          mobileGalleryContainer.scrollTo({
            left: 0,
            behavior: 'auto'
          });
          
          // Force highlight the first thumbnail
          mobileThumbnails.forEach((thumb, index) => {
            if (index === 0) {
              thumb.classList.remove('opacity-30');
              thumb.classList.add('opacity-100');
            } else {
              thumb.classList.remove('opacity-100');
              thumb.classList.add('opacity-30');
            }
          });
          
          // Update pagination
          const paginationIndicator = document.getElementById('mobile-pagination-indicator');
          if (paginationIndicator) {
            paginationIndicator.textContent = `1 / ${mobileThumbnails.length}`;
          }
        }, 100);
        
        // Function to scroll to a specific image in the mobile gallery
        window.scrollToMobileImage = function(index) {
          const mobileGalleryContainer = document.getElementById('mobile-gallery-container');
          if (mobileGalleryContainer) {
            const imageElements = mobileGalleryContainer.children;
            if (index >= 0 && index < imageElements.length) {
              const targetImage = imageElements[index];
              
              // Scroll to the target image with smooth behavior
              targetImage.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
              
              // Update thumbnails to reflect the new active image
              updateActiveMobileThumbnail(index);
            }
          }
        };
        
        // Update which mobile thumbnail is active
        function updateActiveMobileThumbnail(activeIndex) {
          const mobileThumbnails = document.querySelectorAll('.mobile-thumbnail');
          mobileThumbnails.forEach((thumb, index) => {
            if (index === activeIndex) {
              thumb.classList.remove('opacity-30');
              thumb.classList.add('opacity-100');
            } else {
              thumb.classList.remove('opacity-100');
              thumb.classList.add('opacity-30');
            }
          });
        }
        
        // Enhanced touch handling for mobile swipe
        let startX, moveX;
        let startTime, isSwiping = false;
        
        mobileGalleryContainer.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
          startTime = new Date().getTime();
          isSwiping = false;
        }, { passive: true });
        
        mobileGalleryContainer.addEventListener('touchmove', function(e) {
          if (!startX) return;
          moveX = e.touches[0].clientX;
          isSwiping = true;
        }, { passive: true });
        
        mobileGalleryContainer.addEventListener('touchend', function(e) {
          if (!isSwiping) return;
          
          const endX = e.changedTouches[0].clientX;
          const endTime = new Date().getTime();
          const timeDiff = endTime - startTime;
          const distX = endX - startX;
          
          // For very quick swipes, or significant distance swipes
          if ((Math.abs(distX) > 50 && timeDiff < 300) || Math.abs(distX) > mobileGalleryContainer.offsetWidth / 3) {
            const containerWidth = mobileGalleryContainer.offsetWidth;
            const currentPosition = mobileGalleryContainer.scrollLeft;
            const currentIndex = Math.round(currentPosition / containerWidth);
            
            // Determine direction and target slide
            let targetIndex;
            if (distX < 0) { // Swipe left, go next
              targetIndex = Math.min(currentIndex + 1, mobileGalleryContainer.children.length - 1);
            } else { // Swipe right, go prev
              targetIndex = Math.max(currentIndex - 1, 0);
            }
            
            // Programmatically scroll to the target slide
            scrollToMobileImage(targetIndex);
          }
          
          // Reset variables
          startX = null;
          moveX = null;
          isSwiping = false;
        }, { passive: true });
        
        // Improved scroll event handling with IntersectionObserver for better performance
        const imageObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && entry.intersectionRatio > 0.8) {
              const index = Array.from(mobileGalleryContainer.children).indexOf(entry.target);
              if (index !== -1) {
                updateActiveMobileThumbnail(index);
              }
            }
          });
        }, {
          root: mobileGalleryContainer,
          threshold: [0.8],
          rootMargin: '0px'
        });
        
        // Observe all gallery images
        Array.from(mobileGalleryContainer.children).forEach(image => {
          imageObserver.observe(image);
        });
        
        // Backup solution: listen for scroll events with debounce
        let scrollTimeout;
        mobileGalleryContainer.addEventListener('scroll', function() {
          clearTimeout(scrollTimeout);
          
          scrollTimeout = setTimeout(() => {
            const containerWidth = mobileGalleryContainer.offsetWidth;
            const scrollPosition = mobileGalleryContainer.scrollLeft;
            const imageIndex = Math.round(scrollPosition / containerWidth);
            
            if (imageIndex >= 0 && imageIndex < mobileThumbnails.length) {
              updateActiveMobileThumbnail(imageIndex);
            }
          }, 50);
        }, { passive: true });
        
        // Add click handlers to mobile thumbnails
        mobileThumbnails.forEach((thumb, index) => {
          thumb.addEventListener('click', function() {
            scrollToMobileImage(index);
          });
        });
      }
      
      // Initialize the mobile gallery
      initMobileSwipeGallery();
      
      // Setup click outside to close popups
      document.addEventListener('click', function(event) {
        // Check if any popup is open
        const openPopups = document.querySelectorAll('#shipping-popup:not(.hidden), #size-guide-popup:not(.hidden), #materials-popup:not(.hidden)');
        
        if (openPopups.length === 0) return; // No popups open, nothing to do
        
        // Check if click was on a popup trigger button
        const isPopupTrigger = event.target.hasAttribute('onclick') && 
                             (event.target.getAttribute('onclick').includes('openPopup') || 
                              event.target.getAttribute('onclick').includes('closePopup'));
        
        if (isPopupTrigger) return; // Don't close if clicking a trigger button
        
        // Check if click was inside any popup
        let clickedInsidePopup = false;
        openPopups.forEach(popup => {
          if (popup.contains(event.target)) {
            clickedInsidePopup = true;
          }
        });
        
        // If click was outside all popups, close them
        if (!clickedInsidePopup) {
          closeAllPopups();
        }
      });
      
      // Remove the old click-outside handlers
      document.removeEventListener('mousedown', handleClickOutside);
      document.removeEventListener('touchstart', handleClickOutside);
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Setup for vertical scroll gallery on desktop
      const scrollContainer = document.getElementById('image-scroll-container');
      const thumbnails = document.querySelectorAll('.thumbnail-image');
      const mainImage = document.getElementById('main-image');
      
      if (scrollContainer && thumbnails.length > 0) {
        // Make the first thumbnail active by default (which is now the second image)
        if (thumbnails[0]) {
          thumbnails[0].classList.remove('opacity-60');
          thumbnails[0].classList.add('opacity-100');
          
          // Also scroll the first item in the right-side gallery into view
          const firstItemId = thumbnails[0].dataset.targetScrollId;
          const firstElement = document.getElementById(firstItemId);
          if (firstElement) {
            firstElement.scrollIntoView({ behavior: 'auto' });
          }
        }
        
        // Improve scroll detection for faster response
        let isScrolling = false;
        scrollContainer.addEventListener('scroll', function() {
          // Set flag to indicate scrolling is happening
          isScrolling = true;
          
          // Call handler immediately for faster response
          handleScroll();
          
          // Then debounce for final position
          clearTimeout(window.scrollDebounce);
          window.scrollDebounce = setTimeout(function() {
            isScrolling = false;
            handleScroll();
          }, 50);
        });
        
        // Function to handle scroll events - extracted for reuse
        function handleScroll() {
          // Find which image is most visible with lower threshold
          let maxVisibleRatio = 0;
          let mostVisibleImageId = null;
          let mostVisibleImageUrl = null;
          
          document.querySelectorAll('.image-scroll-item').forEach(item => {
            const rect = item.getBoundingClientRect();
            const containerRect = scrollContainer.getBoundingClientRect();
            
            // Calculate how much of the item is visible in the container
            const visibleTop = Math.max(rect.top, containerRect.top);
            const visibleBottom = Math.min(rect.bottom, containerRect.bottom);
            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
            const visibleRatio = visibleHeight / rect.height;
            
            // Use much lower threshold of 20% visibility for faster updates
            if (visibleRatio > 0.2 && visibleRatio > maxVisibleRatio) {
              maxVisibleRatio = visibleRatio;
              mostVisibleImageId = item.dataset.imageId;
              mostVisibleImageUrl = item.querySelector('img').src;
            }
          });
          
          if (mostVisibleImageId) {
            updateActiveThumbnail(mostVisibleImageId);
            
            // Update main image to match
            if (mainImage && mostVisibleImageUrl) {
              mainImage.src = mostVisibleImageUrl;
            }
          }
        }
        
        // Update active thumbnail based on which image is in viewport
        const observer = new IntersectionObserver((entries) => {
          // Skip observer updates while actively scrolling for smoother experience
          if (isScrolling) return;
          
          entries.forEach(entry => {
            if (entry.isIntersecting && entry.intersectionRatio > 0.3) {  // Lower threshold to 30%
              const imageId = entry.target.dataset.imageId;
              updateActiveThumbnail(imageId);
              
              // Also update the main image to match the scrolled image
              const imageUrl = entry.target.querySelector('img').src;
              if (mainImage) {
                mainImage.src = imageUrl;
              }
            }
          });
        }, {
          root: scrollContainer,
          threshold: [0.2, 0.3, 0.5]  // Lower thresholds for earlier detection
        });
        
        // Function to update which thumbnail is active
        function updateActiveThumbnail(imageId) {
          thumbnails.forEach(thumb => {
            if (thumb.dataset.imageId === imageId) {
              thumb.classList.remove('opacity-60');
              thumb.classList.add('opacity-100');
            } else {
              thumb.classList.remove('opacity-100');
              thumb.classList.add('opacity-60');
            }
          });
        }
        
        // Observe all image items in the scroll container
        document.querySelectorAll('.image-scroll-item').forEach(item => {
          observer.observe(item);
        });
        
        // Add click handlers to thumbnails to scroll to corresponding image
        thumbnails.forEach(thumb => {
          thumb.addEventListener('click', function() {
            const targetId = this.dataset.targetScrollId;
            const targetElement = document.getElementById(targetId);
            const imageId = this.dataset.imageId;
            
            if (targetElement) {
              targetElement.scrollIntoView({ behavior: 'smooth' });
              
              // Update thumbnails immediately on click
              updateActiveThumbnail(imageId);
              
              // Also update main image when thumbnail is clicked
              const imageUrl = this.querySelector('img').src;
              if (mainImage) {
                // Make sure we get the full-sized image URL
                const fullSizeUrl = imageUrl.replace(/_(60x|120x|200x)\./, '_master.');
                mainImage.src = fullSizeUrl;
              }
            }
          });
        });
      }
      
      // Also update mobile gallery to match initial image
      initMobileGalleryToMatchMain();
      
      function initMobileGalleryToMatchMain() {
        const mobileThumbnails = document.querySelectorAll('.mobile-thumbnail');
        const mobileGalleryContainer = document.getElementById('mobile-gallery-container');
        
        if (mainImage && mobileThumbnails.length > 0 && mobileGalleryContainer) {
          // For mobile, we always start with the first image (unlike desktop where first image is on left, rest on right)
          // Simply ensure the first mobile thumbnail is active and scroll to first image
          setTimeout(function() {
            // Reset scroll position to first image
            mobileGalleryContainer.scrollTo({
              left: 0,
              behavior: 'auto'
            });
            
            // Force highlight the first thumbnail
            mobileThumbnails.forEach((thumb, index) => {
              if (index === 0) {
                thumb.classList.remove('opacity-30');
                thumb.classList.add('opacity-100');
              } else {
                thumb.classList.remove('opacity-100');
                thumb.classList.add('opacity-30');
              }
            });
            
            // Update pagination
            const paginationIndicator = document.getElementById('mobile-pagination-indicator');
            if (paginationIndicator) {
              paginationIndicator.textContent = `1 / ${mobileThumbnails.length}`;
            }
          }, 100);
        }
      }
    });
  </script>
  
