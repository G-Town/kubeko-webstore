<div id="footer">
  {% comment %} <footer class="footer bg-white cta text-[#444444] md:hidden flex-row p-[15px] sm:p-[30px]">
    <div class="flex gap-[15px]">
  </footer> {% endcomment %}

  <!-- Mobile Footer -->
  <footer class="footer bg-white cta text-[#444444] px-[20px] pb-[40px] pt-[60px] flex flex-col md:hidden">
    <!-- Newsletter Section (Mobile) -->
    <div class="flex flex-col gap-[15px] w-full mb-[40px]">
      <h2 class="uppercase text-[13px] font-medium">Newsletter</h2>
      <div class="flex flex-col gap-[15px]">
        <p class="text-black/50 text-[13px]">Sign up for Monthly Updates</p>
        {% form 'customer', class: 'flex flex-col' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="form_type" value="customer">
          <div class="flex flex-col">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterForm--{{ section.id }}-mobile"
              class="w-full bg-transparent border-b border-black/20 py-2 focus:outline-none focus:border-black transition-colors text-[13px]"
              placeholder="Email"
              required
            >
            <button
              type="submit"
              class="text-black hover:opacity-70 transition-colors text-right mt-2 h-[24px] p-2 inline-block w-fit ml-auto text-[13px] rounded-[1px]"
              name="commit"
            >
              Subscribe
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="text-green-600 text-sm mt-2">Thanks for subscribing!</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="text-red-600 text-sm mt-2">{{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <!-- Categories Layout (Mobile) -->
    {% for link in linklists.footer.links %}
      <div class="flex mb-[30px] gap-[10px]">
        <div class="flex flex-col w-[40%]">
          <p class="font-medium uppercase">{{ link.title }}</p>
        </div>
        {% if link.links.size > 0 %}
          <div class="flex flex-col gap-[15px] w-[60%]">
            {% for sublink in link.links %}
              {% assign external_url = false %}
              {% if sublink.url contains "://" %}
                {% unless sublink.url contains shop.url %}
                  {% assign external_url = true %}
                {% endunless %}
              {% endif %}
              <a href="{{ sublink.url }}" class="text-sm hover:opacity-70 transition-colors"{% if external_url %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ sublink.title }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}

    <!-- Footer Logo and Copyright (Mobile) -->
    <div class="flex flex-col w-full items-center mt-[30px]">
      {% render 'logo' %}
      <p class="text-sm text-center mt-2">Copyright © {% assign current_year = 'now' | date: '%Y' %}{{ current_year }}</p>
    </div>
  </footer>

  <!-- Desktop Footer -->
  <footer class="footer bg-white cta text-[#444444] px-[20px] pb-[40px] pt-[120px] flex-col hidden md:flex">
    <div class="grid grid-cols-4 gap-[60px] items-start self-stretch mb-[120px]">
      {% for link in linklists.footer.links %}
        <div class="flex flex-col gap-[15px]">
          <p class="font-medium uppercase">{{ link.title }}</p>
          {% if link.links.size > 0 %}
            <div class="flex flex-col gap-[15px]">
              {% for sublink in link.links %}
                {% assign external_url = false %}
                {% if sublink.url contains "://" %}
                  {% unless sublink.url contains shop.url %}
                    {% assign external_url = true %}
                  {% endunless %}
                {% endif %}
                <a href="{{ sublink.url }}" class="text-sm hover:opacity-70 transition-colors"{% if external_url %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ sublink.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}

      <div class="flex flex-col gap-[15px] w-full">
        <h2 class="uppercase text-[13px]">Newsletter</h2>
        <div class="flex flex-col gap-[15px]">
          <p class="text-black text-[13px]">Sign up for Monthly Updates</p>
          {% form 'customer', class: 'flex flex-col' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="form_type" value="customer">
            <div class="flex flex-col">
              <input
                type="email"
                name="contact[email]"
                id="NewsletterForm--{{ section.id }}"
                class="w-full bg-transparent border-b border-black/20 py-2 focus:outline-none focus:border-black transition-colors text-[13px]"
                placeholder="Email"
                required
              >
              <button
                type="submit"
                class="text-black hover:opacity-70 transition-colors text-right mt-2 h-[24px] px-2 inline-block w-fit ml-auto text-[13px] rounded-[1px]"
                name="commit"
              >
                Subscribe
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="text-green-600 text-sm mt-2">Thanks for subscribing!</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="text-red-600 text-sm mt-2">{{ form.errors.messages['email'] }}</p>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    </div>
    <div class="flex flex-col w-full items-end">
      <div class="mx-auto flex flex-col items-center">
        {% render 'logo' %}
        <p class="text-sm text-center mt-2">Copyright © {% assign current_year = 'now' | date: '%Y' %}{{ current_year }}</p>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "default": {
    "blocks": []
  }
}
{% endschema %}
