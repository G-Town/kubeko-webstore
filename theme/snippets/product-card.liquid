{%- assign first_image = product.images[0] | default: product.featured_image -%}
{%- assign second_image = product.images[1] | default: first_image -%}
{%- assign unique_id = product.id -%}

<script>
// Product Card namespace to avoid global conflicts
const ProductCard = {
  // Cache for product data to avoid re-parsing JSON
  productDataCache: {},
  
  // Function to toggle product images on mobile
  toggleProductImages: function(thumbnailButton, event, productId) {
    // Prevent default actions
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    
    // Get elements
    const productCard = thumbnailButton.closest('.group');
    if (!productCard) return;
    
    // Get all needed elements
    const activeThumbContainer = document.getElementById(`thumb-container-${productId}`);
    const primaryImageUrl = thumbnailButton.dataset.primaryImage;
    const secondaryImageUrl = thumbnailButton.dataset.secondaryImage;
    const mainImage = document.getElementById(`primary-image-${productId}`);
    const secondaryImage = document.getElementById(`secondary-image-${productId}`);
    
    if (!mainImage || !secondaryImage || !activeThumbContainer) return;
    
    // Toggle the class to track state
    productCard.classList.toggle('images-toggled');
    const isShowingSecondary = productCard.classList.contains('images-toggled');
    
    // First, handle the image switching instantly
    if (isShowingSecondary) {
      // Update the thumbnail to show primary image (because secondary is shown in main view)
      activeThumbContainer.innerHTML = `<img 
        src="${primaryImageUrl}" 
        alt="Primary view" 
        class="w-full h-auto object-contain block"
        loading="eager"
        id="thumb-active-${productId}"
        style="display: block; margin: 0;"
      >`;
      
      // Make changes instant
      mainImage.style.transition = "none";
      secondaryImage.style.transition = "none";
      
      mainImage.style.opacity = '0';
      mainImage.style.zIndex = '1';
      secondaryImage.style.opacity = '1';
      secondaryImage.style.zIndex = '2';
    } else {
      // Update the thumbnail to show secondary image (because primary is shown in main view)
      activeThumbContainer.innerHTML = `<img 
        src="${secondaryImageUrl}" 
        alt="Alternate view" 
        class="w-full h-auto object-contain block"
        loading="eager"
        id="thumb-active-${productId}"
        style="display: block; margin: 0;"
      >`;
      
      // Make changes instant
      mainImage.style.transition = "none";
      secondaryImage.style.transition = "none";
      
      mainImage.style.opacity = '1';
      mainImage.style.zIndex = '2';
      secondaryImage.style.opacity = '0';
      secondaryImage.style.zIndex = '1';
    }
  },
  
  // Function for lazy loading high resolution images
  loadHighResImage: function(img) {
    if (img.dataset.highResLoaded) return;
    
    const highResImage = new Image();
    highResImage.src = img.dataset.src;
    
    highResImage.onload = function() {
      img.src = img.dataset.src;
      img.classList.remove('blur-sm');
      img.classList.add('blur-none');
      img.dataset.highResLoaded = true;
    };
  },
  
  // Get product data from cache or parse JSON
  getProductData: function(productId, element) {
    // If we already have it cached, return it
    if (this.productDataCache[productId]) {
      return this.productDataCache[productId];
    }
    
    // Get the product card - use provided element to find the closest card if possible
    let productCard;
    if (element) {
      productCard = element.closest(`[data-product-card="${productId}"]`);
    }
    
    // Fallback to document query if we couldn't find it from the element
    if (!productCard) {
      productCard = document.querySelector(`[data-product-card="${productId}"]`);
    }
    
    if (!productCard) {
      console.error('Could not find product card with ID:', productId);
      return null;
    }
    
    // Get the product data element
    const productDataElem = productCard.querySelector('[data-product-json]');
    if (!productDataElem) {
      console.error('Could not find product data element for product ID:', productId);
      return null;
    }
    
    try {
      // Parse the product data
      const productData = JSON.parse(productDataElem.getAttribute('data-product-json'));
      
      // Cache it for future use
      this.productDataCache[productId] = productData;
      
      return productData;
    } catch (error) {
      console.error('Error parsing product data for product ID:', productId, error);
      return null;
    }
  },
  
  // Function to handle variant selection
  selectVariant: function(button, productId, optionPosition, optionValue) {
    console.log(`Selecting variant for product ${productId}: option ${optionPosition} = ${optionValue}`);
    
    // Get the product card - use button.closest() to ensure we're in the right card
    const productCard = button.closest(`[data-product-card="${productId}"]`);
    if (!productCard) {
      console.error('Could not find product card with ID:', productId);
      return;
    }
    
    // Get the product data - pass the button for context
    const productData = this.getProductData(productId, button);
    if (!productData) return;
    
    // Clear previous selection for this option group - scoped to this product card
    productCard.querySelectorAll(`.variant-button[data-option-position="${optionPosition}"]`).forEach(btn => {
      btn.classList.remove('selected');
      btn.classList.remove('bg-[#D9D9D9]');
    });
    
    // Mark this button as selected
    button.classList.add('selected');
    button.classList.add('bg-[#D9D9D9]');
    
    // Get all current selections for this product - scoped to this product card
    const selections = {};
    productCard.querySelectorAll(`.variant-button.selected`).forEach(selectedBtn => {
      const pos = selectedBtn.getAttribute('data-option-position');
      const val = selectedBtn.getAttribute('data-value');
      selections[`option${pos}`] = val;
    });
    
    console.log(`Current selections for product ${productId}:`, selections);
    
    // Check if all options are selected
    const totalOptions = productData.options.length;
    const allSelected = Object.keys(selections).length === totalOptions;
    
    // Find matching variant
    let matchingVariant = null;
    if (allSelected) {
      // Try to find exact match
      matchingVariant = productData.variants.find(variant => {
        return Object.keys(selections).every(optionKey => {
          const match = variant[optionKey] === selections[optionKey];
          console.log(`Comparing ${optionKey}: ${variant[optionKey]} vs ${selections[optionKey]} = ${match}`);
          return match;
        });
      });
      
      if (matchingVariant) {
        console.log(`Found matching variant for product ${productId}:`, matchingVariant.id);
      } else {
        console.log(`No matching variant found for product ${productId} with selections:`, selections);
      }
    }
    
    if (matchingVariant) {
      // Update variant input
      const variantInput = productCard.querySelector(`input[name="id"]`);
      
      if (variantInput) {
        variantInput.value = matchingVariant.id;
        variantInput.setAttribute('data-selected-variant', matchingVariant.id);
        console.log(`Updated variant input to: ${matchingVariant.id}`);
        
        // Force trigger a change event to ensure any listeners are notified
        const event = new Event('change', { bubbles: true });
        variantInput.dispatchEvent(event);
      } else {
        console.warn(`Could not find variant input for product ${productId}`);
      }
      
      // Update the add to cart button state based on inventory
      const addButton = productCard.querySelector('.add-to-cart-button');
      if (addButton) {
        // Check if the variant is available (has inventory)
        const isAvailable = matchingVariant.available;
        const inventory = matchingVariant.inventory_quantity;
        const inventoryPolicy = matchingVariant.inventory_policy;
        
        console.log(`Variant inventory for ${matchingVariant.id}: ${inventory}, Policy: ${inventoryPolicy}, Available: ${isAvailable}`);
        
        if (isAvailable) {
          // Variant is in stock
          addButton.disabled = false;
          addButton.classList.add('active');
          addButton.classList.remove('out-of-stock');
          addButton.textContent = 'ADD TO CART';
          
          // Add inventory indicator if inventory tracking is enabled and quantity is shown
          if (inventory > 0 && inventory <= 10) {
            const inventoryIndicator = productCard.querySelector('.inventory-indicator') || document.createElement('div');
            inventoryIndicator.className = 'inventory-indicator text-xs mt-1';
            inventoryIndicator.textContent = `Only ${inventory} left`;
            
            // Add the indicator below the add to cart button if it doesn't exist
            if (!productCard.querySelector('.inventory-indicator')) {
              addButton.parentNode.appendChild(inventoryIndicator);
            }
          } else {
            // Remove inventory indicator if quantity is high or not relevant
            const inventoryIndicator = productCard.querySelector('.inventory-indicator');
            if (inventoryIndicator) {
              inventoryIndicator.remove();
            }
          }
          
          console.log(`Enabled add to cart button for product ${productId}`);
        } else {
          // Variant is out of stock
          addButton.disabled = true;
          addButton.classList.remove('active');
          addButton.classList.add('out-of-stock');
          addButton.textContent = 'OUT OF STOCK';
          
          // Remove any existing inventory indicator
          const inventoryIndicator = productCard.querySelector('.inventory-indicator');
          if (inventoryIndicator) {
            inventoryIndicator.remove();
          }
          
          console.log(`Variant out of stock for product ${productId}`);
        }
      }
    } else {
      // Update the button states to disabled if no matching variant
      productCard.querySelectorAll(`.add-to-cart-button`).forEach(btn => {
        if (!productData.has_only_default_variant) {
          btn.disabled = true;
          btn.classList.remove('active');
          
          // Only show "OUT OF STOCK" if all required options are selected
          // but the specific combination is unavailable
          if (Object.keys(selections).length === totalOptions) {
            btn.classList.add('out-of-stock');
            btn.textContent = 'OUT OF STOCK';
          } else {
            btn.classList.remove('out-of-stock');
            btn.textContent = 'ADD TO CART';
          }
          
          console.log(`Disabled add to cart button for product ${productId}`);
          
          // Remove any existing inventory indicator
          const inventoryIndicator = productCard.querySelector('.inventory-indicator');
          if (inventoryIndicator) {
            inventoryIndicator.remove();
          }
        }
      });
    }
  },
  
  // Direct add to cart function that ensures the proper variant ID is used
  addToCart: function(button, productId) {
    console.log(`Adding product ${productId} to cart`);
    
    // Get the form containing the button
    const form = button.closest('form[action="/cart/add"]');
    if (!form) {
      console.error('No form found for add to cart button');
      return false;
    }
    
    // Get the variant ID input
    const variantInput = form.querySelector('input[name="id"]');
    if (!variantInput || !variantInput.value) {
      console.error('No variant ID found in form');
      return false;
    }
    
    // Store original text and class state
    const originalText = button.textContent;
    const wasActive = button.classList.contains('active');
    
    // Get form data and submit with fetch
    const formData = new FormData(form);
    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      if (!response.ok) throw new Error('Add to cart failed');
      return response.json();
    })
    .then(result => {
      // Update cart count
      return fetch('/cart.js');
    })
    .then(response => response.json())
    .then(cart => {
      // Update the cart count display
      const cartCount = document.querySelector('.cart-count');
      if (cartCount) {
        cartCount.textContent = cart.item_count;
        cartCount.style.display = cart.item_count > 0 ? 'block' : 'none';
      }
      
      // Show success state
      button.textContent = 'Added';
      button.classList.remove('active'); // Remove potentially conflicting classes
      button.classList.add('success');
      
      // Reset button after 2 seconds
      setTimeout(() => {
        button.textContent = originalText;
        button.classList.remove('success');
        // Re-add active class if it was active before
        if (wasActive) {
          button.classList.add('active');
        }
      }, 2000);
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      button.textContent = 'Error';
      button.classList.remove('active');
      button.classList.add('error');
      
      setTimeout(() => {
        button.textContent = originalText;
        button.classList.remove('error');
        // Re-add active class if it was active before
        if (wasActive) {
          button.classList.add('active');
        }
      }, 2000);
    });
    
    return false; // Prevent default form submission
  },
  
  // Initialize all product cards when the DOM is loaded
  init: function() {
    console.log('Initializing ProductCard module');
    
    // Set up mobile image toggle functionality
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      const thumbnailButtons = document.querySelectorAll('.product-thumbnail-toggle');
      thumbnailButtons.forEach(button => {
        const primaryImageUrl = button.dataset.primaryImage;
        const secondaryImageUrl = button.dataset.secondaryImage;
        
        if (primaryImageUrl) {
          const preloadPrimary = new Image();
          preloadPrimary.src = primaryImageUrl;
        }
        
        if (secondaryImageUrl) {
          const preloadSecondary = new Image();
          preloadSecondary.src = secondaryImageUrl;
        }
      });
    }
    
    // Set up form submission event listeners to verify variant ID
    document.querySelectorAll('form[action="/cart/add"]').forEach(form => {
      form.addEventListener('submit', function(e) {
        const variantInput = this.querySelector('input[name="id"]');
        if (!variantInput || !variantInput.value) {
          console.error('Preventing form submission: No variant ID found');
          e.preventDefault();
          return false;
        }
        
        console.log(`Submitting form with variant ID: ${variantInput.value}`);
      });
      
      // Add click handler to the Add to Cart button to ensure form has the right variant
      const addButton = form.querySelector('.add-to-cart-button');
      if (addButton) {
        addButton.addEventListener('click', function(e) {
          // Get the parent form
          const form = this.closest('form[action="/cart/add"]');
          if (!form) return;
          
          // Get the product ID from the form's data attribute
          const productId = form.getAttribute('data-product-form');
          if (!productId) return;
          
          // Get the variant input
          const variantInput = form.querySelector('input[name="id"]');
          if (!variantInput) return;
          
          // Log the variant ID that will be submitted
          console.log(`Adding to cart with variant ID: ${variantInput.value} for product: ${productId}`);
          
          // Make sure input has a value and isn't empty
          if (!variantInput.value) {
            e.preventDefault();
            console.error('No variant ID selected');
            return false;
          }
        });
      }
    });
    
    // Pre-select default variants for products with only default variants
    document.querySelectorAll('[data-product-card]').forEach(card => {
      const productId = card.getAttribute('data-product-card');
      const productData = this.getProductData(productId, card);
      
      if (productData && productData.has_only_default_variant) {
        const forms = card.querySelectorAll(`form[data-product-form="${productId}"]`);
        forms.forEach(form => {
          const addButton = form.querySelector('.add-to-cart-button');
          if (addButton) {
            // Check if the default variant is available
            const defaultVariant = productData.variants[0];
            if (defaultVariant && defaultVariant.available) {
              addButton.disabled = false;
              addButton.classList.add('active');
              
              // Show inventory if quantity is low
              if (defaultVariant.inventory_quantity <= 10 && 
                  defaultVariant.inventory_quantity > 0 && 
                  defaultVariant.inventory_management === 'shopify') {
                const inventoryIndicator = document.createElement('div');
                inventoryIndicator.className = 'inventory-indicator text-xs mt-1';
                inventoryIndicator.textContent = `Only ${defaultVariant.inventory_quantity} left`;
                addButton.parentNode.appendChild(inventoryIndicator);
              }
            } else {
              // Default variant is out of stock
              addButton.disabled = true;
              addButton.classList.add('out-of-stock');
              addButton.textContent = 'OUT OF STOCK';
            }
          }
        });
      }
    });
    
    // Set up inventory display for products without variants
    document.querySelectorAll('.stock-status.in-stock').forEach(statusElem => {
      const productCard = statusElem.closest('[data-product-card]');
      if (!productCard) return;
      
      // Make the text smaller and dimmer
      statusElem.style.fontSize = '0.7rem';
      statusElem.style.opacity = '0.8';
    });
  },
  
  // Empty placeholder for checkCardVisibility (overridden to do nothing on mobile)
  checkCardVisibility: function() {
    // This is intentionally empty for mobile - we only want click behavior
    return;
  }
};

// Make ProductCard globally available immediately
window.ProductCard = ProductCard;
window.loadHighResImage = ProductCard.loadHighResImage;
window.toggleProductImages = ProductCard.toggleProductImages;

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  ProductCard.init();
});
</script>

<div class="group relative block text-black {% unless custom_aspect_ratio %}aspect-[3/4]{% endunless %} overflow-visible h-full p-0" data-product-card="{{ unique_id }}">
  <!-- Product link (image only) -->
  <a href="{{ product.url }}" class="block relative w-full h-full overflow-hidden product-card-link" id="product-link-{{ product.id }}" onclick="handleProductCardClick(event, '{{ product.id }}')">
    <!-- First image with LQIP -->
    <img
      class="w-full h-full object-cover md:group-hover:opacity-0 blur-up"
      alt="{{ product.title }}"
      src="{{ first_image | img_url: '100x' }}"
      data-src="{{ first_image | image_url }}"
      srcset="
        {{ first_image | img_url: '100x' }}  100w,
        {{ first_image | img_url: '600x' }} 600w,
        {{ first_image | img_url: '900x' }} 900w,
        {{ first_image | img_url: '1200x' }} 1200w
      "
      sizes="(max-width: 767px) 100vw, 50vw"
      width="{{ first_image.width }}"
      height="{{ first_image.height }}"
      loading="eager"
      style="position: absolute; inset: 0; z-index: 2; opacity: 1; will-change: opacity; transition: none;"
      id="primary-image-{{ product.id }}"
      onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
    >
    <!-- Second image (hover image) with LQIP -->
    <img
      class="absolute inset-0 w-full h-full object-cover opacity-0 md:group-hover:opacity-100 blur-up"
      alt="{{ product.title }} (hover)"
      src="{{ second_image | img_url: '100x' }}"
      data-src="{{ second_image | image_url }}"
      srcset="
        {{ second_image | img_url: '100x' }} 100w,
        {{ second_image | img_url: '600x' }} 600w,
        {{ second_image | img_url: '900x' }} 900w,
        {{ second_image | img_url: '1200x' }} 1200w
      "
      sizes="(max-width: 767px) 100vw, 50vw"
      width="{{ second_image.width }}"
      height="{{ second_image.height }}"
      loading="lazy" 
      style="position: absolute; inset: 0; z-index: 1; opacity: 0; will-change: opacity; transition: none;"
      id="secondary-image-{{ product.id }}"
      onload="this.dataset.loaded = true; if (this.dataset.loaded && !this.dataset.highResLoaded) { this.classList.add('blur-sm'); window.loadHighResImage(this); }"
    >
  </a>
  
  <!-- Secondary image thumbnail (mobile only) -->
  <button 
    class="absolute top-0 right-0 w-auto h-auto max-w-[120px] z-20 overflow-hidden md:hidden product-thumbnail-toggle mobile-hidden" 
    onclick="toggleProductImages(this, event, '{{ product.id }}')"
    data-primary-image="{{ first_image | image_url: width: 240 }}"
    data-secondary-image="{{ second_image | image_url: width: 240 }}"
    style="padding: 0; margin: 0; line-height: 0; top: 20px; right: 0; border: none; background: none;"
    id="thumbnail-toggle-{{ product.id }}">
    <!-- Container for the active thumbnail image -->
    <div id="thumb-container-{{ product.id }}">
      <img 
        src="{{ second_image | image_url: width: 240 }}" 
        alt="{{ product.title }} (alternate)" 
        class="w-full h-auto object-contain block"
        loading="eager"
        width="{{ second_image.width | default: 240 }}"
        height="{{ second_image.height | default: 240 }}"
        id="thumb-active-{{ product.id }}"
        style="display: block; margin: 0;"
      >
    </div>
    
    <!-- Hidden preloaded images - no longer needed since we're using the data-attributes -->
    <div class="hidden">
      <img 
        src="{{ first_image | image_url: width: 240 }}"
        id="thumb-primary-{{ product.id }}"
        loading="eager"
        width="{{ first_image.width | default: 240 }}"
        height="{{ first_image.height | default: 240 }}"
      >
      <img 
        src="{{ second_image | image_url: width: 240 }}"
        id="thumb-secondary-{{ product.id }}"
        loading="eager"
        width="{{ second_image.width | default: 240 }}"
        height="{{ second_image.height | default: 240 }}"
      >
    </div>
  </button>

  <!-- Product info and dropdown container -->
  <div class="absolute bottom-0 left-0 right-0 m-[4px] z-10">
    <!-- Product info bar (always visible) -->
    <div class="product-info-bar relative rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] px-4 py-3 flex justify-between items-center h-[49px]">
      <a href="{{ product.url }}" class="uppercase text-sm tracking-wide text-black">{{ product.title }}</a>
      <div class="text-sm text-black">
        {% if product.available %}
          {{ product.price | money_without_trailing_zeros }}
          {% if product.inventory_quantity <= 10 and product.inventory_quantity > 0 and product.inventory_management == 'shopify' %}
            <span class="stock-status in-stock text-xs ml-2">({{ product.inventory_quantity }} left)</span>
          {% endif %}
        {% else %}
          <span class="stock-status out-of-stock">Sold Out</span>
        {% endif %}
      </div>
    </div>

    <!-- Gap div -->
    <div class="h-[4px]"></div>

    <!-- Hover dropdown (appears below the product info) -->
    <div class="product-dropdown rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] overflow-hidden max-h-0 md:group-hover:opacity-100 md:group-hover:max-h-[500px] mobile-dropdown-hidden">
      <!-- Unified layout for both mobile and desktop -->
      <div class="p-4">
        <!-- Options grid - two columns on mobile, three columns on desktop -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4 md:mb-0">
          <!-- Color options column -->
          <div class="flex flex-col md:flex-row items-start gap-[8px] variant-column -ml-[8px]">
            {% for option in product.options_with_values %}
              {% if option.name == 'Color' %}
                {% for value in option.values %}
                  <button 
                    type="button"
                    class="variant-button color-variant inline-flex justify-center items-center min-w-[30px] min-h-[30px] text-left uppercase text-[13px] text-black px-[5px] py-[2px]" 
                    data-product-id="{{ product.id }}"
                    data-option-position="{{ option.position }}" 
                    data-value="{{ value | escape }}"
                    data-color-value="{{ value | escape }}"
                    onclick="ProductCard.selectVariant(this, '{{ product.id }}', '{{ option.position }}', '{{ value | escape }}')"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
          
          <!-- Size options column -->
          <div class="flex flex-col md:flex-row items-end md:items-center md:justify-center gap-[8px] variant-column">
            {% for option in product.options_with_values %}
              {% if option.name == 'Size' %}
                {% for value in option.values %}
                  <button 
                    type="button"
                    class="variant-button size-variant inline-flex justify-center items-center min-w-[30px] min-h-[30px] text-center uppercase text-[13px] text-black px-[5px] py-[2px]" 
                    data-product-id="{{ product.id }}"
                    data-option-position="{{ option.position }}" 
                    data-value="{{ value | escape }}"
                    onclick="ProductCard.selectVariant(this, '{{ product.id }}', '{{ option.position }}', '{{ value | escape }}')"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
          
          <!-- Add to cart button in its own column on desktop, spans both columns on mobile -->
          {% if product.available %}
            <div class="col-span-2 md:col-span-1 md:flex md:items-start md:justify-end">
              <form action="/cart/add" method="post" class="w-full md:w-auto" data-product-form="{{ product.id }}">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id-{{ product.id }}">
                <input type="hidden" name="quantity" value="1">
                
                {% comment %} Store all product data as a data attribute for quick access {% endcomment %}
                <div 
                  class="hidden" 
                  data-product-json="{{ product | json | escape }}"
                  data-product-id="{{ product.id }}"
                  data-inventory-quantity="{{ product.inventory_quantity }}"
                  data-inventory-management="{{ product.inventory_management }}"
                ></div>
                
                <button type="button" class="w-full md:w-auto bg-neutral-200 text-black text-sm uppercase hover:opacity-60 transition-colors add-to-cart-button py-2 md:py-[2px] md:px-[5px]" {% unless product.has_only_default_variant %}disabled{% endunless %} onclick="ProductCard.addToCart(this, '{{ product.id }}')">
                  {% if product.available %}
                    ADD TO CART
                  {% else %}
                    OUT OF STOCK
                  {% endif %}
                </button>
              </form>
            </div>
          {% else %}
            <div class="col-span-2 md:col-span-1 md:flex md:items-start md:justify-end">
              <button type="button" disabled class="w-full md:w-auto bg-neutral-200 text-black text-sm uppercase py-2 md:py-[2px] md:px-[5px] transition-colors add-to-cart-button out-of-stock">
                OUT OF STOCK
              </button>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Add the handleProductCardClick function
function handleProductCardClick(event, productId) {
  // Check if we're on mobile
  if (window.innerWidth >= 768) return;
  
  // Get the product card
  const productCard = document.querySelector(`[data-product-card="${productId}"]`);
  if (!productCard) return;
  
  // Prevent the default link behavior
  event.preventDefault();
  
  // Check if the card is already expanded
  if (productCard.classList.contains('mobile-expanded')) {
    // Second click - navigate to product page
    window.location.href = event.currentTarget.getAttribute('href');
    return;
  }
  
  // First click - show thumbnail toggle and dropdown
  event.stopPropagation();
  
  // Close any other expanded cards first
  document.querySelectorAll('.mobile-expanded').forEach(card => {
    if (card !== productCard) {
      card.classList.remove('mobile-expanded');
      
      // Hide the thumbnail toggle
      const cardId = card.getAttribute('data-product-card');
      const thumbToggle = document.getElementById(`thumbnail-toggle-${cardId}`);
      if (thumbToggle) {
        thumbToggle.classList.add('mobile-hidden');
      }
      
      // Hide the dropdown
      const dropdown = card.querySelector('.product-dropdown');
      if (dropdown) {
        dropdown.classList.remove('mobile-dropdown-visible');
        dropdown.classList.add('mobile-dropdown-hidden');
      }
    }
  });
  
  // Expand this card
  productCard.classList.add('mobile-expanded');
  
  // Make the thumbnail toggle and dropdown visible
  const thumbnailToggle = document.getElementById(`thumbnail-toggle-${productId}`);
  if (thumbnailToggle) {
    thumbnailToggle.classList.remove('mobile-hidden');
  }
  
  // Make the dropdown visible
  const dropdown = productCard.querySelector('.product-dropdown');
  if (dropdown) {
    dropdown.classList.remove('mobile-dropdown-hidden');
    dropdown.classList.add('mobile-dropdown-visible');
  }
}

// Extend the ProductCard namespace with the new x`functionality
document.addEventListener('DOMContentLoaded', function() {
  // Remove all viewport-based classes on initialization
  document.querySelectorAll('.group').forEach(card => {
    card.classList.remove('card-visible');
    card.classList.remove('card-visible-delayed');
  });

  // Add the mobile click handler to the ProductCard namespace
  ProductCard.handleProductCardClick = handleProductCardClick;
  
  // Function to normalize variant button sizes within a product card
  function normalizeVariantButtonSizes() {
    // Process each product card separately
    document.querySelectorAll('[data-product-card]').forEach(card => {
      // Find the maximum width for color variants
      let maxColorWidth = 0;
      card.querySelectorAll('.color-variant').forEach(btn => {
        // Temporarily remove inline styles for accurate measurement
        const originalStyles = btn.getAttribute('style');
        btn.removeAttribute('style');
        const width = btn.offsetWidth;
        if (width > maxColorWidth) maxColorWidth = width;
        // Restore original styles
        if (originalStyles) btn.setAttribute('style', originalStyles);
      });
      
      // Find the maximum width for size variants
      let maxSizeWidth = 0;
      card.querySelectorAll('.size-variant').forEach(btn => {
        // Temporarily remove inline styles for accurate measurement
        const originalStyles = btn.getAttribute('style');
        btn.removeAttribute('style');
        const width = btn.offsetWidth;
        if (width > maxSizeWidth) maxSizeWidth = width;
        // Restore original styles
        if (originalStyles) btn.setAttribute('style', originalStyles);
      });
      
      // Apply the max widths to all buttons in each column
      if (maxColorWidth > 0) {
        card.querySelectorAll('.color-variant').forEach(btn => {
          btn.style.width = maxColorWidth + 'px';
        });
      }
      
      if (maxSizeWidth > 0) {
        card.querySelectorAll('.size-variant').forEach(btn => {
          btn.style.width = maxSizeWidth + 'px';
        });
      }
    });
  }
  
  // Run the normalization after a small delay to ensure DOM is fully rendered
  setTimeout(normalizeVariantButtonSizes, 100);
  
  // Add a click handler to close expanded cards when clicking outside
  document.addEventListener('click', function(event) {
    // Only on mobile
    if (window.innerWidth >= 768) return;
    
    // Get all expanded cards
    const expandedCards = document.querySelectorAll('.mobile-expanded');
    if (expandedCards.length === 0) return;
    
    // Check if the click was outside of any expanded card
    let clickedOutside = true;
    for (const card of expandedCards) {
      if (card.contains(event.target)) {
        clickedOutside = false;
        break;
      }
    }
    
    // If clicked outside, collapse all expanded cards
    if (clickedOutside) {
      expandedCards.forEach(card => {
        card.classList.remove('mobile-expanded');
        
        // Hide the thumbnail toggle
        const productId = card.getAttribute('data-product-card');
        const thumbnailToggle = document.getElementById(`thumbnail-toggle-${productId}`);
        if (thumbnailToggle) {
          thumbnailToggle.classList.add('mobile-hidden');
        }
        
        // Hide the dropdown
        const dropdown = card.querySelector('.product-dropdown');
        if (dropdown) {
          dropdown.classList.remove('mobile-dropdown-visible');
          dropdown.classList.add('mobile-dropdown-hidden');
        }
      });
    }
  });

  // Modify the selectVariant function to update button styles
  const originalSelectVariant = ProductCard.selectVariant;
  ProductCard.selectVariant = function(button, productId, optionPosition, optionValue) {
    // Call the original function first
    originalSelectVariant.call(this, button, productId, optionPosition, optionValue);
    
    // Get the product card
    const productCard = button.closest(`[data-product-card="${productId}"]`);
    if (!productCard) return;
    
    // Get all selected buttons to ensure they keep their styles
    const allSelectedButtons = productCard.querySelectorAll('.variant-button.selected');
    allSelectedButtons.forEach(btn => {
      // Make sure selected buttons maintain their style
      btn.style.backgroundColor = 'rgba(217, 217, 217, 0.9)';
      btn.style.color = 'black';
      btn.style.fontWeight = '500';
    });
    
    // Clear any inline styles from non-selected buttons to allow hover effects
    const allNonSelectedButtons = productCard.querySelectorAll('.variant-button:not(.selected)');
    allNonSelectedButtons.forEach(btn => {
      btn.style.backgroundColor = '';
      btn.style.color = '';
      btn.style.fontWeight = '';
    });
  };
});
</script>

{% style %}
/* Global secondary image handling */
img#secondary-image-{{ product.id }} {
  visibility: visible !important;
  opacity: 0 !important;
  transition: none !important;
  will-change: opacity !important;
}

/* Only make secondary images visible on hover (desktop) or when toggled (mobile) */
@media (min-width: 768px) {
  .group:hover img#secondary-image-{{ product.id }} {
    opacity: 1 !important;
  }
  
  /* Add delay to dropdown appearance */
  .product-dropdown {
    transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s, 
                max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s,
                visibility 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s !important;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
  }
  
  .group:hover .product-dropdown {
    transition-delay: 0.15s !important;
    visibility: visible;
    opacity: 1;
    max-height: 500px;
  }
}

@media (max-width: 767px) {
  /* Hide card-visible effects */
  .card-visible .product-dropdown,
  .card-visible-delayed .product-dropdown {
    opacity: 0 !important;
    max-height: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
  }
  
  /* Override any viewport-based visibility */
  .card-visible,
  .card-visible-delayed {
    /* Clear any properties that might affect dropdown visibility */
    opacity: 1 !important;
    max-height: none !important;
  }
  
  /* Mobile behavior for card expanded state */
  .mobile-hidden {
    display: none !important;
  }
  
  .group.mobile-expanded .mobile-hidden {
    display: block !important;
  }
  
  .mobile-dropdown-hidden {
    max-height: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
  }
  
  .mobile-dropdown-visible {
    max-height: 500px !important;
    opacity: 1 !important;
    visibility: visible !important;
  }
  
  .product-dropdown {
    max-height: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    overflow: hidden !important;
    transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1), 
                max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
  }
  
  .group.mobile-expanded .product-dropdown.mobile-dropdown-visible {
    opacity: 1 !important;
    max-height: 500px !important;
    visibility: visible !important;
    transition: opacity 0.2s cubic-bezier(0.33, 0.66, 0.66, 1), 
                max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
  }
  
  /* Special handling for side-by-side layout */
  .side-by-side-column .group {
    height: 100%;
  }
  
  .side-by-side-column .group.mobile-expanded {
    position: relative;
    z-index: 100;
  }
  
  .group.images-toggled img#secondary-image-{{ product.id }} {
    opacity: 1 !important;
  }
  
  .product-thumbnail-toggle {
    border-radius: 0;
    transition: transform 0.2s cubic-bezier(0.33, 0.66, 0.66, 1);
    background-color: white;
    z-index: 20;
  }
  
  .product-thumbnail-toggle:active {
    transform: scale(0.95);
  }
  
  /* Make sure both images are absolutely positioned for proper stacking */
  .group a img {
    position: absolute !important;
    inset: 0 !important;
    transition: none !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    will-change: opacity !important;
  }
  
  /* First image (primary) */
  .group a img:first-of-type {
    z-index: 2 !important;
    opacity: 1 !important;
  }
  
  /* Second image (secondary) */
  .group a img:nth-of-type(2) {
    z-index: 1 !important;
    opacity: 0 !important;
    visibility: visible !important;
  }
  
  /* Image toggled state */
  .group.images-toggled a img:first-of-type {
    opacity: 0 !important;
    z-index: 1 !important;
  }
  
  .group.images-toggled a img:nth-of-type(2) {
    opacity: 1 !important;
    z-index: 2 !important;
  }
}

/* Desktop hover effects */
@media (min-width: 768px) {
  .group:hover .md\:group-hover\:opacity-0 {
    opacity: 0 !important;
  }
  
  .group:hover .md\:group-hover\:opacity-100 {
    opacity: 1 !important;
  }
  
  .group:hover .md\:group-hover\:max-h-\[500px\] {
    max-height: 500px !important;
    opacity: 1;
    visibility: visible;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }
  
  /* Ensure secondary images are fully transparent but visible by default */
  .group a img:nth-of-type(2) {
    opacity: 0 !important;
    visibility: visible !important;
  }
  
  .group:hover a img:nth-of-type(2) {
    opacity: 1 !important;
  }
}

/* Variant container and button styles */
.variant-column {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.variant-button {
  transition: all 0.2s ease;
  position: relative;
  border: none;
  outline: none;
  background: transparent;
  cursor: pointer;
  text-align: inherit;
  border-radius: 2px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-width: 30px;
  min-height: 30px;
  width: auto;
  height: auto;
}

.variant-button:hover {
  color: black !important;
  background-color: rgba(217, 217, 217, 0.5) !important;
}

.variant-button.selected {
  background-color: rgba(217, 217, 217, 0.9) !important;
  color: black !important;
  font-weight: 500;
  position: relative;
}

/* Color variant specific styles */
.color-variant {
  justify-content: flex-start;
}

/* Size variant specific styles */
.size-variant {
  justify-content: center;
}

/* Product dropdown styling */
.product-dropdown {
  transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              padding-top 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  max-height: 0;
  opacity: 0;
  visibility: hidden;
  overflow: hidden;
  padding-top: 0;
}

.group:hover .product-dropdown {
  max-height: 500px;
  opacity: 1;
  visibility: visible;
  padding-top: 4px;
}

/* Add to cart button styling */
.add-to-cart-button {
  transition: all 0.2s ease;
  border-radius: 1px;
  height: 33px;
  min-height: 33px;
}

/* Active state for add to cart button (when variants are selected) */
.add-to-cart-button.active {
  background-color: #444444 !important;
  color: white !important;
}

/* Out of stock state for add to cart button */
.add-to-cart-button.out-of-stock {
  background-color: #9C9C9C !important;
  color: white !important;
  cursor: not-allowed;
  opacity: 0.8 !important;
}

/* Inventory indicator styling */
.inventory-indicator {
  color: black;
  font-size: 0.75rem;
  text-align: center;
  margin-top: 0.25rem;
  font-weight: 500;
}

/* Stock status styling in product info bar */
.stock-status {
  font-size: 0.75rem;
  font-weight: 500;
  color: black;
}

.stock-status.in-stock {
  color: black;
}

.stock-status.out-of-stock {
  color: black;
}

/* Success state (already defined but included for consistency) */
.add-to-cart-button.success {
  background-color: #4CAF50 !important;
  color: white !important;
}

/* Error state (already defined but included for consistency) */
.add-to-cart-button.error {
  background-color: #F44336 !important;
  color: white !important;
}

/* Desktop-specific styles for horizontal layout */
@media (min-width: 768px) {
  .variant-column {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 4px;
  }
  
  /* Adjust variant button sizes for desktop */
  .variant-button {
    margin: 0;
    height: 24px;
    min-height: 24px;
  }
  
  /* Color variant buttons */
  .color-variant {
    padding: 0 8px;
    min-width: auto;
    white-space: nowrap;
  }
  
  /* Size variant buttons */
  .size-variant {
    width: 24px;
    min-width: 24px;
    padding: 0;
    justify-content: center;
  }
  
  /* Add to cart button */
  .add-to-cart-button {
    height: 24px;
    min-height: 24px;
    white-space: nowrap;
    width: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
}

/* Product dropdown gap styling */
.product-dropdown-gap {
  transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  overflow: hidden;
}

@media (max-width: 767px) {
  .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-hidden {
    max-height: 0 !important;
  }
  
  .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-visible {
    max-height: 4px !important;
  }
}
