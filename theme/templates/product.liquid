<style>
  /* Custom scrollbar styling */
  /* This targets the entire scrollbar area in WebKit browsers (Chrome, Safari) */
  .custom-scrollbar::-webkit-scrollbar {
    width: 3px;
  }

  /* This targets the track (the background line) of the scrollbar */
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #e0e0e0; /* Sets the track to a light gray color */
  }

  /* This targets the thumb (the draggable part) of the scrollbar */
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #666666; /* Sets the thumb to a darker gray */
    border-radius: 0; /* Removes any rounded corners from the thumb */
  }

  /* This hides the up and down arrow buttons */
  .custom-scrollbar::-webkit-scrollbar-button {
    display: none;
  }

  /* This provides similar styling for Firefox */
  /* .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #666666 #e0e0e0;
    display: block;
  } */
  
  /* .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  } */
  
  /* .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(68, 68, 68, 0.3);
    border-radius: 3px;
  } */

  /* TODO: color chips style */
  .color-chip {
    width: 22px;
    height: 14px;
    border-radius: 5%;
    border: 1px solid #d1d5db;
    cursor: pointer;
    outline: none;
    opacity: 1;
  }

  .color-chip-container {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .color-chip-container:hover,
  .color-chip-container.active {
    border-bottom-color: #000;
  }

  .color-chip-container.disabled:hover {
    border-bottom-color: transparent;
  }

  .color-chip-container.active .color-chip {
    pointer-events: none;
    cursor: default;
  }

  /* fallback for disabled color chips */
  .color-chip[disabled],
