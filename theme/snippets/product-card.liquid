    initPage() {
      // Run once per page
      document.querySelectorAll('[data-product-card]').forEach(card => {
        this.initCard(card);
      });
    },

    initCard(card) {
      const productId = card.getAttribute('data-product-card');
      const productData = this.getProductData(productId, card);

      if (!productData) return;

      // 1. Pre-select first available variant
      const defaultVariant = productData.variants.find(v => v.available) || productData.variants[0];

      if (defaultVariant) {
        const variantImages = this.getImagesForVariant(defaultVariant, productData.images);
        this.updateCardImages(productId, variantImages);

        // Mark the correct color chip active
        // const colorChip = card.querySelector(
        //   `.color-chip[data-option-value="${defaultVariant.option1}"]`
        // );
        // if (colorChip) {
        //   card.querySelectorAll('.color-chip').forEach(chip => chip.classList.remove('active'));
        //   colorChip.classList.add('active');
        // }
      }

      // 2. Handle has_only_default_variant edge case
      if (productData.has_only_default_variant) {
        const forms = card.querySelectorAll(`form[data-product-form="${productId}"]`);
          forms.forEach(form => {
            const addButton = form.querySelector('.add-to-cart-button');
            if (addButton) {
              // Check if the default variant is available
              const defaultVariant = productData.variants[0];
              if (defaultVariant && defaultVariant.available) {
                addButton.disabled = false;
                addButton.classList.add('active');
                
                // Show inventory if quantity is low
                if (defaultVariant.inventory_quantity <= 10 && 
                    defaultVariant.inventory_quantity > 0 && 
                    defaultVariant.inventory_management === 'shopify') {
                  const inventoryIndicator = document.createElement('div');
                  inventoryIndicator.className = 'inventory-indicator text-xs mt-1';
                  inventoryIndicator.textContent = `Only ${defaultVariant.inventory_quantity} left`;
                  addButton.parentNode.appendChild(inventoryIndicator);
                }
              } else {
                // Default variant is out of stock
                addButton.disabled = true;
                addButton.classList.add('out-of-stock');
                addButton.textContent = 'OUT OF STOCK';
              }
            }
          });
      }

      // 3. Bind events for this card (color chips, size buttons, etc.)
      this.bindEvents(card, productId, productData);
    },

    bindEvents(card, productId, productData) {
      // color chips
      card.querySelectorAll('.color-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          console.log("chip option value",chip.dataset.optionValue)
          // this.selectVariant(chip, productId, productData, { option1: chip.dataset.optionValue });
          this.selectVariant(chip, productId, 1, chip.dataset.optionValue);
        });
      });

      // TODO: add size button events if needed
    },

    
    // Empty placeholder for checkCardVisibility (overridden to do nothing on mobile)
    checkCardVisibility: function() {
      // This is intentionally empty for mobile - we only want click behavior
      return;
    }


  };

  // Make ProductCardObject globally available immediately
  // window.ProductCardObject = ProductCardObject;
  // window.loadHighResImage = ProductCardObject.loadHighResImage;
  window.toggleProductImages = ProductCardObject.toggleProductImages;

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    ProductCardObject.initPage();
  });
</script>

<div class="group relative flex flex-col text-black {% if custom_aspect_ratio %}h-full{% endif %} overflow-visible " data-product-card="{{ unique_id }}">
  <!-- Hidden product data for JavaScript -->
  <div class="hidden" data-product-json='{"id":{{ product.id }},"variants":{{ product.variants | json }},"images":{{ product.images | json }},"options":{{ product.options_with_values | json }},"has_only_default_variant":{{ product.has_only_default_variant | json }}}'></div>

  <!-- Product link (image only) -->
  <a href="{{ product.url }}" class="block relative w-full overflow-hidden product-card-link {% if custom_aspect_ratio %}flex-grow{% endif %}" id="product-link-{{ product.id }}" {% unless custom_aspect_ratio %}style="aspect-ratio: {{ first_image.aspect_ratio | default: 1.0 }};"{% endunless %} onclick="handleProductCardClick(event, '{{ product.id }}')">
    <!-- First image with LQIP -->
     {% comment %} blur-up {% endcomment %}
    {% comment %} <img
      id="primary-image-{{ product.id }}"
      class="relative h-full object-contain md:group-hover:opacity-0"
      alt="{{ product.title }}"
      src="{{ first_image | image_url: width: 400 }}"
      data-src="{{ first_image | image_url: width: 900 }}"
      sizes="(max-width: 767px) 50vw, 20vw"
      width="{{ first_image.width }}"
      height="{{ first_image.height }}"
      loading="eager"
      onload="if (!this.dataset.highResLoaded) window.loadHighResImage(this);"
      style="position: relative; z-index: 2; opacity: 1; will-change: opacity; transition: none;"
    > {% endcomment %}
    <img
      id="primary-image-{{ product.id }}"
      class="relative h-full object-contain md:group-hover:opacity-0"
      alt="{{ product.title }}"
      src="{{ first_image | image_url: width: 400 }}"
      srcset="
        {{ first_image | image_url: width: 900 }} 900w,
        {{ first_image | image_url: width: 1200 }} 1200w
      "
      sizes="(max-width: 767px) 50vw, 20vw"
      loading="eager"
      width="{{ first_image.width }}"
      height="{{ first_image.height }}"
    >
    <!-- Second image (hover image) with LQIP -->
     {% comment %} blur-up {% endcomment %}
    {% comment %} <img
      id="secondary-image-{{ product.id }}"
      class="absolute inset-0 h-full w-auto mx-auto object-contain opacity-0 md:group-hover:opacity-100"
      alt="{{ product.title }} (hover)"
      src="{{ second_image | image_url: width: 100 }}"
      data-src="{{ second_image | image_url: width: 900  }}"
      sizes="(max-width: 767px) 50vw, 20vw"
      width="{{ second_image.width }}"
      height="{{ second_image.height }}"
      loading="lazy" 
      onload="if (!this.dataset.highResLoaded) window.loadHighResImage(this);"
      style="position: absolute; inset: 0; z-index: 1; opacity: 0; will-change: opacity; transition: none;"
    > {% endcomment %}
    <img
      id="secondary-image-{{ product.id }}"
      class="absolute inset-0 h-full w-auto mx-auto object-contain opacity-0 md:group-hover:opacity-100"
      alt="{{ product.title }}"
      src="{{ second_image | image_url: width: 400 }}"
      srcset="
        {{ second_image | image_url: width: 900 }} 900w,
        {{ second_image | image_url: width: 1200 }} 1200w
      "
      sizes="(max-width: 767px) 50vw, 20vw"
      loading="eager"
      width="{{ second_image.width }}"
      height="{{ second_image.height }}"
    >
  </a>
  
  <!-- Secondary image thumbnail (mobile only) -->
  <button 
    class="absolute top-0 right-0 w-auto h-auto max-w-[120px] z-20 overflow-hidden md:hidden product-thumbnail-toggle mobile-hidden" 
    onclick="toggleProductImages(this, event, '{{ product.id }}')"
    data-primary-image="{{ first_image | image_url: width: 240 }}"
    data-secondary-image="{{ second_image | image_url: width: 240 }}"
    style="padding: 0; margin: 0; line-height: 0; top: 20px; right: 0; border: none; background: none;"
    id="thumbnail-toggle-{{ product.id }}">
    <!-- Container for the active thumbnail image -->
    <div id="thumb-container-{{ product.id }}">
      <img 
        src="{{ second_image | image_url: width: 100 }}"
        alt="{{ product.title }} (alternate)" 
        class="w-full h-auto object-contain block"
        loading="eager"
        width="{{ second_image.width | default: 240 }}"
        height="{{ second_image.height | default: 240 }}"
        id="thumb-active-{{ product.id }}"
        style="display: block; margin: 0;"
      >
    </div>
  </button>

  <!-- Product info and dropdown container -->
  <div class="relative z-10">
    <!-- Product info bar (always visible) -->
    {% comment %} TODO: edit height (was 49px) {% endcomment %}
    <div class="product-info-bar relative rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] px-4 py-3">

      <!-- Row 1: Title and Price -->
      <div class="flex justify-between items-center mb-1">
        <a href="{{ product.url }}" class="uppercase text-xs text-black tracking-wide">{{ product.title }}</a>
        <div class="text-xs text-black">
          {% if product.available %}
            {{ product.price | money_without_trailing_zeros }}
            {% if product.inventory_quantity <= 10 and product.inventory_quantity > 0 and product.inventory_management == 'shopify' %}
              <span class="stock-status in-stock text-sm ml-2">({{ product.inventory_quantity }} left)</span>
            {% endif %}
          {% else %}
            <span class="stock-status out-of-stock">Sold Out</span>
          {% endif %}
        </div>
      </div>
      <!-- Row 2: Color Chips -->
      <div class="flex items-center gap-1 pt-2">
        {%- for option in product.options_with_values -%} <!--  -->
          {%- if option.name == 'Color' -%}
            {%- for value in option.values -%} <!-- COLOR OPTION NAMES eg. Mustard, Carbon/Stripe etc. --> 
            {%- assign variant_for_color = null -%}
              {%- for variant in product.variants -%} <!-- ALL PRODUCT VARIANT TITLES eg. Mustard1, Mustard2 etc. -->
                {%- if variant.options contains value -%} <!-- variant title will contain color name, usually 1st variant category -->
                  {%- assign variant_for_color = variant -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if variant_for_color  -%}
                {%- assign is_selected = false -%}

                {%- comment -%} Check if the currently selected variant has the same color as this chip {%- endcomment -%}
                {%- if product.selected_or_first_available_variant.options contains value -%}
                  {%- assign is_selected = true -%}
                {%- endif -%}

                {% comment %} <div class="color-chip-container{% if is_selected %} active{% endif %}">
                  <button
                    class="color-chip"
                    data-option-position="1" 
                    data-value="{{ value }}"
                    onclick="ProductCardObject.selectVariant(this, '{{ product.id }}', 1, '{{ value }}')"
                    style="background-color: {{ value.swatch.color }};"
                    aria-label="Select color {{ value }}"
                  ></button>
                </div> {% endcomment %}
                {%- assign has_image = variant_for_color.featured_image -%}
                <div class="color-chip-container{% if is_selected %} active{% endif %}{% unless has_image %} disabled{% endunless %}">
                  <button
                    type="button"
                    class="color-chip"
                    style="background-color: {{ value.swatch.color }};{% unless has_image %}opacity: 0.5;{% endunless %}"
                    data-color-name="{{ value | escape }}"
                    data-option-position="1" 
                    data-value="{{ value }}"
                    {% if has_image  %}
                      onclick="ProductCardObject.selectVariant(this, '{{ product.id }}', 1, '{{ value }}')"
                      aria-disabled="false"
                    {% else %}
                      disabled aria-disabled="true"
                    {% endif %}
                    aria-label="Select color {{ value | escape }}"
                  ></button>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  // Add the handleProductCardClick function
  function handleProductCardClick(event, productId) {
    // Check if we're on mobile
    if (window.innerWidth >= 768) return;
    
    // Get the product card
    const productCardElement = document.querySelector(`[data-product-card="${productId}"]`);
    if (!productCardElement) return;
    
    // Prevent the default link behavior
    event.preventDefault();
    
    // Check if the card is already expanded
    if (productCardElement.classList.contains('mobile-expanded')) {
      // Second click - navigate to product page
      window.location.href = event.currentTarget.getAttribute('href');
      return;
    }
    
    // First click - show thumbnail toggle and dropdown
    event.stopPropagation();
    
    // Close any other expanded cards first
    document.querySelectorAll('.mobile-expanded').forEach(card => {
      if (card !== productCardElement) {
        card.classList.remove('mobile-expanded');
        
        // Hide the thumbnail toggle
        const cardId = card.getAttribute('data-product-card');
        const thumbToggle = document.getElementById(`thumbnail-toggle-${cardId}`);
        if (thumbToggle) {
          thumbToggle.classList.add('mobile-hidden');
        }
        
        // Hide the dropdown
        const dropdown = card.querySelector('.product-dropdown');
        if (dropdown) {
          dropdown.classList.remove('mobile-dropdown-visible');
          dropdown.classList.add('mobile-dropdown-hidden');
        }
      }
    });
    
    // Expand this card
    productCardElement.classList.add('mobile-expanded');
    
    // Make the thumbnail toggle and dropdown visible
    const thumbnailToggle = document.getElementById(`thumbnail-toggle-${productId}`);
    if (thumbnailToggle) {
      thumbnailToggle.classList.remove('mobile-hidden');
    }
    
    // Make the dropdown visible
    const dropdown = productCardElement.querySelector('.product-dropdown');
    if (dropdown) {
      dropdown.classList.remove('mobile-dropdown-hidden');
      dropdown.classList.add('mobile-dropdown-visible');
    }
  }

  // Extend the ProductCardObject namespace with the new x`functionality
  document.addEventListener('DOMContentLoaded', function() {
    // Remove all viewport-based classes on initialization
    document.querySelectorAll('.group').forEach(card => {
      card.classList.remove('card-visible');
      card.classList.remove('card-visible-delayed');
    });

    // Add the mobile click handler to the ProductCardObject namespace
    ProductCardObject.handleProductCardClick = handleProductCardClick;
    
    // Function to normalize variant button sizes within a product card
    function normalizeVariantButtonSizes() {
      // Process each product card separately
      document.querySelectorAll('[data-product-card]').forEach(card => {
        // Find the maximum width for color variants
        let maxColorWidth = 0;
        card.querySelectorAll('.color-variant').forEach(btn => {
          // Temporarily remove inline styles for accurate measurement
          const originalStyles = btn.getAttribute('style');
          btn.removeAttribute('style');
          const width = btn.offsetWidth;
          if (width > maxColorWidth) maxColorWidth = width;
          // Restore original styles
          if (originalStyles) btn.setAttribute('style', originalStyles);
        });
        
        // Find the maximum width for size variants
        let maxSizeWidth = 0;
        card.querySelectorAll('.size-variant').forEach(btn => {
          // Temporarily remove inline styles for accurate measurement
          const originalStyles = btn.getAttribute('style');
          btn.removeAttribute('style');
          const width = btn.offsetWidth;
          if (width > maxSizeWidth) maxSizeWidth = width;
          // Restore original styles
          if (originalStyles) btn.setAttribute('style', originalStyles);
        });
        
        // Apply the max widths to all buttons in each column
        if (maxColorWidth > 0) {
          card.querySelectorAll('.color-variant').forEach(btn => {
            btn.style.width = maxColorWidth + 'px';
          });
        }
        
        if (maxSizeWidth > 0) {
          card.querySelectorAll('.size-variant').forEach(btn => {
            btn.style.width = maxSizeWidth + 'px';
          });
        }
      });
    }
    
    // Run the normalization after a small delay to ensure DOM is fully rendered
    setTimeout(normalizeVariantButtonSizes, 100);
    
    // Add a click handler to close expanded cards when clicking outside
    document.addEventListener('click', function(event) {
      // Only on mobile
      if (window.innerWidth >= 768) return;
      
      // Get all expanded cards
      const expandedCards = document.querySelectorAll('.mobile-expanded');
      if (expandedCards.length === 0) return;
      
      // Check if the click was outside of any expanded card
      let clickedOutside = true;
      for (const card of expandedCards) {
        if (card.contains(event.target)) {
          clickedOutside = false;
          break;
        }
      }
      
      // If clicked outside, collapse all expanded cards
      if (clickedOutside) {
        expandedCards.forEach(card => {
          card.classList.remove('mobile-expanded');
          
          // Hide the thumbnail toggle
          const productId = card.getAttribute('data-product-card');
          const thumbnailToggle = document.getElementById(`thumbnail-toggle-${productId}`);
          if (thumbnailToggle) {
            thumbnailToggle.classList.add('mobile-hidden');
          }
          
          // Hide the dropdown
          const dropdown = card.querySelector('.product-dropdown');
          if (dropdown) {
            dropdown.classList.remove('mobile-dropdown-visible');
            dropdown.classList.add('mobile-dropdown-hidden');
          }
        });
      }
    });

    // Modify the selectVariant function to update button styles
    const originalSelectVariant = ProductCardObject.selectVariant;
    ProductCardObject.selectVariant = function(button, productId, optionPosition, optionValue) {
      // Call the original function first
      originalSelectVariant.call(this, button, productId, optionPosition, optionValue);
      
      // Get the product card
      const productCardElement = button.closest(`[data-product-card="${productId}"]`);
      if (!productCardElement) return;
      
      // Get all selected buttons to ensure they keep their styles
      const allSelectedButtons = productCardElement.querySelectorAll('.variant-button.selected');
      allSelectedButtons.forEach(btn => {
        // Make sure selected buttons maintain their style
        btn.style.backgroundColor = 'rgba(217, 217, 217, 0.9)';
        btn.style.color = 'black';
        btn.style.fontWeight = '500';
      });
      
      // Clear any inline styles from non-selected buttons to allow hover effects
      const allNonSelectedButtons = productCardElement.querySelectorAll('.variant-button:not(.selected)');
      allNonSelectedButtons.forEach(btn => {
        btn.style.backgroundColor = '';
        btn.style.color = '';
        btn.style.fontWeight = '';
      });
    };

    // New click handler for product card color chips
    document.addEventListener('click', function(event) {
      const chip = event.target.closest('.color-chip');
      const productCardElement = event.target.closest('[data-product-card]');

      if (!chip || !productCardElement) {
        return;
      }

      // We are inside a product card and clicked a color chip.
      event.stopPropagation(); // Prevent other click handlers on the card.

      // Handle active state
      const allChipContainers = productCardElement.querySelectorAll('.color-chip-container');
      allChipContainers.forEach(container => container.classList.remove('active'));
      chip.closest('.color-chip-container').classList.add('active');
    });
  });
</script>

{% style %}
  /* Global secondary image handling */
  img#secondary-image-{{ product.id }} {
    visibility: visible !important;
    opacity: 0 !important;
    transition: none !important;
    will-change: opacity !important;
  }

  /* Only make secondary images visible on hover (desktop) or when toggled (mobile) */
  @media (min-width: 768px) {
    .group:hover img#secondary-image-{{ product.id }} {
      opacity: 1 !important;
    }
    
    /* Add delay to dropdown appearance */
    .product-dropdown {
      transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s, 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s,
                  visibility 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s !important;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      visibility: hidden;
    }
    
    .group:hover .product-dropdown {
      transition-delay: 0.15s !important;
      visibility: visible;
      opacity: 1;
      max-height: 500px;
    }
  }

  @media (max-width: 767px) {
    /* Hide card-visible effects */
    .card-visible .product-dropdown,
    .card-visible-delayed .product-dropdown {
      opacity: 0 !important;
      max-height: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
    }
    
    /* Override any viewport-based visibility */
    .card-visible,
    .card-visible-delayed {
      /* Clear any properties that might affect dropdown visibility */
      opacity: 1 !important;
      max-height: none !important;
    }
    
    /* Mobile behavior for card expanded state */
    .mobile-hidden {
      display: none !important;
    }
    
    .group.mobile-expanded .mobile-hidden {
      display: block !important;
    }
    
    .mobile-dropdown-hidden {
      max-height: 0 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
    }
    
    .mobile-dropdown-visible {
      max-height: 500px !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    
    .product-dropdown {
      max-height: 0 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
      transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1), 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
    }
    
    .group.mobile-expanded .product-dropdown.mobile-dropdown-visible {
      opacity: 1 !important;
      max-height: 500px !important;
      visibility: visible !important;
      transition: opacity 0.2s cubic-bezier(0.33, 0.66, 0.66, 1), 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
    }
    
    /* Special handling for side-by-side layout */
    .side-by-side-column .group {
      height: 100%;
    }
    
    .side-by-side-column .group.mobile-expanded {
      position: relative;
      z-index: 100;
    }
    
    .group.images-toggled img#secondary-image-{{ product.id }} {
      opacity: 1 !important;
    }
    
    .product-thumbnail-toggle {
      border-radius: 0;
      transition: transform 0.2s cubic-bezier(0.33, 0.66, 0.66, 1);
      background-color: white;
      z-index: 20;
    }
    
    .product-thumbnail-toggle:active {
      transform: scale(0.95);
    }
    
    /* Make sure both images are absolutely positioned for proper stacking */
    .group a img {
      position: absolute !important;
      inset: 0 !important;
      transition: none !important;
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
      will-change: opacity !important;
    }
    
    /* First image (primary) */
    .group a img:first-of-type {
      z-index: 2 !important;
      opacity: 1 !important;
    }
    
    /* Second image (secondary) */
    .group a img:nth-of-type(2) {
      z-index: 1 !important;
      opacity: 0 !important;
      visibility: visible !important;
    }
    
    /* Image toggled state */
    .group.images-toggled a img:first-of-type {
      opacity: 0 !important;
      z-index: 1 !important;
    }
    
    .group.images-toggled a img:nth-of-type(2) {
      opacity: 1 !important;
      z-index: 2 !important;
    }
  }

  /* Desktop hover effects */
  @media (min-width: 768px) {
    .group:hover .md\:group-hover\:opacity-0 {
      opacity: 0 !important;
    }
    
    .group:hover .md\:group-hover\:opacity-100 {
      opacity: 1 !important;
    }
    
    .group:hover .md\:group-hover\:max-h-\[500px\] {
      max-height: 500px !important;
      opacity: 1;
      visibility: visible;
      transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    
    /* Ensure secondary images are fully transparent but visible by default */
    .group a img:nth-of-type(2) {
      opacity: 0 !important;
      visibility: visible !important;
    }
    
    .group:hover a img:nth-of-type(2) {
      opacity: 1 !important;
    }
  }

  /* Variant container and button styles */
  .variant-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .variant-button {
    transition: all 0.2s ease;
    position: relative;
    border: none;
    outline: none;
    background: transparent;
    cursor: pointer;
    text-align: inherit;
    border-radius: 2px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 30px;
    min-height: 30px;
    width: auto;
    height: auto;
  }

  .variant-button:hover {
    color: black !important;
    background-color: rgba(217, 217, 217, 0.5) !important;
  }

  .variant-button.selected {
    background-color: rgba(217, 217, 217, 0.9) !important;
    color: black !important;
    font-weight: 500;
    position: relative;
  }

  /* Color variant specific styles */
  .color-variant {
    justify-content: flex-start;
  }

  /* Size variant specific styles */
  .size-variant {
    justify-content: center;
  }

  /* Product dropdown styling */
  .product-dropdown {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                padding-top 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    padding-top: 0;
  }

  .group:hover .product-dropdown {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    padding-top: 4px;
  }

  /* Add to cart button styling */
  .add-to-cart-button {
    transition: all 0.2s ease;
    border-radius: 1px;
    height: 33px;
    min-height: 33px;
  }

  /* Active state for add to cart button (when variants are selected) */
  .add-to-cart-button.active {
    background-color: #444444 !important;
    color: white !important;
  }

  /* Out of stock state for add to cart button */
  .add-to-cart-button.out-of-stock {
    background-color: #9C9C9C !important;
    color: white !important;
    cursor: not-allowed;
    opacity: 0.8 !important;
  }

  /* Inventory indicator styling */
  .inventory-indicator {
    color: black;
    font-size: 0.75rem;
    text-align: center;
    margin-top: 0.25rem;
    font-weight: 500;
  }

  /* Stock status styling in product info bar */
  .stock-status {
    font-size: 0.75rem;
    font-weight: 500;
    color: black;
  }

  .stock-status.in-stock {
    color: black;
  }

  .stock-status.out-of-stock {
    color: black;
  }

  /* Success state (already defined but included for consistency) */
  .add-to-cart-button.success {
    background-color: #4CAF50 !important;
    color: white !important;
  }

  /* Error state (already defined but included for consistency) */
  .add-to-cart-button.error {
    background-color: #F44336 !important;
    color: white !important;
  }

  /* Desktop-specific styles for horizontal layout */
  @media (min-width: 768px) {
    .variant-column {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 4px;
    }
    
    /* Adjust variant button sizes for desktop */
    .variant-button {
      margin: 0;
      height: 24px;
      min-height: 24px;
    }
    
    /* Color variant buttons */
    .color-variant {
      padding: 0 8px;
      min-width: auto;
      white-space: nowrap;
    }
    
    /* Size variant buttons */
    .size-variant {
      width: 24px;
      min-width: 24px;
      padding: 0;
      justify-content: center;
    }
    
    /* Add to cart button */
    .add-to-cart-button {
      height: 24px;
      min-height: 24px;
      white-space: nowrap;
      width: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  /* Product dropdown gap styling */
  .product-dropdown-gap {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-hidden {
      max-height: 0 !important;
    }
    
    .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-visible {
      max-height: 4px !important;
    }
  }

  /* TODO: color chips style */
  .color-chip {
    width: 16px;
    height: 10px;
    border-radius: 5%;
    border: 1px solid #d1d5db;
    cursor: pointer;
    outline: none;
    opacity: 1;
  }

  /* .color-chip[disabled],
  .color-chip[aria-disabled="true"] {
    pointer-events: none !important;
  } */

  .color-chip-container {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .color-chip-container:hover,
  .color-chip-container.active {
    border-bottom-color: #000; /* Show black underline on hover */
  }

  .color-chip-container.disabled:hover {
    border-bottom-color: transparent;
  }

  .color-chip-container.active .color-chip {
    pointer-events: none;
    cursor: default;
  }

  /* fallback for disabled color chips */
  .color-chip[disabled],
  .color-chip[aria-disabled="true"] {
    pointer-events: none !important;
    /* opacity: 0.5 !important; */
  }
{% endstyle %}