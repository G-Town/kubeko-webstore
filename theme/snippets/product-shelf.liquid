<div
  {% if type %}
    id="more-collection-products"
  {% endif %}
>
  <div class="mb-[9px] flex justify-between items-center">
    {% if type %}
      <p class="page-title	">Discover More</p>

      {% if products.size >= 4 %}
        <a class="cta hidden sm:block" href="/collections/all?filter.p.product_type={{type}}">View More</a>
      {% endif %}

    {% else %}
      <p>{{ title }}</p>
    {% endif %}
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-[15px]">
    {%- for product in products -%}
      {% if type %}
        <div class="hidden product-card" data-product-id="{{ product.id }}">
          {% render 'product-card', product: product %}
        </div>
      {% else %}
        {% render 'product-card', product: product %}
      {% endif %}
    {%- endfor -%}
  </div>

  {% comment %}
    {% if type and products.size >= 4 %}
      <a href="/collections/all?filter.p.product_type={{type}}" class="sm:hidden">
        <div class="border sm:border-[.5px] mt-[21px] w-full border-black h-[38px] flex items-center justify-center">
          <p class="cta">Shop all {{ type }}</p>
        </div>
      </a>
    {% endif %}
  {% endcomment %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var currentProductId = {{ current_id }}; // Use the current_id from Liquid
    var productCards = document.querySelectorAll('.product-card'); // Get all product cards
    var productArray = Array.from(productCards); // Convert NodeList to Array

    console.log(productArray, "array")

    // Filter out the product that matches the current_id
    var filteredProducts = productArray.filter(function(productCard) {
      return productCard.getAttribute('data-product-id') !== currentProductId.toString();
    });

    // Shuffle the array (Fisher-Yates Shuffle Algorithm)
    function shuffle(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]]; // Swap
      }
      return array;
    }

    // Shuffle the filtered products
    var shuffledProducts = shuffle(filteredProducts);

    // Show only 4 random products
    shuffledProducts.slice(0, 4).forEach(function(productCard) {
      productCard.classList.remove('hidden'); // Remove hidden class to display the product
    });
  });
</script>
