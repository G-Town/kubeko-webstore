      updateAllImages(images, activeIndex) {
        const leftUrl  = images[0];
        const rightUrl = images[1];
        const galleryUrls = images.slice(2);

        this._replaceLeftHero(leftUrl);

        this._syncGalleryLength(galleryUrls);

        const rightEls = this._getRightSideElements(); // hero + gallery img nodes
        const rightSeqUrls = [rightUrl, ...galleryUrls];

        // Update active right-side element first
        this._replaceRightImage(rightEls[activeIndex], rightSeqUrls[activeIndex]);

        // Update the rest
        for (let i = 0; i < rightSeqUrls.length; i++) {
          if (i === activeIndex) continue; // skip active one
          this._replaceRightImage(rightEls[i], rightSeqUrls[i]);
        }
      }

      _replaceLeftHero(url) {
        const leftEl = document.getElementById('left-hero');
        if (!leftEl || !url) return;

        const srcsetStr = this._buildSrcset(url);
        const sizesStr = '(max-width: 767px) 100vw, 35vw';
        const lqip = this._buildSizedUrl(url, 100);

        leftEl.removeAttribute('srcset');
        leftEl.removeAttribute('sizes');
        leftEl.src = lqip;

        // Preload the chosen candidate via an off-DOM Image using same srcset decision (use 600 as mid)
        const tmp = new Image();
        tmp.src = this._buildSizedUrl(url, 1200);
        tmp.srcset = srcsetStr;
        tmp.sizes = sizesStr;
        tmp.onload = () => {
          leftEl.srcset = srcsetStr;
          leftEl.sizes = sizesStr;
        };
      }

      _replaceRightImage(el, url, { preloadWidth = 600 } = {}) {
        if (!el || !url) return;

        const srcsetStr = this._buildSrcset(url);
        const sizesStr = '(max-width: 767px) 100vw, 35vw';
        const tmp = new Image();

        tmp.src = this._buildSizedUrl(url, preloadWidth);
        tmp.srcset = srcsetStr;
        tmp.sizes = sizesStr;

        tmp.onload = () => {
          el.src = tmp .src;
          el.srcset = srcsetStr;
          el.sizes = sizesStr;
        };
      }

      _getRightSideElements() {
        const hero = document.getElementById('right-hero');
        const galleryEls = Array.from(document
          .getElementById('right-gallery-rest')
          .querySelectorAll('img'));
        return [hero, ...galleryEls];
      }

      _syncGalleryLength(galleryUrls = []) {
        const restContainer = document.getElementById('right-gallery-rest');
        if (!restContainer) return;

        const existing = Array.from(restContainer.querySelectorAll('img'));
        const needed = galleryUrls.length;

        // Append missing ones
        for (let i = existing.length; i < needed; i++) {
          const url = galleryUrls[i];
          const img = document.createElement('img');
          img.className = 'object-contain w-full h-full snap-center';
          img.loading = 'lazy';
          img.decoding = 'async';

          img.src = this._buildSizedUrl(url, 400);
          img.srcset = this._buildSrcset(url);
          img.sizes = '(max-width: 767px) 100vw, 35vw';

          restContainer.appendChild(img);
        }

        // Remove extras
        if (existing.length > needed) {
          for (let i = needed; i < existing.length; i++) {
            existing[i].remove();
          }
        }
      }

