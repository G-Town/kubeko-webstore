  <script>
    // Function to toggle accordion sections
    function toggleSection(sectionId) {
      const content = document.getElementById(`${sectionId}-content`);
      
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
      } else {
        content.classList.add('hidden');
      }
    }
    
    // Modified function to open popups - closes any other open popups first
    function openPopup(popupId) {
      // First close all popups
      const popups = document.querySelectorAll('#shipping-popup, #size-guide-popup, #materials-popup');
      popups.forEach(popup => {
        popup.classList.add('hidden');
      });
      
      // Show the overlay
      const overlay = document.getElementById('popup-overlay');
      overlay.classList.remove('hidden');
      
      // Then open the requested popup
      const popup = document.getElementById(popupId);
      if (popup) {
        popup.classList.remove('hidden');
        
        // When popup opens, make the nav and popup backgrounds white
        const navContainer = document.querySelector('.nav-container');
        const popupContent = popup.querySelector('.popup-content');
        
        {% comment %} if (navContainer) {
          navContainer.style.backgroundColor = 'white';
        }
        
        if (popupContent) {
          popupContent.style.backgroundColor = 'white';
        } {% endcomment %}
        
        // Add the active popup class to the body for styling
        document.body.classList.add('popup-active');
        
        // On mobile devices, scroll to popup position for visibility
        if (window.innerWidth < 768) {
          // Store the current scroll position before opening popup
          window.lastScrollPosition = window.pageYOffset;
          
          // Small delay to ensure the popup is rendered before calculating position
          setTimeout(() => {
            // Get the popup's position
            const popupRect = popup.getBoundingClientRect();
            
            // Calculate the optimal scroll position - account for top navigation and 48px offset
            const headerHeight = 12; // Adjusted to account for the 48px offset
            const scrollToY = Math.max(0, window.pageYOffset + popupRect.top - headerHeight);
            
            // Use smooth scrolling
            window.scrollTo({
              top: scrollToY,
              behavior: 'smooth'
            });
          }, 50);
        }
      }
    }
    
    // Modified function to close popups
    function closePopup(popupId) {
      const popup = document.getElementById(popupId);
      if (popup) {
        popup.classList.add('hidden');
        
        // Hide the overlay
        const overlay = document.getElementById('popup-overlay');
        overlay.classList.add('hidden');
        
        // When popup closes, reset nav and popup backgrounds
        const navContainer = document.querySelector('.nav-container');
        const popupContent = popup.querySelector('.popup-content');
        
        if (navContainer) {
          navContainer.style.backgroundColor = 'rgba(254,254,254,0.60)';
        }
        
        if (popupContent) {
          popupContent.style.backgroundColor = 'rgba(254,254,254,0.60)';
        }
        
        // Remove the active popup class from the body
        document.body.classList.remove('popup-active');
        
        // On mobile, restore previous scroll position if it exists
        if (window.innerWidth < 768 && typeof window.lastScrollPosition !== 'undefined') {
          setTimeout(() => {
            window.scrollTo({
              top: window.lastScrollPosition,
              behavior: 'smooth'
            });
          }, 50);
        }
      }
    }
    
    // Function to close all popups
    function closeAllPopups() {
      const popups = document.querySelectorAll('#shipping-popup, #size-guide-popup, #materials-popup');
      popups.forEach(popup => {
        const popupId = popup.id;
        if (!popup.classList.contains('hidden')) {
          closePopup(popupId);
        }
      });
    }
    
    // Add click handler to overlay
    document.getElementById('popup-overlay').addEventListener('click', function() {
      closeAllPopups();
    });
      
      // Add click handlers for header elements on mobile
      const mobileHeaderElements = ['site-header', 'header-overlay'].map(id => 
        document.querySelector('#' + id)
      ).filter(Boolean);
      
      mobileHeaderElements.forEach(element => {
        element.addEventListener('click', function() {
          if (window.innerWidth < 768) {
            closeAllPopups();
          }
        });
      });
    
    // Function to handle variant selection
    function selectVariant(element, optionPosition, optionValue) {
      // Define selectable items for the current option group
      const selectableItems = document.querySelectorAll(`.variant-button[data-option-position="${optionPosition}"], .color-chip[data-option-position="${optionPosition}"]`);

      // Clear previous selection for this option group
      selectableItems.forEach(item => {
        item.removeAttribute('data-selected');
        if (item.classList.contains('variant-button') && !item.classList.contains('color-chip')) {
          item.classList.remove('bg-[#D9D9D9]');
        }
      });

      // Mark the clicked item as selected
      element.setAttribute('data-selected', 'true');
      if (element.classList.contains('variant-button') && !element.classList.contains('color-chip')) {
        element.classList.add('bg-[#D9D9D9]');
      }

      // Get current selections for all options from both .variant-button and .color-chip
      const selections = {};
      document.querySelectorAll('.variant-button[data-selected="true"], .color-chip[data-selected="true"]').forEach(selectedItem => {
        const position = selectedItem.getAttribute('data-option-position');
        const value = selectedItem.getAttribute('data-value');
        selections[`option${position}`] = value;
      });

      // Get total number of option types available for this product
      const totalOptionTypes = {{ product.options | size }};

      // Check if all option types have been selected
      const allOptionsSelected = Object.keys(selections).length === totalOptionTypes;

      // Find matching variant
      const variants = {{ product.variants | json }};
      let matchingVariant = null;

      if (allOptionsSelected) {
        matchingVariant = variants.find(variant => {
          return Object.keys(selections).every(option => {
            const position = parseInt(option.replace('option', ''));
            return variant[`option${position}`] === selections[`option${position}`];
          });
        });
      }

      // Check if this is an unavailable combination of options
      let isUnavailableCombination = false;
      if (allOptionsSelected && !matchingVariant) {
        isUnavailableCombination = true;
      }

      // Update add to cart buttons based on inventory
      if (matchingVariant) {
        // We have a complete matching variant
        updateAddToCartButtons(true, matchingVariant);
      } else if (isUnavailableCombination) {
        // All options selected but no matching variant found (unavailable combination)
        updateAddToCartButtons(false, null, true);
      } else {
        // Not all options selected yet
        updateAddToCartButtons(false);
      }

      // If there's a matching variant, update the variant ID
      if (matchingVariant) {
        document.getElementById('variant-id').value = matchingVariant.id;
        if (document.getElementById('variant-id-mobile')) {
          document.getElementById('variant-id-mobile').value = matchingVariant.id;
        }

        // Update the main image to the variant's featured image
        if (matchingVariant.featured_image) {
          const mainImage = document.getElementById('main-image');
          if (mainImage) {
            mainImage.src = matchingVariant.featured_image.src;
          }
        }
      }
    }
    
    // Function to update add to cart buttons based on variant selection and inventory
    function updateAddToCartButtons(allSelected, selectedVariant, isUnavailableCombination) {
      const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
      
      // Get inventory containers
      const desktopInventoryContainer = document.getElementById('desktop-inventory-status');
      const mobileInventoryContainer = document.getElementById('mobile-inventory-status');
      
      // Clear any existing inventory indicators
      if (desktopInventoryContainer) {
        desktopInventoryContainer.innerHTML = '';
        desktopInventoryContainer.style.display = 'none';
      }
      
      if (mobileInventoryContainer) {
        mobileInventoryContainer.innerHTML = '';
        mobileInventoryContainer.style.display = 'none';
      }
      
      if (allSelected && selectedVariant) {
        // Check if the variant is available
        if (selectedVariant.available) {
          // Variant is in stock
          addToCartButtons.forEach(button => {
            button.disabled = false;
            button.classList.add('variants-selected');
            button.classList.remove('out-of-stock');
            button.textContent = 'ADD TO CART';
          });
          
          // Display inventory level if tracking is enabled and quantity is low
          if (selectedVariant.inventory_quantity !== null && selectedVariant.inventory_quantity <= 10 && selectedVariant.inventory_quantity > 0) {
            const inventoryMessage = `Only ${selectedVariant.inventory_quantity} left`;
            
            // Update desktop inventory status
            if (desktopInventoryContainer) {
              desktopInventoryContainer.innerHTML = inventoryMessage;
              desktopInventoryContainer.style.display = 'block';
            }
            
            // Update mobile inventory status
            if (mobileInventoryContainer) {
              mobileInventoryContainer.innerHTML = inventoryMessage;
              mobileInventoryContainer.style.display = 'block';
            }
          }
        } else {
          // Variant is out of stock
          addToCartButtons.forEach(button => {
            button.disabled = true;
            button.classList.remove('variants-selected');
            button.classList.add('out-of-stock');
