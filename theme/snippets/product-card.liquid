{% assign first_variant = product.first_available_variant | default: product.variants.first %}
{% assign first_image = first_variant.featured_image | default: product.featured_image %}
{%- assign card_sizes = image_sizes | default: "(max-width: 767px) 50vw, (max-width: 1024px) 20vw, (max-width: 1536px) 12vw, 300px" -%}
{%- assign unique_id = product.id | append: '-' | append: section.id -%}

<div class="group relative flex flex-col text-black
            {% if custom_aspect_ratio %}h-full{% endif %} overflow-visible "
      data-product-card-id="{{ unique_id }}">
  <!-- Hidden product data for JavaScript -->
  <div class="hidden"
        data-product-json=
          '{"id":{{ product.id }},
          "title":{{ product.title | json }},
          "variants":{{ product.variants | json }},
          "images":{{ product.images | json }},
          "options":{{ product.options_with_values | json }},
          "has_only_default_variant":{{ product.has_only_default_variant | json }}}'>
  </div>

  <!-- Product link (image gallery) -->
  <a href="{{ product.url }}"
      class="block relative w-full overflow-hidden product-card-link
            {% if custom_aspect_ratio %}flex-grow{% endif %}"
      style="aspect-ratio: 4 / 5;"
      data-product-card-link
      onclick="handleProductCardClick(event)">

    <!-- Scrollable gallery container -->
    <div
      id="gallery-{{ unique_id }}"
      class="product-card-gallery"
    >
      <!-- First slide: server-rendered by Liquid -->
      <div class="product-card-slide">
        <img
          alt="{{ product.title }}"
          src="{{ first_image | image_url: width: 500 }}"
          srcset="
            {{ first_image | image_url: width: 500 }} 500w,
            {{ first_image | image_url: width: 700 }} 700w,
            {{ first_image | image_url: width: 900 }} 900w
          "
          sizes="{{ card_sizes }}"
          loading="eager"
          fetchpriority="high"
        >
      </div>
      <!-- Remaining slides appended by JS -->
    </div>

    <!-- Custom scrollbar (overlaid at bottom edge) -->
    <div class="product-card-scrollbar-track">
      <div
        id="scrollbar-thumb-{{ unique_id }}"
        class="product-card-scrollbar-thumb"
      ></div>
    </div>

    <!-- Gallery arrow buttons (desktop only) -->
    <button
      class="product-card-arrow product-card-arrow-left"
      id="arrow-left-{{ unique_id }}"
      onclick="ProductCardObject.scrollGallery(event, '{{ unique_id }}', -1)"
      aria-label="Previous image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18l-6-6l6-6"/></svg>
    </button>
    <button
      class="product-card-arrow product-card-arrow-right"
      id="arrow-right-{{ unique_id }}"
      onclick="ProductCardObject.scrollGallery(event, '{{ unique_id }}', 1)"
      aria-label="Next image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/></svg>
    </button>
  </a>

  {% comment %} TODO: remove all remaining code pertaining to add to cart button, which was removed {% endcomment %}
  <!-- Product info and dropdown container -->
  <div class="relative z-10">
    <!-- Product info bar (always visible) -->
    {% comment %} TODO: edit height (was 49px) {% endcomment %}
    <div class="product-info-bar relative rounded-[1px] bg-[rgba(254,254,254,0.60)] backdrop-blur-[12.5px] px-4 py-3">

      <!-- Row 1: Title and Price -->
      <div class="flex justify-between items-center mb-1">
        <a href="{{ product.url }}" class="uppercase text-xs text-black tracking-wide">{{ product.title }}</a>
        <div class="text-xs text-black">
          {% comment %} TODO: implement slashed price here like in PDP {% endcomment %}
          <span class="product-card-price" {% unless first_variant.available %}style="display:none"{% endunless %}>
            {{ product.price | money_without_trailing_zeros }}
            {% comment %} {% if product.inventory_quantity <= 10 and product.inventory_quantity > 0 and product.inventory_management == 'shopify' %}
              <span class="stock-status in-stock text-sm ml-2">({{ product.inventory_quantity }} left)</span>
            {% endif %} {% endcomment %}
          </span>
          <div class="stock-status-block" {% if first_variant.available %}style="display:none"{% endif %}>
            <span class="stock-status out-of-stock text-xs">SOLD OUT</span>
          </div>
        </div>
      </div>
      <!-- Row 2: Color Chips -->
      <div class="flex items-center gap-1 pt-2">
        {%- for option in product.options_with_values -%} <!--  -->
          {%- if option.name == 'Color' -%}
            {%- for value in option.values -%} <!-- COLOR OPTION NAMES eg. Mustard, Carbon/Stripe etc. --> 
            {%- assign variant_for_color = null -%}
              {%- for variant in product.variants -%} <!-- ALL PRODUCT VARIANT TITLES eg. Mustard1, Mustard2 etc. -->
                {%- if variant.options contains value -%} <!-- variant title will contain color name, usually 1st variant category -->
                  {%- assign variant_for_color = variant -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if variant_for_color  -%}
                {%- assign is_selected = false -%}

                {%- comment -%} Check if the currently selected variant has the same color as this chip {%- endcomment -%}
                {%- if product.selected_or_first_available_variant.options contains value -%}
                  {%- assign is_selected = true -%}
                {%- endif -%}

                {%- assign has_image = variant_for_color.featured_image -%}
                {%- assign color_obj = shop.metaobjects['shopify--color-pattern'][value] -%}
                {% assign pattern_image = color_obj.image %}
                {% if pattern_image %}
                  {% assign swatch_img = pattern_image | image_url: width: 30 %}
                {% endif %}

                <div class="color-chip-container{% if is_selected %} active{% endif %}">
                  <button
                    type="button"
                    class="color-chip"
                    style="
                            {% if pattern_image %}
                              background-image: url('{{ swatch_img | image_url: '30x30' }}');
                              background-size: cover;
                              background-position: center;
                            {% else %}
                              background-color: {{ value.swatch.color }};
                            {% endif %}
                          "
                    data-color-name="{{ value | escape }}"
                    data-option-position="1" 
                    data-value="{{ value }}"
                    data-action="select-variant-card"
                    aria-label="Select color {{ value | escape }}"
                  ></button>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  @media (max-width: 767px) {
    .card-visible .product-dropdown,
    .card-visible-delayed .product-dropdown {
      opacity: 0 !important;
      max-height: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
    }
    
    .card-visible,
    .card-visible-delayed {
      opacity: 1 !important;
      max-height: none !important;
    }
    
    .mobile-hidden {
      display: none !important;
    }
    
    .group.mobile-expanded .mobile-hidden {
      display: block !important;
    }
    
    .mobile-dropdown-hidden {
      max-height: 0 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
    }
    
    .mobile-dropdown-visible {
      max-height: 500px !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    
    .product-dropdown {
      max-height: 0 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      overflow: hidden !important;
      transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1), 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
    }
    
    .group.mobile-expanded .product-dropdown.mobile-dropdown-visible {
      opacity: 1 !important;
      max-height: 500px !important;
      visibility: visible !important;
      transition: opacity 0.2s cubic-bezier(0.33, 0.66, 0.66, 1), 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) !important;
    }
    
    .side-by-side-column .group {
      height: 100%;
    }
    
    .side-by-side-column .group.mobile-expanded {
      position: relative;
      z-index: 100;
    }

    .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-hidden {
      max-height: 0 !important;
    }
    
    .group.mobile-expanded .product-dropdown-gap.mobile-dropdown-visible {
      max-height: 4px !important;
    }
  }

  @media (min-width: 768px) {
    .product-dropdown {
      transition: opacity 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s, 
                  max-height 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s,
                  visibility 0.3s cubic-bezier(0.33, 0.66, 0.66, 1) 0.15s !important;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      visibility: hidden;
    }
    
    .group:hover .product-dropdown {
      transition-delay: 0.15s !important;
      visibility: visible;
      opacity: 1;
      max-height: 500px;
    }

    .group:hover .md\:group-hover\:opacity-0 {
      opacity: 0;
    }
    
    .group:hover .md\:group-hover\:opacity-100 {
      opacity: 1;
    }
    
    .group:hover .md\:group-hover\:max-h-\[500px\] {
      max-height: 500px !important;
      opacity: 1;
      visibility: visible;
      transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
  }

  /* Product dropdown styling */
  .product-dropdown {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                padding-top 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    padding-top: 0;
  }

  .group:hover .product-dropdown {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    padding-top: 4px;
  }

  .stock-status-block {
    background: #f4f4f4;
    text-align: center;
    padding: 2px 2px;
  }

  /* Stock status styling */
  .stock-status {
    font-size: 0.65rem;
    font-weight: 500;
    color: black;
  }

  /* Product dropdown gap styling */
  .product-dropdown-gap {
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    overflow: hidden;
  }

  /* Color chip styles */
  .color-chip {
    width: 16px;
    height: 10px;
    border-radius: 5%;
    border: 1px solid #d1d5db;
    cursor: pointer;
    outline: none;
    opacity: 1;
  }

  .color-chip-container {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .color-chip-container:hover,
  .color-chip-container.active {
    border-bottom-color: #000;
  }

  .color-chip-container.disabled:hover {
    border-bottom-color: transparent;
  }

  .color-chip-container.active .color-chip {
    pointer-events: none;
    cursor: default;
  }

  .color-chip[disabled],
  .color-chip[aria-disabled="true"] {
    pointer-events: none !important;
  }

  /* Product card gallery */
  .product-card-gallery {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .product-card-gallery::-webkit-scrollbar {
    display: none;
  }

  /* Individual slide */
  .product-card-slide {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    // TODO: try to fit the image in the slide more precisely
    padding: 0px 1px;
    box-sizing: border-box;
    background-color: #f4f4f4;
  }

  .product-card-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  /* Custom scrollbar */
  .product-card-scrollbar-track {
    position: absolute;
    bottom: 6px;
    /* now handled by updateScrollbar */
    /* left: 10%;
    width: 80%; */
    height: 3px;
    background: #e0e0e0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .product-card-scrollbar-thumb {
    height: 100%;
    background: #666666;
    border-radius: 0;
  }

  /* Gallery arrow buttons */
  .product-card-arrow {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.25);
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #444444;
    line-height: 0;
  }

  .product-card-arrow-left {
    left: 4px;
  }

  .product-card-arrow-right {
    right: 4px;
  }

  .product-card-arrow-left.hidden,
  .product-card-arrow-right.hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .product-card-arrow {
      display: block;
    }
  }
{% endstyle %}