    // Moved this function to global scope (outside the DOMContentLoaded listener):
    function initMobileGallery(preserveActiveIndex = false) {
      const mobileGalleryContainer = document.getElementById('mobile-gallery-container');
      const mobileSlides = document.querySelectorAll('.mobile-gallery-slide');
      const mobileThumbnails = document.querySelectorAll('.mobile-thumbnail');

      if (!mobileGalleryContainer || !mobileSlides.length) return;

      let activeIndex = 0;
      
      if (preserveActiveIndex) {
        // Calculate current active index based on scroll position
        const containerWidth = mobileGalleryContainer.offsetWidth;
        const scrollPosition = mobileGalleryContainer.scrollLeft;
        activeIndex = Math.round(scrollPosition / containerWidth);
        
        // Make sure the index is within bounds of new image set
        activeIndex = Math.min(activeIndex, mobileSlides.length - 1);
      }

      window.scrollToMobileImage = function(index) {
        const currentSlides = document.querySelectorAll('.mobile-gallery-slide');
        if (index < 0 || index >= currentSlides.length) return;
        
        const containerWidth = mobileGalleryContainer.offsetWidth;
        const scrollPosition = index * containerWidth;

        mobileGalleryContainer.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });

        updateActiveMobileThumbnail(index);
      };

      function updateActiveMobileThumbnail(activeIndex) {
        const currentThumbnails = document.querySelectorAll('.mobile-thumbnail');
        currentThumbnails.forEach((thumb, index) => {
          if (index === activeIndex) {
            thumb.classList.remove('opacity-30');
            thumb.classList.add('opacity-100');
          } else {
            thumb.classList.remove('opacity-100');
            thumb.classList.add('opacity-30');
          }
        });
      }

      window.updateActiveMobileThumbnail = updateActiveMobileThumbnail;

      updateActiveMobileThumbnail(activeIndex);

      // Remove existing scroll listeners to avoid duplicates
      if (window.mobileScrollHandler) {
        mobileGalleryContainer.removeEventListener('scroll', window.mobileScrollHandler);
      }

      // Handle scroll events to update thumbnails
      let scrollTimeout;
      window.mobileScrollHandler = function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const containerWidth = mobileGalleryContainer.offsetWidth;
          const scrollPosition = mobileGalleryContainer.scrollLeft;
          const activeIndex = Math.round(scrollPosition / containerWidth);
          updateActiveMobileThumbnail(activeIndex);
        }, 50);
      };

      mobileGalleryContainer.addEventListener('scroll', window.mobileScrollHandler, { passive: true });

      // Add click handlers to slides
      const currentSlides = document.querySelectorAll('.mobile-gallery-slide');
      currentSlides.forEach((slide) => {
        slide.addEventListener('click', function(e) {
          const index = parseInt(this.dataset.index);
          if (!isNaN(index)) {
